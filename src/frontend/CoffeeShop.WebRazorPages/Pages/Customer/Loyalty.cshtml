            <!-- Filter Buttons -->
            <div class="flex items-center gap-2">
                <button type="button" onclick="filterTransactions('ALL')" id="filter-tx-all" class="px-3.5 py-2 rounded-xl text-xs font-black bg-red-highland text-white shadow-sm transition">
                    Tất cả
                </button>
                <button type="button" onclick="filterTransactions('EARN')" id="filter-tx-earn" class="px-3.5 py-2 rounded-xl text-xs font-black bg-gray-100 text-gray-700 hover:bg-gray-200 transition">
