                <div class="flex gap-2 pt-1">
                    <button type="button" onclick="setPresetPoints(20)" class="px-3 py-1.5 rounded-lg bg-gray-100 hover:bg-gray-200 text-xs font-bold text-gray-700">20 điểm</button>
                    <button type="button" onclick="setPresetPoints(50)" class="px-3 py-1.5 rounded-lg bg-gray-100 hover:bg-gray-200 text-xs font-bold text-gray-700">50 điểm</button>
                    <button type="button" onclick="setPresetPoints(100)" class="px-3 py-1.5 rounded-lg bg-gray-100 hover:bg-gray-200 text-xs font-bold text-gray-700">100 điểm</button>
                    <button type="button" onclick="setPresetPoints(200)" class="px-3 py-1.5 rounded-lg bg-gray-100 hover:bg-gray-200 text-xs font-bold text-gray-700">200 điểm</button>
                </div>
            </div>

            <div class="md:col-span-6 bg-gradient-to-br from-emerald-50 to-teal-50/40 rounded-3xl border border-emerald-200/80 p-6 sm:p-8 flex flex-col justify-between space-y-4">
                <div class="flex items-center justify-between">
                    <span class="text-xs font-black uppercase tracking-wider text-emerald-800">Quy đổi tiêu điểm</span>
