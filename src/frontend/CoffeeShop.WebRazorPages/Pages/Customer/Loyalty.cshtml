@page "/Customer/Loyalty"
@model CoffeeShop.WebRazorPages.Pages.Customer.LoyaltyModel
@{
    Layout = "_Layout";
    ViewData["Title"] = "Thành viên & Điểm thưởng Loyalty";
}

<!-- Hero Banner Header -->
<section class="relative bg-gradient-to-r from-red-highland-dark via-red-highland to-red-800 text-white overflow-hidden py-14 sm:py-18 px-4 sm:px-8 lg:px-12 shadow-inner">
    <div class="absolute -top-24 -right-24 w-96 h-96 rounded-full bg-white/5 blur-3xl pointer-events-none"></div>
    <div class="absolute -bottom-24 -left-24 w-96 h-96 rounded-full bg-amber-400/10 blur-3xl pointer-events-none"></div>

    <div class="max-w-7xl mx-auto flex flex-col md:flex-row items-center justify-between gap-8 relative z-10">
        <div class="space-y-4 max-w-2xl text-center md:text-left">
            <div class="inline-flex items-center gap-2 px-3.5 py-1.5 rounded-full bg-amber-300/20 border border-amber-300/40 text-amber-200 text-xs sm:text-sm font-extrabold uppercase tracking-wider backdrop-blur-sm">
                <i class="fi fi-sr-star text-amber-300 text-sm"></i>
                <span>LowLand Coffee Rewards Program</span>
            </div>
            <h1 class="text-3xl sm:text-4xl lg:text-5xl font-black tracking-tight leading-tight">
                Tích Điểm Từng Ngụm,<br />
                <span class="text-amber-200">Đặc Quyền Vượt Bậc</span>
            </h1>
            <p class="text-white/90 text-sm sm:text-base leading-relaxed font-normal">
                Mỗi tách cà phê bạn thưởng thức tại LowLand Coffee đều là một bước tiến đến những ưu đãi độc quyền. Tích lũy điểm để nâng hạng thẻ và tận hưởng chiết khấu đến 15% cùng cơ hội đổi điểm trừ tiền trực tiếp trên mỗi hóa đơn.
            </p>
            <div class="flex flex-wrap items-center justify-center md:justify-start gap-4 pt-2">
                <a href="#tiers-section" class="px-6 py-3 rounded-2xl bg-white text-red-highland hover:bg-amber-100 font-extrabold text-sm shadow-lg transition transform active:scale-95 flex items-center gap-2">
                    <i class="fi fi-rr-medal text-base"></i>
                    <span>Xem 4 Hạng Thẻ</span>
                </a>
                <a href="#calculator-section" class="px-6 py-3 rounded-2xl bg-red-800/80 hover:bg-red-800 text-white border border-red-500 font-extrabold text-sm shadow-md transition flex items-center gap-2">
                    <i class="fi fi-rr-calculator text-base"></i>
                    <span>Ước Tính Điểm Thưởng</span>
                </a>
            </div>
        </div>

        <!-- Membership Card Preview Widget (Dynamic) -->
        <div class="w-full max-w-sm">
            <div id="hero-card-container" class="relative group">
                <!-- Shiny glow -->
                <div class="absolute -inset-1 rounded-3xl bg-gradient-to-r from-amber-300 to-amber-500 opacity-30 group-hover:opacity-60 blur-lg transition duration-500"></div>

                <!-- Digital Member Card -->
                <div id="digital-card" class="relative bg-gradient-to-br from-[#2D2A26] via-[#1E1B18] to-[#12100E] text-white p-6 sm:p-7 rounded-3xl border border-amber-500/30 shadow-2xl flex flex-col justify-between h-64 overflow-hidden">
                    <div class="absolute top-0 right-0 w-44 h-44 bg-amber-400/10 rounded-full blur-2xl pointer-events-none"></div>

                    <div class="flex items-center justify-between z-10">
                        <div class="flex items-center gap-3">
                            <img src="~/images/logo.jpg" alt="Logo" class="w-10 h-10 rounded-full border-2 border-amber-300 bg-amber-50 shadow-sm" />
                            <div>
                                <span class="block text-xs uppercase font-extrabold tracking-widest text-amber-200">LOWLAND REWARDS</span>
                                <span class="block text-[11px] text-gray-400 font-medium">Thẻ Hội Viên Điện Tử</span>
                            </div>
                        </div>
                        <span id="card-tier-badge" class="px-3 py-1 rounded-full text-xs font-black uppercase tracking-wider bg-amber-600/30 text-amber-200 border border-amber-500/40">
                            ĐỒNG
                        </span>
                    </div>

                    <div class="my-auto z-10">
                        <div class="flex items-baseline gap-2">
                            <span id="card-points" class="text-4xl font-black text-amber-300 tracking-tight">0</span>
                            <span class="text-xs font-bold text-gray-300 uppercase tracking-wider">Điểm khả dụng</span>
                        </div>
                        <p id="card-upgrade-hint" class="text-[12px] text-gray-400 font-medium mt-1">
                            Còn 500 điểm để lên hạng Bạc (Giảm 5%)
                        </p>
                    </div>

                    <div class="flex items-end justify-between pt-3 border-t border-white/10 z-10 text-xs">
                        <div>
                            <span class="block text-[10px] uppercase font-bold text-gray-400">Chủ thẻ</span>
                            <span id="card-user-name" class="font-extrabold text-white text-sm">Khách hàng thành viên</span>
                        </div>
                        <div class="text-right">
                            <span class="block text-[10px] uppercase font-bold text-gray-400">Ưu đãi giảm giá</span>
                            <span id="card-discount-rate" class="font-black text-amber-300 text-sm">0%</span>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
</section>

<!-- Main Container -->
<div class="max-w-7xl mx-auto px-4 sm:px-8 lg:px-12 py-10 space-y-12">

    <!-- Guest / Login Prompt Banner (Chỉ hiện khi chưa đăng nhập) -->
    <div id="loyalty-guest-notice" class="bg-gradient-to-r from-amber-50 via-amber-100/50 to-orange-50 border border-amber-200 rounded-3xl p-6 sm:p-8 flex flex-col md:flex-row items-center justify-between gap-6 shadow-sm">
        <div class="flex items-center gap-4">
            <div class="w-14 h-14 rounded-2xl bg-amber-400/20 text-amber-800 flex items-center justify-center text-3xl shrink-0">
                <i class="fi fi-rr-sparkles"></i>
            </div>
            <div>
                <h3 class="text-lg sm:text-xl font-black text-gray-900">Bạn chưa đăng nhập tài khoản?</h3>
                <p class="text-sm text-gray-600 mt-1">
                    Đăng nhập hoặc đăng ký thành viên ngay hôm nay để tự động nhận thẻ hội viên Hạng Đồng, tích điểm đổi thưởng và nhận voucher độc quyền mỗi tuần!
                </p>
            </div>
        </div>
        <div class="flex items-center gap-3 shrink-0 w-full md:w-auto">
            <a href="/Auth/Login?returnUrl=/Customer/Loyalty" class="flex-1 md:flex-none text-center px-6 py-3 rounded-2xl bg-red-highland hover:bg-red-700 text-white font-extrabold text-sm shadow-md transition active:scale-95">
                Đăng Nhập
            </a>
            <a href="/Auth/Register" class="flex-1 md:flex-none text-center px-6 py-3 rounded-2xl bg-white hover:bg-gray-50 border border-gray-300 text-gray-800 font-extrabold text-sm shadow-sm transition">
                Tạo Tài Khoản
            </a>
        </div>
    </div>

    <!-- Logged In Member Dashboard (Hiện khi đã đăng nhập) -->
    <div id="loyalty-member-dashboard" class="hidden space-y-6">
        <div class="flex flex-col sm:flex-row sm:items-center justify-between gap-4 pb-2 border-b border-gray-200">
            <div>
                <h2 class="text-2xl sm:text-3xl font-black text-gray-900 tracking-tight flex items-center gap-2.5">
                    <span class="p-2 rounded-xl bg-red-100 text-red-highland">
                        <i class="fi fi-sr-user text-xl"></i>
                    </span>
                    <span>Hồ Sơ Hội Viên Của Bạn</span>
                </h2>
                <p class="text-sm text-gray-500 mt-1">Thông tin chi tiết về điểm thưởng, hạng thành viên và tiến trình nâng hạng hiện tại</p>
            </div>
            <div class="flex items-center gap-3">
                <a href="/Order" class="px-5 py-2.5 rounded-xl bg-red-highland hover:bg-red-700 text-white font-bold text-sm shadow-md transition flex items-center gap-2">
                    <i class="fi fi-rr-coffee text-base"></i>
                    <span>Đặt Hàng Tích Điểm Ngay</span>
                </a>
            </div>
        </div>

        <!-- 3 Stat Cards -->
        <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-4 sm:gap-6">
            <!-- Điểm khả dụng -->
            <div class="bg-white p-6 rounded-3xl border border-gray-200 shadow-sm relative overflow-hidden group hover:shadow-md transition">
                <div class="flex items-center justify-between mb-3">
                    <span class="text-xs font-black uppercase tracking-wider text-gray-500">Điểm Khả Dụng</span>
                    <span class="w-10 h-10 rounded-2xl bg-amber-100 text-amber-700 flex items-center justify-center text-lg">
                        <i class="fi fi-sr-coins"></i>
                    </span>
                </div>
                <div class="text-3xl font-black text-gray-900" id="dash-current-points">0</div>
                <p class="text-xs text-gray-500 mt-1">Tương đương <span id="dash-vnd-equivalent" class="font-bold text-emerald-600">0 VNĐ</span> giảm giá</p>
            </div>

            <!-- Tổng tích lũy trọn đời -->
            <div class="bg-white p-6 rounded-3xl border border-gray-200 shadow-sm relative overflow-hidden group hover:shadow-md transition">
                <div class="flex items-center justify-between mb-3">
                    <span class="text-xs font-black uppercase tracking-wider text-gray-500">Điểm Tích Lũy Trọn Đời</span>
                    <span class="w-10 h-10 rounded-2xl bg-red-100 text-red-highland flex items-center justify-center text-lg">
                        <i class="fi fi-sr-trophy"></i>
                    </span>
                </div>
                <div class="text-3xl font-black text-gray-900" id="dash-total-points">0</div>
                <p class="text-xs text-gray-500 mt-1">Dùng để xét duyệt và giữ hạng thẻ</p>
            </div>

            <!-- Hạng hiện tại & Ưu đãi -->
            <div class="bg-white p-6 rounded-3xl border border-gray-200 shadow-sm relative overflow-hidden group hover:shadow-md transition">
                <div class="flex items-center justify-between mb-3">
                    <span class="text-xs font-black uppercase tracking-wider text-gray-500">Hạng Thẻ Hiện Tại</span>
                    <span id="dash-tier-icon" class="w-10 h-10 rounded-2xl bg-amber-500 text-white flex items-center justify-center text-lg">
                        <i class="fi fi-sr-medal"></i>
                    </span>
                </div>
                <div class="text-2xl font-black text-gray-900" id="dash-tier-name">Hạng Đồng</div>
                <div class="flex items-center gap-2 mt-1">
                    <span class="text-xs font-bold text-red-highland bg-red-50 px-2 py-0.5 rounded-md" id="dash-discount-rate">Giảm 0%</span>
                    <span class="text-xs font-bold text-amber-700 bg-amber-50 px-2 py-0.5 rounded-md" id="dash-multiplier">x1.0 Điểm</span>
                </div>
            </div>

            <!-- Hạng kế tiếp -->
            <div class="bg-white p-6 rounded-3xl border border-gray-200 shadow-sm relative overflow-hidden group hover:shadow-md transition">
                <div class="flex items-center justify-between mb-3">
                    <span class="text-xs font-black uppercase tracking-wider text-gray-500">Hạng Kế Tiếp</span>
                    <span class="w-10 h-10 rounded-2xl bg-purple-100 text-purple-700 flex items-center justify-center text-lg">
                        <i class="fi fi-sr-angle-double-small-up"></i>
                    </span>
                </div>
                <div class="text-2xl font-black text-gray-900" id="dash-next-tier">Hạng Bạc</div>
                <p class="text-xs text-gray-500 mt-1" id="dash-points-needed">Còn thiếu 500 điểm</p>
            </div>
        </div>

        <!-- Progress Bar nâng hạng -->
        <div class="bg-white p-6 sm:p-7 rounded-3xl border border-gray-200 shadow-sm space-y-3">
            <div class="flex items-center justify-between text-sm">
                <span class="font-bold text-gray-700 flex items-center gap-2">
                    <i class="fi fi-rr-chart-line-up text-red-highland"></i>
                    <span>Tiến trình nâng hạng tiếp theo:</span>
                    <strong class="text-red-highland" id="progress-next-tier-name">Hạng Bạc</strong>
                </span>
                <span class="font-extrabold text-gray-900" id="progress-percent-label">0%</span>
            </div>
            <div class="w-full bg-gray-100 rounded-full h-4 overflow-hidden p-0.5 border border-gray-200">
                <div id="progress-bar-fill" class="bg-gradient-to-r from-red-highland to-amber-400 h-full rounded-full transition-all duration-700" style="width: 5%;"></div>
            </div>
            <div class="flex justify-between text-xs text-gray-500 font-semibold">
                <span id="progress-min-points">0 điểm</span>
                <span id="progress-target-hint">Tích thêm 500 điểm để mở khóa chiết khấu 5%</span>
                <span id="progress-max-points">500 điểm</span>
            </div>
        </div>
    </div>

    <!-- Section: 4 Hạng Thẻ Thành Viên (Tiers Section) -->
    <section id="tiers-section" class="space-y-6 pt-4">
        <div class="text-center max-w-2xl mx-auto space-y-2">
            <span class="text-xs font-black uppercase tracking-widest text-red-highland bg-red-50 px-3.5 py-1 rounded-full border border-red-200">Bảng Quyền Lợi Thành Viên</span>
            <h2 class="text-2xl sm:text-3xl font-black text-gray-900 tracking-tight">4 Cấp Bậc Hạng Thẻ Tại LowLand Coffee</h2>
            <p class="text-sm text-gray-500">Mỗi hạng thẻ mang đến những ưu đãi giảm giá độc quyền và hệ số nhân điểm tăng dần theo thời gian gắn bó của bạn.</p>
        </div>

        <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-6">
            <!-- Hạng Đồng -->
            <div class="bg-white rounded-3xl border border-gray-200 p-6 shadow-sm hover:shadow-xl transition-all duration-300 flex flex-col justify-between relative group">
                <div class="space-y-4">
                    <div class="flex items-center justify-between">
                        <span class="w-12 h-12 rounded-2xl bg-amber-700/10 text-amber-800 flex items-center justify-center text-2xl group-hover:scale-110 transition-transform">
                            <i class="fi fi-sr-medal"></i>
                        </span>
                        <span class="text-xs font-black uppercase tracking-wider px-3 py-1 rounded-full bg-amber-100 text-amber-900 border border-amber-200">Hạng 1</span>
                    </div>
                    <div>
                        <h3 class="text-xl font-black text-gray-900">Hạng Đồng</h3>
                        <p class="text-xs font-semibold text-gray-500 mt-0.5">Khởi đầu trải nghiệm</p>
                    </div>
                    <div class="py-2 border-y border-gray-100 space-y-1">
                        <div class="flex justify-between text-xs">
                            <span class="text-gray-500 font-medium">Điểm tối thiểu:</span>
                            <span class="font-black text-gray-900">0 điểm</span>
                        </div>
                        <div class="flex justify-between text-xs">
                            <span class="text-gray-500 font-medium">Tích điểm:</span>
                            <span class="font-black text-amber-700">x1.0 lần</span>
                        </div>
                        <div class="flex justify-between text-xs">
                            <span class="text-gray-500 font-medium">Giảm giá đơn hàng:</span>
                            <span class="font-black text-gray-400">0%</span>
                        </div>
                    </div>
                    <ul class="text-xs text-gray-600 space-y-2 font-medium">
                        <li class="flex items-center gap-2">
                            <i class="fi fi-rr-check text-emerald-500"></i>
                            <span>Tự động cấp khi đăng ký tài khoản</span>
                        </li>
                        <li class="flex items-center gap-2">
                            <i class="fi fi-rr-check text-emerald-500"></i>
                            <span>Tích 1 điểm cho mỗi 10.000 VNĐ</span>
                        </li>
                        <li class="flex items-center gap-2">
                            <i class="fi fi-rr-check text-emerald-500"></i>
                            <span>Đổi điểm trừ tiền (1 điểm = 1.000đ)</span>
                        </li>
                    </ul>
                </div>
            </div>

            <!-- Hạng Bạc -->
            <div class="bg-white rounded-3xl border border-gray-200 p-6 shadow-sm hover:shadow-xl transition-all duration-300 flex flex-col justify-between relative group">
                <div class="space-y-4">
                    <div class="flex items-center justify-between">
                        <span class="w-12 h-12 rounded-2xl bg-slate-200 text-slate-700 flex items-center justify-center text-2xl group-hover:scale-110 transition-transform">
                            <i class="fi fi-sr-medal"></i>
                        </span>
                        <span class="text-xs font-black uppercase tracking-wider px-3 py-1 rounded-full bg-slate-100 text-slate-800 border border-slate-200">Hạng 2</span>
                    </div>
                    <div>
                        <h3 class="text-xl font-black text-gray-900">Hạng Bạc</h3>
                        <p class="text-xs font-semibold text-gray-500 mt-0.5">Khách hàng thân quen</p>
                    </div>
                    <div class="py-2 border-y border-gray-100 space-y-1">
                        <div class="flex justify-between text-xs">
                            <span class="text-gray-500 font-medium">Điểm tối thiểu:</span>
                            <span class="font-black text-gray-900">500 điểm</span>
                        </div>
                        <div class="flex justify-between text-xs">
                            <span class="text-gray-500 font-medium">Tích điểm:</span>
                            <span class="font-black text-amber-700">x1.2 lần (+20%)</span>
                        </div>
                        <div class="flex justify-between text-xs">
                            <span class="text-gray-500 font-medium">Giảm giá đơn hàng:</span>
                            <span class="font-black text-red-highland">Giảm 5%</span>
                        </div>
                    </div>
                    <ul class="text-xs text-gray-600 space-y-2 font-medium">
                        <li class="flex items-center gap-2">
                            <i class="fi fi-rr-check text-emerald-500"></i>
                            <span>Chiết khấu 5% tự động mỗi đơn hàng</span>
                        </li>
                        <li class="flex items-center gap-2">
                            <i class="fi fi-rr-check text-emerald-500"></i>
                            <span>Tích điểm nhanh hơn 20%</span>
                        </li>
                        <li class="flex items-center gap-2">
                            <i class="fi fi-rr-check text-emerald-500"></i>
                            <span>Quà tặng bất ngờ dịp sinh nhật</span>
                        </li>
                    </ul>
                </div>
            </div>

            <!-- Hạng Vàng (Nổi bật) -->
            <div class="bg-gradient-to-b from-amber-50/60 to-white rounded-3xl border-2 border-amber-400 p-6 shadow-md hover:shadow-2xl transition-all duration-300 flex flex-col justify-between relative group scale-102">
                <span class="absolute -top-3 left-1/2 -translate-x-1/2 px-3 py-0.5 rounded-full bg-gradient-to-r from-amber-500 to-amber-600 text-white text-[10px] font-black uppercase tracking-wider shadow-sm">
                    Phổ Biến Nhất
                </span>
                <div class="space-y-4">
                    <div class="flex items-center justify-between">
                        <span class="w-12 h-12 rounded-2xl bg-amber-500 text-white flex items-center justify-center text-2xl group-hover:scale-110 transition-transform shadow-md">
                            <i class="fi fi-sr-trophy-star"></i>
                        </span>
                        <span class="text-xs font-black uppercase tracking-wider px-3 py-1 rounded-full bg-amber-100 text-amber-900 border border-amber-300">Hạng 3</span>
                    </div>
                    <div>
                        <h3 class="text-xl font-black text-gray-900">Hạng Vàng</h3>
                        <p class="text-xs font-semibold text-amber-700 mt-0.5">Khách hàng trung thành</p>
                    </div>
                    <div class="py-2 border-y border-amber-100 space-y-1">
                        <div class="flex justify-between text-xs">
                            <span class="text-gray-500 font-medium">Điểm tối thiểu:</span>
                            <span class="font-black text-gray-900">1.500 điểm</span>
                        </div>
                        <div class="flex justify-between text-xs">
                            <span class="text-gray-500 font-medium">Tích điểm:</span>
                            <span class="font-black text-amber-700">x1.5 lần (+50%)</span>
                        </div>
                        <div class="flex justify-between text-xs">
                            <span class="text-gray-500 font-medium">Giảm giá đơn hàng:</span>
                            <span class="font-black text-red-highland">Giảm 10%</span>
                        </div>
                    </div>
                    <ul class="text-xs text-gray-700 space-y-2 font-medium">
                        <li class="flex items-center gap-2">
                            <i class="fi fi-rr-check text-emerald-500 font-bold"></i>
                            <span>Chiết khấu 10% trực tiếp mọi món</span>
                        </li>
                        <li class="flex items-center gap-2">
                            <i class="fi fi-rr-check text-emerald-500 font-bold"></i>
                            <span>Hệ số tích điểm nhân 1.5 lần</span>
                        </li>
                        <li class="flex items-center gap-2">
                            <i class="fi fi-rr-check text-emerald-500 font-bold"></i>
                            <span>Nhận trọn bộ voucher độc quyền mỗi tháng</span>
                        </li>
                    </ul>
                </div>
            </div>

            <!-- Hạng Kim Cương (VIP) -->
            <div class="bg-gradient-to-b from-sky-50/60 to-white rounded-3xl border border-sky-300 p-6 shadow-sm hover:shadow-2xl transition-all duration-300 flex flex-col justify-between relative group">
                <div class="space-y-4">
                    <div class="flex items-center justify-between">
                        <span class="w-12 h-12 rounded-2xl bg-gradient-to-br from-sky-400 to-blue-600 text-white flex items-center justify-center text-2xl group-hover:scale-110 transition-transform shadow-md">
                            <i class="fi fi-sr-diamond"></i>
                        </span>
                        <span class="text-xs font-black uppercase tracking-wider px-3 py-1 rounded-full bg-sky-100 text-sky-900 border border-sky-200">Đặc Quyền VIP</span>
                    </div>
                    <div>
                        <h3 class="text-xl font-black text-gray-900">Hạng Kim Cương</h3>
                        <p class="text-xs font-semibold text-sky-700 mt-0.5">Khách hàng thượng lưu</p>
                    </div>
                    <div class="py-2 border-y border-gray-100 space-y-1">
                        <div class="flex justify-between text-xs">
                            <span class="text-gray-500 font-medium">Điểm tối thiểu:</span>
                            <span class="font-black text-gray-900">3.500 điểm</span>
                        </div>
                        <div class="flex justify-between text-xs">
                            <span class="text-gray-500 font-medium">Tích điểm:</span>
                            <span class="font-black text-sky-700">x2.0 lần (Gấp đôi)</span>
                        </div>
