    <!-- Section: Bộ Công Cụ Ước Tính Điểm & Đổi Tiền Thưởng (Calculator) -->
    <section id="calculator-section" class="bg-white rounded-3xl border border-gray-200 shadow-xl p-7 sm:p-11 space-y-8">
        <div class="flex flex-col md:flex-row md:items-center justify-between gap-4 pb-6 border-b border-gray-100">
            <div>
                <span class="text-xs font-black uppercase tracking-wider text-red-highland bg-red-50 px-3.5 py-1.5 rounded-full border border-red-200">Công Cụ Thông Minh</span>
