    <!-- Section: Bộ Công Cụ Ước Tính Điểm & Đổi Tiền Thưởng (Calculator) -->
    <section id="calculator-section" class="bg-white rounded-3xl border border-gray-200 shadow-xl p-6 sm:p-10 space-y-8">
