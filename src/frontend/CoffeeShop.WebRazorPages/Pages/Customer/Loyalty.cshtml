                        <input type="number" id="calc-redeem-points" value="50" step="5" min="1" oninput="calculateRedeemValue()" class="w-full bg-gray-50 border border-gray-300 rounded-2xl px-4 py-3.5 pl-12 text-lg font-black text-gray-900 focus:ring-2 focus:ring-red-highland" />
                        <span class="absolute left-4 top-4 text-gray-400 font-bold text-lg"><i class="fi fi-rr-coins text-base"></i></span>
