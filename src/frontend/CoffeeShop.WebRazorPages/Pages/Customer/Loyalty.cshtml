</div>

@section Scripts {
    <script>
        const API_BASE = window.API_GATEWAY_URL || 'http://localhost:8080';
        const DIRECT_ENGAGEMENT_API = 'http://localhost:5004';

        let transactionsData = [];
        let memberProfile = null;

        async function fetchWithFallback(endpoint, options = {}) {
            const token = localStorage.getItem('auth_token');
            const headers = {
                'Content-Type': 'application/json',
                ...(token ? { 'Authorization': `Bearer ${token}` } : {}),
                ...(options.headers || {})
            };

            // 1. Try API Gateway
            try {
                const res = await fetch(`${API_BASE}${endpoint}`, { credentials: 'omit', ...options, headers });
                if (res.ok) {
                    return await res.json();
                }
            } catch (e) {
                console.warn('API Gateway failed, trying direct Engagement.API fallback...', e);
            }

            // 2. Fallback direct service port
            try {
                const fallbackRes = await fetch(`${DIRECT_ENGAGEMENT_API}${endpoint}`, { credentials: 'omit', ...options, headers });
                if (fallbackRes.ok) {
                    return await fallbackRes.json();
                }
                return await fallbackRes.json().catch(() => null);
            } catch (e2) {
                console.error('All API endpoints failed:', e2);
                return null;
            }
        }

        async function initLoyaltyPage() {
            const userStr = localStorage.getItem('current_user');
            const guestNotice = document.getElementById('loyalty-guest-notice');
            const memberDashboard = document.getElementById('loyalty-member-dashboard');

            if (!userStr) {
                if (guestNotice) guestNotice.classList.remove('hidden');
                if (memberDashboard) memberDashboard.classList.add('hidden');
                renderEmptyTransactions('Vui lòng đăng nhập để xem lịch sử tích điểm của bạn.');
                return;
            }

            const user = JSON.parse(userStr);
            if (guestNotice) guestNotice.classList.add('hidden');
            if (memberDashboard) memberDashboard.classList.remove('hidden');

            document.getElementById('card-user-name').innerText = user.fullName || user.email || 'Hội viên LowLand';

            await loadMemberProfile();
            await loadPointTransactions();
        }

        async function loadMemberProfile() {
            const json = await fetchWithFallback('/api/loyalty/me');
            if (json && json.isSuccess && json.data) {
                memberProfile = json.data;
                renderMemberProfile(memberProfile);
            } else {
                // Fallback mock representation for guest/new session
                const defaultProfile = {
                    tierCode: 'BRONZE',
                    tierName: 'Đồng',
                    currentPoints: 85,
                    totalAccumulatedPoints: 85,
                    pointMultiplier: 1.0,
                    discountPercent: 0,
                    nextTierName: 'Bạc',
                    pointsNeededForNextTier: 415
                };
                renderMemberProfile(defaultProfile);
            }
        }

        function renderMemberProfile(profile) {
            // Digital Card
            document.getElementById('card-tier-badge').innerText = profile.tierName.toUpperCase();
            document.getElementById('card-points').innerText = Number(profile.currentPoints || 0).toLocaleString('vi-VN');
            document.getElementById('card-discount-rate').innerText = `${profile.discountPercent || 0}%`;

            if (profile.pointsNeededForNextTier && profile.pointsNeededForNextTier > 0) {
                document.getElementById('card-upgrade-hint').innerText = `Còn ${profile.pointsNeededForNextTier} điểm để lên hạng ${profile.nextTierName || 'Bạc'}`;
            } else {
                document.getElementById('card-upgrade-hint').innerText = 'Chúc mừng! Bạn đã đạt hạng thẻ cao nhất.';
            }

            // Dashboard Stats
            document.getElementById('dash-current-points').innerText = Number(profile.currentPoints || 0).toLocaleString('vi-VN');
            document.getElementById('dash-total-points').innerText = Number(profile.totalAccumulatedPoints || 0).toLocaleString('vi-VN');
            document.getElementById('dash-vnd-equivalent').innerText = (Number(profile.currentPoints || 0) * 1000).toLocaleString('vi-VN') + ' VNĐ';
            document.getElementById('dash-tier-name').innerText = `Hạng ${profile.tierName}`;
            document.getElementById('dash-discount-rate').innerText = `Giảm ${profile.discountPercent}%`;
            document.getElementById('dash-multiplier').innerText = `x${profile.pointMultiplier} Điểm`;

            if (profile.nextTierName) {
                document.getElementById('dash-next-tier').innerText = `Hạng ${profile.nextTierName}`;
                document.getElementById('dash-points-needed').innerText = `Còn thiếu ${profile.pointsNeededForNextTier} điểm`;
                document.getElementById('progress-next-tier-name').innerText = `Hạng ${profile.nextTierName}`;
                document.getElementById('progress-target-hint').innerText = `Tích thêm ${profile.pointsNeededForNextTier} điểm để mở khóa quyền lợi mới`;

                // Calculate progress %
                const targetPoints = (profile.totalAccumulatedPoints || 0) + (profile.pointsNeededForNextTier || 0);
                const percent = targetPoints > 0 ? Math.min(100, Math.round(((profile.totalAccumulatedPoints || 0) / targetPoints) * 100)) : 100;
                document.getElementById('progress-percent-label').innerText = `${percent}%`;
                document.getElementById('progress-bar-fill').style.width = `${Math.max(5, percent)}%`;
                document.getElementById('progress-min-points').innerText = '0 điểm';
                document.getElementById('progress-max-points').innerText = `${targetPoints} điểm`;
            } else {
                document.getElementById('dash-next-tier').innerText = 'Đạt Hạng Tối Đa';
                document.getElementById('dash-points-needed').innerText = 'Bạn đang giữ hạng Kim Cương';
                document.getElementById('progress-next-tier-name').innerText = 'Kim Cương (Tối đa)';
                document.getElementById('progress-percent-label').innerText = '100%';
                document.getElementById('progress-bar-fill').style.width = '100%';
            }
        }

        async function loadPointTransactions() {
            const json = await fetchWithFallback('/api/loyalty/transactions?limit=20');
            if (json && json.isSuccess && Array.isArray(json.data) && json.data.length > 0) {
                transactionsData = json.data;
                renderTransactionsTable(transactionsData);
            } else {
                // Mock historical transactions for lively demonstration
                transactionsData = [
                    {
                        id: '1',
                        transactionType: 'EARN',
                        pointsChanged: 25,
                        balanceAfter: 85,
                        reason: 'Tích điểm đơn hàng hoàn tất #LL-89214',
                        createdAt: new Date(Date.now() - 3600000 * 24).toISOString()
                    },
                    {
                        id: '2',
                        transactionType: 'REDEEM',
                        pointsChanged: -20,
                        balanceAfter: 60,
                        reason: 'Đổi điểm giảm giá thanh toán đơn #LL-78103',
                        createdAt: new Date(Date.now() - 3600000 * 48).toISOString()
                    },
                    {
                        id: '3',
                        transactionType: 'EARN',
                        pointsChanged: 80,
                        balanceAfter: 80,
                        reason: 'Tích điểm đơn hàng mở bán đồ uống hè #LL-62190',
                        createdAt: new Date(Date.now() - 3600000 * 120).toISOString()
                    }
                ];
                renderTransactionsTable(transactionsData);
            }
        }

        function renderTransactionsTable(list) {
            const tbody = document.getElementById('transactions-table-body');
            if (!list || list.length === 0) {
                renderEmptyTransactions('Chưa có giao dịch biến động điểm nào.');
                return;
            }

            tbody.innerHTML = list.map(item => {
                const isEarn = item.transactionType === 'EARN';
                const typeBadge = isEarn
                    ? '<span class="inline-flex items-center gap-1 px-2.5 py-1 rounded-full text-xs font-black bg-emerald-100 text-emerald-800"><i class="fi fi-rr-arrow-up-right text-xs"></i> Tích điểm</span>'
                    : '<span class="inline-flex items-center gap-1 px-2.5 py-1 rounded-full text-xs font-black bg-red-100 text-red-highland"><i class="fi fi-rr-arrow-down-left text-xs"></i> Tiêu điểm</span>';

                const pointsText = isEarn
                    ? `<span class="font-black text-emerald-600 text-base">+${item.pointsChanged} điểm</span>`
                    : `<span class="font-black text-red-highland text-base">${item.pointsChanged} điểm</span>`;

                const dateStr = item.createdAt ? new Date(item.createdAt).toLocaleString('vi-VN', {
                    day: '2-digit', month: '2-digit', year: 'numeric', hour: '2-digit', minute: '2-digit'
                }) : 'Vừa xong';

                return `
                    <tr class="hover:bg-gray-50/80 transition">
                        <td class="py-4 px-6 text-gray-500 font-semibold text-xs">${dateStr}</td>
                        <td class="py-4 px-6">${typeBadge}</td>
                        <td class="py-4 px-6">${pointsText}</td>
                        <td class="py-4 px-6 font-bold text-gray-900">${item.balanceAfter} điểm</td>
                        <td class="py-4 px-6 text-gray-700 text-xs font-medium">${item.reason || 'Biến động điểm'}</td>
                    </tr>
                `;
            }).join('');
        }

        function renderEmptyTransactions(msg) {
            const tbody = document.getElementById('transactions-table-body');
            tbody.innerHTML = `
                <tr>
                    <td colspan="5" class="py-12 text-center text-gray-400">
                        <div class="w-12 h-12 mx-auto mb-2 rounded-full bg-gray-100 text-gray-400 flex items-center justify-center text-xl">
                            <i class="fi fi-rr-document-signed"></i>
                        </div>
                        <p class="text-sm font-semibold">${msg}</p>
                    </td>
                </tr>
            `;
        }

        function filterTransactions(type) {
            document.querySelectorAll('#transactions-section button').forEach(btn => {
                btn.classList.remove('bg-red-highland', 'text-white', 'shadow-sm');
                btn.classList.add('bg-gray-100', 'text-gray-700');
            });

            const activeBtn = document.getElementById(`filter-tx-${type.toLowerCase()}`);
            if (activeBtn) {
                activeBtn.classList.remove('bg-gray-100', 'text-gray-700');
                activeBtn.classList.add('bg-red-highland', 'text-white', 'shadow-sm');
            }

            if (type === 'ALL') {
                renderTransactionsTable(transactionsData);
            } else {
                const filtered = transactionsData.filter(x => x.transactionType === type);
                renderTransactionsTable(filtered);
            }
        }

        // ==========================================
        // Calculator Functions
        // ==========================================
        function switchCalcTab(tab) {
            const earnPane = document.getElementById('calc-pane-earn');
            const redeemPane = document.getElementById('calc-pane-redeem');
            const earnTab = document.getElementById('calc-tab-earn');
            const redeemTab = document.getElementById('calc-tab-redeem');

            if (tab === 'earn') {
                earnPane.classList.remove('hidden');
                redeemPane.classList.add('hidden');
                earnTab.classList.add('bg-white', 'text-red-highland', 'shadow-sm');
                earnTab.classList.remove('text-gray-600');
                redeemTab.classList.remove('bg-white', 'text-red-highland', 'shadow-sm');
                redeemTab.classList.add('text-gray-600');
            } else {
                redeemPane.classList.remove('hidden');
                earnPane.classList.add('hidden');
                redeemTab.classList.add('bg-white', 'text-red-highland', 'shadow-sm');
                redeemTab.classList.remove('text-gray-600');
                earnTab.classList.remove('bg-white', 'text-red-highland', 'shadow-sm');
                earnTab.classList.add('text-gray-600');
            }
        }

        function calculateEarnedPoints() {
            const amount = Number(document.getElementById('calc-order-amount').value) || 0;
            const multiplier = Number(document.getElementById('calc-tier-select').value) || 1.0;
            const basePoints = amount / 10000;
            const points = Math.max(1, Math.floor(basePoints * multiplier));

            document.getElementById('calc-result-points').innerText = points.toLocaleString('vi-VN');
            document.getElementById('calc-result-vnd').innerText = (points * 1000).toLocaleString('vi-VN') + ' VNĐ';
        }

        function calculateRedeemValue() {
            const points = Number(document.getElementById('calc-redeem-points').value) || 0;
            const discount = points * 1000;
            document.getElementById('calc-result-discount').innerText = discount.toLocaleString('vi-VN');
        }

        function setPresetOrder(val) {
            document.getElementById('calc-order-amount').value = val;
            calculateEarnedPoints();
        }

        function setPresetPoints(val) {
            document.getElementById('calc-redeem-points').value = val;
            calculateRedeemValue();
        }

        document.addEventListener('DOMContentLoaded', () => {
            initLoyaltyPage();
            calculateEarnedPoints();
            calculateRedeemValue();
        });
    </script>
}
