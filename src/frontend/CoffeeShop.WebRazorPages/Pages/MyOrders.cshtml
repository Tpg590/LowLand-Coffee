@page
@model MyOrdersModel
@{
    ViewData["Title"] = "Đơn hàng của tôi - LowLand Coffee";
}

<div class="w-full px-4 sm:px-8 lg:px-12 xl:px-16 py-6 sm:py-8 max-w-7xl mx-auto">
    <!-- Breadcrumb -->
    <nav class="flex text-xs text-gray-500 mb-6 gap-2 items-center">
        <a asp-page="/Index" class="hover:text-red-highland transition">Trang chủ</a>
        <span>/</span>
        <span class="text-gray-900 font-semibold">Đơn hàng của tôi</span>
    </nav>

    <!-- Header Section -->
    <div class="flex flex-col sm:flex-row sm:items-center sm:justify-between gap-4 mb-8">
        <div>
            <h1 class="text-2xl sm:text-3xl font-extrabold text-gray-900 tracking-tight flex items-center gap-3">
                <i class="fi fi-rr-clipboard-list text-red-highland"></i>
                <span>Lịch sử đơn hàng</span>
            </h1>
            <p class="text-sm text-gray-500 mt-1">Theo dõi tiến độ, chi tiết đồ uống và trạng thái thanh toán của bạn</p>
        </div>
        <div class="flex items-center gap-3">
            <a href="/Index#menu" class="inline-flex items-center gap-2 px-5 py-2.5 rounded-full bg-red-highland hover:bg-red-700 text-white font-bold text-sm shadow-md transition active:scale-95">
                <i class="fi fi-rr-coffee"></i>
                <span>Đặt thêm món</span>
            </a>
            <a asp-page="/Order" class="inline-flex items-center gap-2 px-4 py-2.5 rounded-full border border-gray-300 hover:bg-gray-50 text-gray-700 font-bold text-sm shadow-sm transition">
                <i class="fi fi-rr-shopping-bag"></i>
                <span>Giỏ hàng</span>
            </a>
        </div>
    </div>

    <!-- ========================================================================= -->
    <!-- TRẠNG THÁI 1: CHƯA ĐĂNG NHẬP -->
    <!-- ========================================================================= -->
    <div id="unauth-box" class="hidden max-w-lg mx-auto my-12 bg-white rounded-3xl p-8 sm:p-12 text-center shadow-xl border border-gray-200 space-y-6">
        <div class="w-20 h-20 mx-auto rounded-full bg-red-50 text-red-highland flex items-center justify-center text-4xl shadow-inner">
            <i class="fi fi-rr-lock"></i>
        </div>
        <div class="space-y-2">
            <h2 class="text-2xl font-black text-gray-900">Vui lòng đăng nhập</h2>
            <p class="text-gray-500 text-sm leading-relaxed">
                Bạn cần đăng nhập tài khoản để tra cứu lịch sử mua hàng và tiến độ giao đồ uống của mình.
            </p>
        </div>
        <div class="pt-2 flex flex-col sm:flex-row items-center justify-center gap-3">
            <a asp-page="/Auth/Login" class="w-full sm:w-auto px-8 py-3.5 rounded-2xl bg-red-highland hover:bg-red-700 text-white font-extrabold text-sm uppercase tracking-wider shadow-lg transition active:scale-95 flex items-center justify-center gap-2">
                <i class="fi fi-rr-sign-in-alt text-base"></i>
                <span>Đăng nhập ngay</span>
            </a>
            <a asp-page="/Index" class="w-full sm:w-auto px-6 py-3.5 rounded-2xl border border-gray-300 text-gray-700 font-bold text-sm hover:bg-gray-50 transition">
                Về trang chủ
            </a>
        </div>
    </div>

    <!-- ========================================================================= -->
    <!-- TRẠNG THÁI 2: ĐÃ ĐĂNG NHẬP -->
    <!-- ========================================================================= -->
    <div id="myorders-container" class="hidden">
        <!-- Filter Tabs -->
        <div class="flex items-center gap-2 overflow-x-auto pb-3 mb-6 scrollbar-none border-b border-gray-200">
            <button onclick="setFilterStatus('')" id="tab-all" class="filter-tab px-4 py-2 rounded-full text-sm font-bold transition whitespace-nowrap bg-red-highland text-white shadow-sm">
                Tất cả đơn
            </button>
            <button onclick="setFilterStatus('PENDING')" id="tab-PENDING" class="filter-tab px-4 py-2 rounded-full text-sm font-bold transition whitespace-nowrap bg-gray-100 text-gray-600 hover:bg-gray-200">
                Chờ xác nhận
            </button>
            <button onclick="setFilterStatus('PROCESSING')" id="tab-PROCESSING" class="filter-tab px-4 py-2 rounded-full text-sm font-bold transition whitespace-nowrap bg-gray-100 text-gray-600 hover:bg-gray-200">
                Đang chuẩn bị
            </button>
            <button onclick="setFilterStatus('DELIVERING')" id="tab-DELIVERING" class="filter-tab px-4 py-2 rounded-full text-sm font-bold transition whitespace-nowrap bg-gray-100 text-gray-600 hover:bg-gray-200">
                Đang giao hàng
            </button>
            <button onclick="setFilterStatus('COMPLETED')" id="tab-COMPLETED" class="filter-tab px-4 py-2 rounded-full text-sm font-bold transition whitespace-nowrap bg-gray-100 text-gray-600 hover:bg-gray-200">
                Hoàn thành
            </button>
            <button onclick="setFilterStatus('CANCELLED')" id="tab-CANCELLED" class="filter-tab px-4 py-2 rounded-full text-sm font-bold transition whitespace-nowrap bg-gray-100 text-gray-600 hover:bg-gray-200">
                Đã hủy
            </button>
        </div>

        <!-- Loading State -->
        <div id="orders-loading" class="py-16 text-center">
            <div class="inline-block animate-spin rounded-full h-10 w-10 border-4 border-red-highland border-t-transparent"></div>
            <p class="mt-4 text-sm font-bold text-gray-500">Đang tải lịch sử đơn hàng...</p>
        </div>

        <!-- Empty State -->
        <div id="orders-empty" class="hidden py-16 text-center bg-white rounded-3xl border border-gray-200 p-8 shadow-sm">
            <div class="w-20 h-20 mx-auto rounded-full bg-amber-50 text-amber-800 flex items-center justify-center text-3xl mb-4">
                <i class="fi fi-rr-mug-hot"></i>
            </div>
            <h3 class="text-xl font-bold text-gray-900 mb-2">Chưa có đơn hàng nào</h3>
            <p class="text-gray-500 text-sm max-w-md mx-auto mb-6">Bạn chưa có đơn đặt hàng nào trong trạng thái này. Hãy khám phá menu thức uống hảo hạng của LowLand Coffee nhé!</p>
            <a href="/Index#menu" class="inline-flex items-center gap-2 px-6 py-3 rounded-full bg-red-highland hover:bg-red-700 text-white font-bold text-sm shadow-md transition active:scale-95">
                <i class="fi fi-rr-coffee"></i>
                <span>Xem thực đơn ngay</span>
            </a>
        </div>

        <!-- Orders List Grid -->
        <div id="orders-list" class="space-y-4">
            <!-- Dynamic Content -->
        </div>
    </div>
</div>

<!-- ========================================================================= -->
<!-- MODAL: CHI TIẾT ĐƠN HÀNG -->
<!-- ========================================================================= -->
<div id="order-detail-modal" class="fixed inset-0 z-50 hidden bg-black/60 backdrop-blur-sm flex items-center justify-center p-4">
    <div class="bg-white rounded-3xl max-w-2xl w-full max-h-[90vh] flex flex-col shadow-2xl overflow-hidden animate-in fade-in zoom-in-95 duration-200">
        <!-- Modal Header -->
        <div class="px-6 py-4 border-b border-gray-100 flex items-center justify-between bg-gray-50/80">
            <div>
                <h3 class="text-lg font-black text-gray-900 flex items-center gap-2">
                    <span>Chi tiết đơn hàng</span>
                    <span id="modal-order-code" class="text-sm font-mono text-red-highland bg-red-50 px-2.5 py-0.5 rounded-full">#ORD-...</span>
                </h3>
                <p id="modal-order-date" class="text-xs text-gray-500 mt-0.5">Thời gian đặt: --/--/----</p>
            </div>
            <button onclick="closeOrderDetailModal()" class="w-8 h-8 rounded-full bg-gray-200/80 hover:bg-gray-300 text-gray-700 flex items-center justify-center transition">
                <i class="fi fi-rr-cross text-xs"></i>
            </button>
        </div>

        <!-- Modal Body (Scrollable) -->
        <div class="p-6 overflow-y-auto space-y-6 flex-1">
            <!-- Status & Summary Banner -->
            <div class="flex items-center justify-between p-4 rounded-2xl bg-amber-50/60 border border-amber-200/60">
                <div class="flex items-center gap-3">
                    <div id="modal-status-icon" class="w-10 h-10 rounded-full bg-amber-100 text-amber-800 flex items-center justify-center text-lg">
                        <i class="fi fi-rr-clock"></i>
                    </div>
                    <div>
                        <div class="text-xs font-semibold text-gray-500">Trạng thái xử lý</div>
                        <div id="modal-status-text" class="text-base font-black text-amber-900">Chờ xác nhận</div>
                    </div>
                </div>
                <div class="text-right">
                    <div class="text-xs font-semibold text-gray-500">Phương thức</div>
                    <div id="modal-payment-method" class="text-sm font-black text-gray-800">Tiền mặt</div>
                </div>
            </div>

            <!-- Items List -->
            <div>
                <h4 class="text-sm font-black text-gray-900 mb-3 flex items-center gap-2">
                    <i class="fi fi-rr-coffee text-red-highland"></i>
                    <span>Danh sách món đã gọi</span>
                </h4>
                <div id="modal-items-list" class="divide-y divide-gray-100 border border-gray-100 rounded-2xl p-2 bg-gray-50/50">
                    <!-- Dynamic Items -->
                </div>
            </div>

            <!-- Order Financial Details -->
            <div class="p-4 bg-gray-50 rounded-2xl space-y-2 text-sm border border-gray-100">
                <div class="flex justify-between text-gray-600">
                    <span>Tổng tiền đồ uống</span>
                    <span id="modal-subtotal" class="font-bold text-gray-900">0 đ</span>
                </div>
                <div class="flex justify-between text-gray-600">
                    <span>Giảm giá / Khuyến mãi</span>
                    <span id="modal-discount" class="font-bold text-green-600">-0 đ</span>
                </div>
                <div class="border-t border-gray-200 pt-2 flex justify-between items-center text-base">
                    <span class="font-black text-gray-900">Tổng thanh toán</span>
                    <span id="modal-total" class="font-black text-red-highland text-xl">0 đ</span>
                </div>
            </div>

            <!-- Note / Address -->
            <div id="modal-note-container" class="hidden p-3.5 bg-blue-50/60 border border-blue-100 rounded-2xl text-xs text-blue-900">
                <span class="font-bold block mb-1">Ghi chú đơn hàng:</span>
                <span id="modal-note-text" class="italic"></span>
            </div>
        </div>

        <!-- Modal Footer -->
        <div class="px-6 py-3.5 border-t border-gray-100 bg-gray-50/50 flex justify-end gap-2">
            <button onclick="closeOrderDetailModal()" class="px-5 py-2.5 rounded-xl border border-gray-300 hover:bg-gray-100 text-gray-700 font-bold text-sm transition">
                Đóng
            </button>
        </div>
    </div>
</div>

<script>
    let allOrders = [];
    let currentFilter = '';

    document.addEventListener('DOMContentLoaded', () => {
        checkAuthAndLoadOrders();
    });

    async function checkAuthAndLoadOrders() {
        const token = localStorage.getItem('auth_token');
        const user = localStorage.getItem('current_user');

        if (!token || !user) {
            document.getElementById('unauth-box').classList.remove('hidden');
            document.getElementById('myorders-container').classList.add('hidden');
            return;
        }

        document.getElementById('unauth-box').classList.add('hidden');
        document.getElementById('myorders-container').classList.remove('hidden');

        // Đồng bộ kết quả VNPay Return nếu có trên URL
        const params = new URLSearchParams(window.location.search);
        if (params.get('vnp_ResponseCode')) {
            try {
                await fetch(`http://localhost:5003/api/payments/vnpay-return${window.location.search}`);
            } catch(e) {}
            window.history.replaceState({}, document.title, window.location.pathname);
        }

        await fetchMyOrders();
    }

    async function fetchMyOrders() {
        const token = localStorage.getItem('auth_token');
        const loading = document.getElementById('orders-loading');
        const empty = document.getElementById('orders-empty');
        const list = document.getElementById('orders-list');

        loading.classList.remove('hidden');
        empty.classList.add('hidden');
        list.innerHTML = '';

        try {
            const res = await fetch('http://localhost:5003/api/orders/my-orders?pageNumber=1&pageSize=50', {
                headers: {
                    'Authorization': `Bearer ${token}`
                }
            });

            if (res.status === 401) {
                // Token hết hạn hoặc sai
                document.getElementById('unauth-box').classList.remove('hidden');
                document.getElementById('myorders-container').classList.add('hidden');
                return;
            }

            const data = await res.json();
            if (data && data.data && Array.isArray(data.data.items)) {
                allOrders = data.data.items;
            } else if (Array.isArray(data.data)) {
                allOrders = data.data;
            } else {
                allOrders = [];
            }

            renderOrders();
        } catch (err) {
            console.error('Lỗi khi tải đơn hàng:', err);
            empty.classList.remove('hidden');
        } finally {
            loading.classList.add('hidden');
        }
    }

    function setFilterStatus(status) {
        currentFilter = status;
        document.querySelectorAll('.filter-tab').forEach(btn => {
            btn.classList.remove('bg-red-highland', 'text-white', 'shadow-sm');
            btn.classList.add('bg-gray-100', 'text-gray-600');
        });

        const activeId = status ? `tab-${status}` : 'tab-all';
        const activeBtn = document.getElementById(activeId);
        if (activeBtn) {
            activeBtn.classList.remove('bg-gray-100', 'text-gray-600');
            activeBtn.classList.add('bg-red-highland', 'text-white', 'shadow-sm');
        }

        renderOrders();
    }

    function formatPaymentText(method, status) {
        let m = (method || 'CASH').toUpperCase();
        let name = 'Tiền mặt';
        if (m.includes('VNPAY')) name = 'VNPay QR';
        else if (m.includes('MOMO')) name = 'MoMo';
        else if (m.includes('ZALO')) name = 'ZaloPay';

        const s = (status || '').toUpperCase();
        if (s === 'SUCCESS' || s === 'PAID') {
            return `${name} <span class="text-emerald-700 font-bold bg-emerald-50 border border-emerald-200 px-2 py-0.5 rounded-full text-[11px] ml-1">Đã thanh toán</span>`;
        } else if (s === 'PENDING') {
            return `${name} <span class="text-amber-700 font-bold bg-amber-50 border border-amber-200 px-2 py-0.5 rounded-full text-[11px] ml-1">Chờ thanh toán</span>`;
        }
        return name;
    }

    function renderOrders() {
        const list = document.getElementById('orders-list');
        const empty = document.getElementById('orders-empty');

        let filtered = allOrders;
        if (currentFilter) {
            filtered = allOrders.filter(o => (o.status || '').toUpperCase() === currentFilter.toUpperCase());
        }

        if (!filtered || filtered.length === 0) {
            empty.classList.remove('hidden');
            list.innerHTML = '';
            return;
        }

        empty.classList.add('hidden');

        list.innerHTML = filtered.map(order => {
            const statusConfig = getStatusBadge(order.status);
            const formattedDate = formatDate(order.createdAt);
            const totalFmt = (order.finalAmount || order.totalAmount || 0).toLocaleString('vi-VN');
            const totalItems = order.totalItems || 1;

            return `
                <div class="bg-white rounded-2xl p-5 sm:p-6 border border-gray-200 shadow-sm hover:shadow-md transition">
                    <div class="flex flex-col sm:flex-row sm:items-center justify-between pb-4 border-b border-gray-100 gap-3">
                        <div class="flex items-center gap-3">
                            <span class="w-10 h-10 rounded-xl bg-red-50 text-red-highland flex items-center justify-center text-lg font-bold">
                                <i class="fi fi-rr-receipt"></i>
                            </span>
                            <div>
                                <div class="font-mono font-bold text-gray-900 text-base sm:text-lg">#${order.orderCode || order.id.substring(0, 8).toUpperCase()}</div>
                                <div class="text-xs text-gray-500 flex items-center gap-1.5 mt-0.5">
                                    <i class="fi fi-rr-calendar"></i>
                                    <span>${formattedDate}</span>
                                </div>
                            </div>
                        </div>
                        <div class="flex items-center gap-2">
                            <span class="px-3.5 py-1.5 rounded-full text-xs font-bold flex items-center gap-1.5 ${statusConfig.class}">
                                <i class="${statusConfig.icon}"></i>
                                <span>${statusConfig.label}</span>
                            </span>
                        </div>
                    </div>

                    <div class="py-4 flex flex-col sm:flex-row sm:items-center justify-between gap-4">
                        <div class="space-y-1">
                            <div class="text-sm font-bold text-gray-700">
                                <span>Số lượng món:</span> <span class="text-gray-900 font-black">${totalItems} phần</span>
                            </div>
                            ${order.itemsSummary ? `<div class="text-xs font-semibold text-gray-800 bg-gray-50 border border-gray-200/60 rounded-lg px-2.5 py-1 inline-block">${order.itemsSummary}</div>` : ''}
                            <div class="text-xs text-gray-500 flex items-center gap-1 flex-wrap">
                                <span>Phương thức thanh toán:</span>
                                <span>${formatPaymentText(order.paymentMethod, order.paymentStatus)}</span>
                            </div>
                            ${order.note ? `<div class="text-xs text-amber-800 bg-amber-50 rounded-lg px-2.5 py-1 inline-block mt-1 font-medium">Ghi chú: ${order.note}</div>` : ''}
                        </div>

                        <div class="sm:text-right">
                            <div class="text-xs text-gray-500 font-medium">Tổng tiền thanh toán</div>
                            <div class="text-xl sm:text-2xl font-black text-red-highland">${totalFmt} đ</div>
                        </div>
                    </div>

                    <div class="pt-3 border-t border-gray-100 flex items-center justify-end gap-2">
                        <button onclick="viewOrderDetail('${order.id}')" class="px-4 py-2 rounded-xl bg-gray-100 hover:bg-gray-200 text-gray-800 font-bold text-xs flex items-center gap-1.5 transition">
                            <i class="fi fi-rr-eye"></i>
                            <span>Xem chi tiết</span>
                        </button>
                    </div>
                </div>
            `;
        }).join('');
    }

    async function viewOrderDetail(orderId) {
        const token = localStorage.getItem('auth_token');
        try {
            const res = await fetch(`http://localhost:5003/api/orders/${orderId}`, {
                headers: {
                    'Authorization': `Bearer ${token}`
                }
            });
            const resJson = await res.json();
            const order = resJson.data || resJson;

            if (!order) return;

            document.getElementById('modal-order-code').innerText = `#${order.orderCode || order.id.substring(0, 8).toUpperCase()}`;
            document.getElementById('modal-order-date').innerText = `Thời gian đặt: ${formatDate(order.createdAt)}`;
            
            const statusConfig = getStatusBadge(order.status);
            document.getElementById('modal-status-text').innerText = statusConfig.label;
            document.getElementById('modal-status-text').className = `text-base font-black ${statusConfig.textClass}`;
            document.getElementById('modal-status-icon').innerHTML = `<i class="${statusConfig.icon}"></i>`;
            
            let payName = 'Tiền mặt';
            if ((order.paymentMethod || '').toUpperCase().includes('VNPAY')) payName = 'VNPay QR';
            const paySt = (order.paymentStatus || '').toUpperCase();
            const payStatusText = (paySt === 'SUCCESS' || paySt === 'PAID') ? ' (Đã thanh toán)' : ' (Chờ thanh toán)';
            document.getElementById('modal-payment-method').innerText = `${payName}${payStatusText}`;

            const itemsContainer = document.getElementById('modal-items-list');
            if (order.items && order.items.length > 0) {
                itemsContainer.innerHTML = order.items.map(item => `
                    <div class="py-2.5 px-3 flex items-center justify-between text-sm">
                        <div>
                            <div class="font-bold text-gray-900">${item.productName || 'Đồ uống'}</div>
                            <div class="text-xs text-gray-500">${item.optionsSummary || ''}</div>
                        </div>
                        <div class="text-right">
                            <div class="font-bold text-gray-900">${(item.subtotal || item.unitPrice * item.quantity).toLocaleString('vi-VN')} đ</div>
                            <div class="text-xs text-gray-500">x${item.quantity}</div>
                        </div>
                    </div>
                `).join('');
            } else {
                itemsContainer.innerHTML = `<div class="p-3 text-xs text-gray-500 italic text-center">Chi tiết các món được lưu trong hóa đơn</div>`;
            }

            document.getElementById('modal-subtotal').innerText = `${(order.totalAmount || 0).toLocaleString('vi-VN')} đ`;
            document.getElementById('modal-discount').innerText = `-${(order.discountAmount || 0).toLocaleString('vi-VN')} đ`;
            document.getElementById('modal-total').innerText = `${(order.finalAmount || order.totalAmount || 0).toLocaleString('vi-VN')} đ`;

            if (order.note) {
                document.getElementById('modal-note-container').classList.remove('hidden');
                document.getElementById('modal-note-text').innerText = order.note;
            } else {
                document.getElementById('modal-note-container').classList.add('hidden');
            }

            document.getElementById('order-detail-modal').classList.remove('hidden');
        } catch (e) {
            console.error(e);
            alert('Không thể tải chi tiết đơn hàng.');
        }
    }

    function closeOrderDetailModal() {
        document.getElementById('order-detail-modal').classList.add('hidden');
    }

    function getStatusBadge(status) {
        const s = (status || '').toUpperCase();
        switch (s) {
            case 'PENDING':
                return { label: 'Chờ xác nhận', class: 'bg-amber-100 text-amber-800', textClass: 'text-amber-800', icon: 'fi fi-rr-time-past' };
            case 'CONFIRMED':
            case 'PROCESSING':
                return { label: 'Đang chuẩn bị', class: 'bg-blue-100 text-blue-800', textClass: 'text-blue-800', icon: 'fi fi-rr-coffee' };
            case 'DELIVERING':
                return { label: 'Đang giao', class: 'bg-purple-100 text-purple-800', textClass: 'text-purple-800', icon: 'fi fi-rr-moped' };
            case 'COMPLETED':
                return { label: 'Hoàn thành', class: 'bg-emerald-100 text-emerald-800', textClass: 'text-emerald-800', icon: 'fi fi-rr-check-circle' };
            case 'CANCELLED':
                return { label: 'Đã hủy', class: 'bg-rose-100 text-rose-800', textClass: 'text-rose-800', icon: 'fi fi-rr-cross-circle' };
            default:
                return { label: status || 'Không xác định', class: 'bg-gray-100 text-gray-800', textClass: 'text-gray-800', icon: 'fi fi-rr-info' };
        }
    }

    function formatDate(dateStr) {
        if (!dateStr) return '';
        try {
            const d = new Date(dateStr);
            return d.toLocaleDateString('vi-VN', {
                hour: '2-digit',
                minute: '2-digit',
                day: '2-digit',
                month: '2-digit',
                year: 'numeric'
            });
        } catch {
            return dateStr;
        }
    }
</script>
