@page "/MyOrders"
@model CoffeeShop.WebRazorPages.Pages.MyOrdersModel
@{
    Layout = "_Layout";
    ViewData["Title"] = "Đơn Hàng Của Tôi - LowLand Coffee";
}

<!-- Hero Header -->
<section class="relative bg-gradient-to-r from-red-highland-dark via-red-highland to-red-800 text-white overflow-hidden py-10 sm:py-12 px-4 sm:px-8 lg:px-12 shadow-inner">
    <div class="max-w-7xl mx-auto flex flex-col md:flex-row items-start md:items-center justify-between gap-6 relative z-10">
        <div class="space-y-2">
            <div class="inline-flex items-center gap-2 px-3.5 py-1.5 rounded-full bg-amber-300/20 border border-amber-300/40 text-amber-200 text-xs font-extrabold uppercase tracking-wider">
                <i class="fi fi-rr-receipt"></i>
                <span>Theo Dõi Tiến Trình Đơn Hàng</span>
            </div>
            <h1 class="text-2xl sm:text-3xl lg:text-4xl font-black tracking-tight">
                Đơn Hàng Của Tôi
            </h1>
            <p class="text-white/85 text-sm sm:text-base max-w-2xl">
                Kiểm tra trạng thái pha chế theo thời gian thực, xem hóa đơn chi tiết và thanh toán trực tuyến qua cổng VNPay QR bất cứ lúc nào.
            </p>
        </div>

        <div class="flex flex-wrap items-center gap-3">
            <a asp-page="/MyOrders" asp-route-Status="@Model.Status" asp-route-Search="@Model.Search"
               class="px-5 py-2.5 rounded-2xl bg-white/15 hover:bg-white/25 text-white border border-white/30 font-bold text-sm transition flex items-center gap-2">
                <i class="fi fi-rr-refresh"></i>
                <span>Làm mới</span>
            </a>
            <a href="/Index#menu"
               class="px-5 py-2.5 rounded-2xl bg-amber-300 hover:bg-amber-200 text-red-950 font-extrabold text-sm shadow-lg transition flex items-center gap-2">
                <i class="fi fi-rr-plus-small text-base"></i>
                <span>Đặt thêm món</span>
            </a>
        </div>
    </div>
</section>

<div class="max-w-7xl mx-auto px-4 sm:px-8 lg:px-12 py-8 space-y-6">
    <!-- Thông báo phản hồi từ Server / VNPay Return -->
    @if (!string.IsNullOrWhiteSpace(Model.SuccessMessage))
    {
        <div class="p-4 rounded-2xl bg-emerald-50 border border-emerald-200 text-emerald-800 flex items-center justify-between gap-3 shadow-sm">
            <div class="flex items-center gap-3">
                <span class="w-9 h-9 rounded-xl bg-emerald-600 text-white flex items-center justify-center shrink-0">
                    <i class="fi fi-rr-check"></i>
                </span>
                <span class="text-sm font-bold">@Model.SuccessMessage</span>
            </div>
        </div>
    }

    @if (!string.IsNullOrWhiteSpace(Model.ErrorMessage))
    {
        <div class="p-4 rounded-2xl bg-amber-50 border border-amber-300 text-amber-900 flex items-center justify-between gap-3 shadow-sm">
            <div class="flex items-center gap-3">
                <span class="w-9 h-9 rounded-xl bg-amber-500 text-white flex items-center justify-center shrink-0">
                    <i class="fi fi-rr-exclamation"></i>
                </span>
                <span class="text-sm font-bold">@Model.ErrorMessage</span>
            </div>
        </div>
    }

    <!-- KPI Cards -->
    <div class="grid grid-cols-2 lg:grid-cols-4 gap-4">
        <div class="bg-white p-5 rounded-3xl border border-gray-200 shadow-sm flex items-center gap-4">
            <span class="w-12 h-12 rounded-2xl bg-red-50 text-red-highland flex items-center justify-center text-xl shrink-0">
                <i class="fi fi-rr-shopping-bag"></i>
            </span>
            <div>
                <div class="text-2xl font-black text-gray-900">@Model.TotalCount</div>
                <div class="text-xs font-bold uppercase tracking-wider text-gray-500">Tổng đơn hàng</div>
            </div>
        </div>

        <div class="bg-white p-5 rounded-3xl border border-gray-200 shadow-sm flex items-center gap-4">
            <span class="w-12 h-12 rounded-2xl bg-amber-50 text-amber-600 flex items-center justify-center text-xl shrink-0">
                <i class="fi fi-rr-hourglass-end"></i>
            </span>
            <div>
                <div class="text-2xl font-black text-gray-900">@Model.PendingCount</div>
                <div class="text-xs font-bold uppercase tracking-wider text-gray-500">Chờ xác nhận</div>
            </div>
        </div>

        <div class="bg-white p-5 rounded-3xl border border-gray-200 shadow-sm flex items-center gap-4">
            <span class="w-12 h-12 rounded-2xl bg-blue-50 text-blue-600 flex items-center justify-center text-xl shrink-0">
                <i class="fi fi-rr-mug-hot-alt"></i>
            </span>
            <div>
                <div class="text-2xl font-black text-gray-900">@Model.ActiveCount</div>
                <div class="text-xs font-bold uppercase tracking-wider text-gray-500">Đang pha chế / Giao</div>
            </div>
        </div>

        <div class="bg-white p-5 rounded-3xl border border-gray-200 shadow-sm flex items-center gap-4">
            <span class="w-12 h-12 rounded-2xl bg-emerald-50 text-emerald-600 flex items-center justify-center text-xl shrink-0">
                <i class="fi fi-rr-badge-check"></i>
            </span>
            <div>
                <div class="text-2xl font-black text-gray-900">@Model.CompletedCount</div>
                <div class="text-xs font-bold uppercase tracking-wider text-gray-500">Đã hoàn thành</div>
            </div>
        </div>
    </div>

    <!-- Thanh Lọc Trạng Thái & Tìm Kiếm (Razor Form GET) -->
    <div class="bg-white p-5 rounded-3xl border border-gray-200 shadow-sm flex flex-col lg:flex-row gap-4 items-stretch lg:items-center justify-between">
        <div class="flex flex-wrap items-center gap-2">
            @{
                var tabs = new (string Key, string Label, int? Count)[]
                {
                    ("ALL", "Tất cả", Model.TotalCount),
                    ("PENDING", "Chờ xác nhận", Model.PendingCount),
                    ("PROCESSING", "Đang pha chế", null),
                    ("SHIPPING", "Đang giao hàng", null),
                    ("COMPLETED", "Hoàn thành", Model.CompletedCount),
                    ("CANCELLED", "Đã hủy", Model.CancelledCount)
                };
            }
            @foreach (var tab in tabs)
            {
                var isActive = string.Equals(Model.Status, tab.Key, StringComparison.OrdinalIgnoreCase);
                <a asp-page="/MyOrders"
                   asp-route-Status="@tab.Key"
                   asp-route-Search="@Model.Search"
                   class="px-4 py-2.5 rounded-2xl text-xs font-extrabold transition @(isActive ? "bg-red-highland text-white shadow-md" : "bg-gray-100 text-gray-700 hover:bg-gray-200")">
                    @tab.Label @(tab.Count.HasValue ? $"({tab.Count.Value})" : "")
                </a>
            }
        </div>

        <form method="get" asp-page="/MyOrders" class="flex items-center gap-2 w-full lg:w-96">
            <input type="hidden" name="Status" value="@Model.Status" />
            <div class="relative flex-1">
                <input type="text"
                       name="Search"
                       value="@Model.Search"
                       placeholder="Tìm mã đơn (VD: ORD-2026)..."
                       class="w-full bg-gray-50 border border-gray-300 rounded-2xl pl-10 pr-4 py-2.5 text-sm font-semibold text-gray-900 focus:ring-2 focus:ring-red-highland" />
                <span class="absolute left-3.5 top-3 text-gray-400">
                    <i class="fi fi-rr-search text-sm"></i>
                </span>
            </div>
            <button type="submit" class="px-5 py-2.5 rounded-2xl bg-gray-900 hover:bg-black text-white text-xs font-extrabold transition">
                Tìm
            </button>
            @if (!string.IsNullOrWhiteSpace(Model.Search))
            {
                <a asp-page="/MyOrders" asp-route-Status="@Model.Status"
                   class="px-3.5 py-2.5 rounded-2xl bg-gray-100 hover:bg-gray-200 text-gray-700 text-xs font-bold transition"
                   title="Xóa từ khóa">
                    <i class="fi fi-rr-cross-small"></i>
                </a>
            }
        </form>
    </div>

    <!-- Danh sách đơn hàng (Server-side Razor rendering) -->
    @if (Model.Orders.Count == 0)
    {
        <div class="bg-white rounded-3xl border border-gray-200 p-12 text-center shadow-sm space-y-4">
            <div class="w-16 h-16 rounded-full bg-red-50 text-red-highland flex items-center justify-center text-3xl mx-auto">
                <i class="fi fi-rr-mug-hot-alt"></i>
            </div>
            <h3 class="text-xl font-black text-gray-900">Chưa có đơn hàng nào</h3>
            <p class="text-gray-500 text-sm max-w-md mx-auto">
                Không tìm thấy đơn hàng nào khớp với bộ lọc hiện tại. Hãy khám phá thực đơn LowLand Coffee và đặt món ngay!
            </p>
            <div class="pt-2">
                <a href="/Index#menu" class="inline-flex items-center gap-2 px-6 py-3 rounded-2xl bg-red-highland hover:bg-red-highland-dark text-white font-extrabold text-sm shadow-md transition">
                    <i class="fi fi-rr-shopping-cart-add"></i>
                    <span>Khám phá thực đơn</span>
                </a>
            </div>
        </div>
    }
    else
    {
        var flowSteps = new[] { "PENDING", "PROCESSING", "SHIPPING", "COMPLETED" };
        var stepLabels = new Dictionary<string, string>
        {
            ["PENDING"] = "1. Tiếp nhận",
            ["PROCESSING"] = "2. Đang pha chế",
            ["SHIPPING"] = "3. Đang giao hàng",
            ["COMPLETED"] = "4. Hoàn thành"
        };

        <div class="space-y-4">
            @foreach (var order in Model.Orders)
            {
                var currentIdx = Array.IndexOf(flowSteps, order.NormalizedStatus);
                var statusBadgeClass = order.NormalizedStatus switch
                {
                    "PENDING" => "bg-amber-100 text-amber-800 border-amber-300",
                    "PROCESSING" => "bg-blue-100 text-blue-800 border-blue-300",
                    "SHIPPING" => "bg-purple-100 text-purple-800 border-purple-300",
                    "COMPLETED" => "bg-emerald-100 text-emerald-800 border-emerald-300",
                    "CANCELLED" => "bg-red-100 text-red-800 border-red-300",
                    _ => "bg-gray-100 text-gray-800 border-gray-300"
                };

                var paymentBadgeClass = order.IsPaid
                    ? "bg-emerald-100 text-emerald-800"
                    : (order.NormalizedPaymentStatus == "FAILED" ? "bg-red-100 text-red-700" : "bg-amber-100 text-amber-800");

                <div class="bg-white rounded-3xl border border-gray-200 shadow-sm hover:shadow-md transition overflow-hidden">
                    <!-- Header Card -->
                    <div class="px-6 py-4 bg-gray-50/80 border-b border-gray-100 flex flex-wrap items-center justify-between gap-3">
                        <div class="flex flex-wrap items-center gap-3">
                            <span class="px-3 py-1 rounded-xl bg-amber-100/80 text-gray-900 font-mono font-black text-sm">
                                #@order.OrderCode
                            </span>
                            <span class="text-xs font-semibold text-gray-500 flex items-center gap-1.5">
                                <i class="fi fi-rr-clock"></i>
                                @order.CreatedAt.ToLocalTime().ToString("dd/MM/yyyy HH:mm")
                            </span>
                            <span class="px-3 py-1 rounded-xl text-xs font-extrabold @paymentBadgeClass">
                                @order.PaymentMethodDisplayName • @order.PaymentStatusDisplayName
                            </span>
                        </div>

                        <span class="px-3.5 py-1 rounded-full text-xs font-extrabold border @statusBadgeClass">
                            @order.StatusDisplayName
                        </span>
                    </div>

                    <!-- Body Card -->
                    <div class="p-6 flex flex-col lg:flex-row items-start lg:items-center justify-between gap-6">
                        <div class="space-y-3 flex-1">
                            <div class="text-base font-extrabold text-gray-900">
                                @(string.IsNullOrWhiteSpace(order.ItemsSummary) ? $"Đơn hàng ({order.TotalItems} món)" : order.ItemsSummary)
                            </div>

                            @if (!string.IsNullOrWhiteSpace(order.Note))
                            {
                                <div class="text-xs text-gray-600 flex items-center gap-1.5">
                                    <i class="fi fi-rr-comment-alt text-gray-400"></i>
                                    <span>@order.Note</span>
                                </div>
                            }

                            @if (order.IsCancelled)
                            {
                                <div class="inline-flex items-center gap-2 px-3.5 py-2 rounded-2xl bg-red-50 border border-red-200 text-red-700 text-xs font-bold">
                                    <i class="fi fi-rr-Ban"></i>
                                    <span>Lý do hủy: @(string.IsNullOrWhiteSpace(order.CancelReason) ? "Không có lý do chi tiết" : order.CancelReason)</span>
                                </div>
                            }
                            else
                            {
                                <!-- Thanh tiến trình trạng thái 4 bước -->
                                <div class="flex flex-wrap items-center gap-2 pt-1">
                                    @for (int idx = 0; idx < flowSteps.Length; idx++)
                                    {
                                        var stepKey = flowSteps[idx];
                                        var nodeClass = idx < currentIdx
                                            ? "bg-emerald-100 text-emerald-800"
                                            : (idx == currentIdx ? "bg-gray-900 text-white shadow-sm" : "bg-gray-100 text-gray-500");

                                        <span class="px-3 py-1 rounded-xl text-xs font-bold @nodeClass">
                                            @stepLabels[stepKey]
                                        </span>
                                        if (idx < flowSteps.Length - 1)
                                        {
                                            <span class="text-gray-300 text-xs">→</span>
                                        }
                                    }
                                </div>
                            }

                            <!-- Nhắc nhở trạng thái thanh toán -->
                            @if (order.CanRetryPayment)
                            {
                                <div class="inline-flex items-center gap-2 px-3.5 py-2 rounded-2xl bg-amber-50 border border-dashed border-amber-400 text-amber-900 text-xs font-semibold">
                                    <i class="fi fi-rr-info text-amber-600"></i>
                                    <span>Đơn hàng chưa thanh toán VNPay. Bạn có thể nhấn <strong>Thanh toán VNPay</strong> bên phải để chuyển tới cổng thanh toán ngay.</span>
                                </div>
                            }
                            else if (order.NormalizedPaymentMethod == "CASH" && !order.IsPaid && !order.IsCancelled)
                            {
                                <div class="inline-flex items-center gap-2 px-3.5 py-2 rounded-2xl bg-emerald-50 border border-emerald-200 text-emerald-800 text-xs font-semibold">
                                    <i class="fi fi-rr-money-bill-wave text-emerald-600"></i>
                                    <span>Phương thức: <strong>Tiền mặt (COD)</strong> khi nhận hàng.</span>
                                </div>
                            }
                        </div>

                        <!-- Cột giá tiền & Các nút thao tác -->
                        <div class="w-full lg:w-auto flex flex-col sm:flex-row lg:flex-col items-start sm:items-center lg:items-end justify-between gap-3 pt-4 lg:pt-0 border-t lg:border-t-0 border-gray-100">
                            <div class="lg:text-right">
                                <div class="text-xs font-semibold text-gray-500">Tổng thanh toán</div>
                                <div class="text-xl font-black text-red-highland">@order.FinalAmount.ToString("N0") đ</div>
                            </div>

                            <div class="flex flex-wrap items-center gap-2">
                                <a asp-page="/MyOrders"
                                   asp-route-Status="@Model.Status"
                                   asp-route-Search="@Model.Search"
                                   asp-route-DetailId="@order.Id"
                                   class="px-4 py-2.5 rounded-2xl bg-gray-100 hover:bg-gray-200 text-gray-800 text-xs font-extrabold transition flex items-center gap-1.5">
                                    <i class="fi fi-rr-eye"></i>
                                    <span>Chi tiết</span>
                                </a>

                                @if (order.CanRetryPayment)
                                {
                                    <form method="post" asp-page-handler="GenerateQr" class="inline">
                                        <input type="hidden" name="orderId" value="@order.Id" />
                                        <input type="hidden" name="returnStatus" value="@Model.Status" />
                                        <input type="hidden" name="returnSearch" value="@Model.Search" />
                                        <button type="submit"
                                                class="px-4 py-2.5 rounded-2xl bg-blue-600 hover:bg-blue-700 text-white text-xs font-extrabold shadow-sm transition flex items-center gap-1.5">
                                            <i class="fi fi-rr-credit-card"></i>
                                            <span>@(order.NormalizedPaymentStatus == "FAILED" ? "Thanh toán lại VNPay" : "Thanh toán VNPay")</span>
                                        </button>
                                    </form>
                                }

                                @if (order.CanCustomerCancel)
                                {
                                    <button type="button"
                                            onclick="openCustomerCancelModal('@order.Id', '@order.OrderCode')"
                                            class="px-4 py-2.5 rounded-2xl bg-red-50 hover:bg-red-100 text-red-700 border border-red-200 text-xs font-extrabold transition flex items-center gap-1.5">
                                        <i class="fi fi-rr-cross-circle"></i>
                                        <span>Hủy đơn</span>
                                    </button>
                                }
                            </div>
                        </div>
                    </div>
                </div>
            }
        </div>
    }
</div>

<!-- ========================================================================= -->
<!-- MODAL 1: CHI TIẾT ĐƠN HÀNG (SERVER-SIDE RAZOR)                            -->
<!-- ========================================================================= -->
@if (Model.SelectedOrderDetail != null)
{
    var detail = Model.SelectedOrderDetail;
    var latestPayment = detail.Payments?.OrderByDescending(p => p.CreatedAt).FirstOrDefault();

    <div class="fixed inset-0 z-50 flex items-center justify-center bg-black/60 backdrop-blur-sm p-4 overflow-y-auto">
        <div class="bg-white rounded-3xl shadow-2xl border border-gray-200 w-full max-w-2xl overflow-hidden my-8">
            <div class="px-6 py-4 bg-gray-900 text-white flex items-center justify-between">
                <div>
                    <h3 class="text-lg font-black">Chi tiết đơn hàng #@detail.OrderCode</h3>
                    <p class="text-xs text-gray-400">Ngày đặt: @detail.CreatedAt.ToLocalTime().ToString("dd/MM/yyyy HH:mm")</p>
                </div>
                <a asp-page="/MyOrders" asp-route-Status="@Model.Status" asp-route-Search="@Model.Search"
                   class="w-9 h-9 rounded-full bg-white/10 hover:bg-white/20 flex items-center justify-center text-white transition">
                    <i class="fi fi-rr-cross-small"></i>
                </a>
            </div>

            <div class="p-6 space-y-5 max-h-[75vh] overflow-y-auto">
                <div class="grid grid-cols-1 sm:grid-cols-2 gap-4">
                    <div class="p-4 rounded-2xl bg-gray-50 border border-gray-200 space-y-1.5">
                        <div class="text-[11px] font-extrabold uppercase tracking-wider text-gray-400">Trạng thái đơn hàng</div>
                        <div class="text-sm font-black text-gray-900">@detail.StatusDisplayName</div>
                        @if (!string.IsNullOrWhiteSpace(detail.CustomerName))
                        {
                            <div class="text-xs text-gray-600"><strong>Khách hàng:</strong> @detail.CustomerName</div>
                        }
                        @if (!string.IsNullOrWhiteSpace(detail.Note))
                        {
                            <div class="text-xs text-gray-600"><strong>Ghi chú:</strong> @detail.Note</div>
                        }
                        @if (!string.IsNullOrWhiteSpace(detail.CancelReason))
                        {
                            <div class="text-xs text-red-600 font-bold"><strong>Lý do hủy:</strong> @detail.CancelReason</div>
                        }
                    </div>

                    <div class="p-4 rounded-2xl bg-gray-50 border border-gray-200 space-y-1.5">
                        <div class="text-[11px] font-extrabold uppercase tracking-wider text-gray-400">Thông tin thanh toán</div>
                        <div class="text-sm font-black text-gray-900">Phương thức: @detail.PaymentMethodDisplayName</div>
                        <div class="text-xs font-bold @(detail.IsPaid ? "text-emerald-700" : "text-amber-700")">
                            Trạng thái: @detail.PaymentStatusDisplayName
                        </div>
                        @if (!string.IsNullOrWhiteSpace(latestPayment?.TransactionCode))
                        {
                            <div class="text-xs text-gray-500 font-mono">Mã GD: @latestPayment.TransactionCode</div>
                        }
                    </div>
                </div>

                <div>
                    <h4 class="text-sm font-black text-gray-900 mb-2.5">Danh sách món đã đặt (@detail.Items.Count)</h4>
                    <div class="border border-gray-200 rounded-2xl overflow-hidden">
                        <table class="w-full text-sm text-left">
                            <thead class="bg-gray-50 text-xs font-extrabold uppercase text-gray-500 border-b border-gray-200">
                                <tr>
                                    <th class="px-4 py-3">Tên món</th>
                                    <th class="px-3 py-3 text-center">SL</th>
                                    <th class="px-4 py-3 text-right">Đơn giá</th>
                                    <th class="px-4 py-3 text-right">Thành tiền</th>
                                </tr>
                            </thead>
                            <tbody class="divide-y divide-gray-100">
                                @foreach (var item in detail.Items)
                                {
                                    <tr>
                                        <td class="px-4 py-3">
                                            <div class="font-bold text-gray-900">@item.ProductName</div>
                                            @if (!string.IsNullOrWhiteSpace(item.OptionsSummary))
                                            {
                                                <div class="text-xs text-gray-500">@item.OptionsSummary</div>
                                            }
                                        </td>
                                        <td class="px-3 py-3 text-center font-bold">x@(item.Quantity)</td>
                                        <td class="px-4 py-3 text-right text-gray-600">@item.UnitPrice.ToString("N0") đ</td>
                                        <td class="px-4 py-3 text-right font-extrabold text-gray-900">@item.Subtotal.ToString("N0") đ</td>
                                    </tr>
                                }
                            </tbody>
                        </table>
                    </div>
                </div>

                <div class="p-4 rounded-2xl bg-amber-50/70 border border-amber-200 space-y-1.5 text-sm">
                    <div class="flex justify-between text-gray-600">
                        <span>Tạm tính:</span>
                        <span class="font-bold">@detail.TotalAmount.ToString("N0") đ</span>
                    </div>
                    <div class="flex justify-between text-emerald-700">
                        <span>Giảm giá khuyến mãi:</span>
                        <span class="font-bold">-@detail.DiscountAmount.ToString("N0") đ</span>
                    </div>
                    <div class="flex justify-between pt-2 border-t border-amber-200 text-base font-black text-red-highland">
                        <span>Tổng thanh toán:</span>
                        <span>@detail.FinalAmount.ToString("N0") đ</span>
                    </div>
                </div>
            </div>

            <div class="px-6 py-4 bg-gray-50 border-t border-gray-100 flex flex-wrap items-center justify-between gap-3">
                <div>
                    @if (detail.CanRetryPayment)
                    {
                        <form method="post" asp-page-handler="GenerateQr" class="inline">
                            <input type="hidden" name="orderId" value="@detail.Id" />
                            <input type="hidden" name="returnStatus" value="@Model.Status" />
                            <input type="hidden" name="returnSearch" value="@Model.Search" />
                            <button type="submit" class="px-5 py-2.5 rounded-2xl bg-blue-600 hover:bg-blue-700 text-white text-xs font-extrabold shadow-sm transition flex items-center gap-2">
                                <i class="fi fi-rr-credit-card"></i>
                                <span>Thanh toán ngay (VNPay)</span>
                            </button>
                        </form>
                    }
                </div>
                <a asp-page="/MyOrders" asp-route-Status="@Model.Status" asp-route-Search="@Model.Search"
                   class="px-5 py-2.5 rounded-2xl bg-gray-200 hover:bg-gray-300 text-gray-800 text-xs font-extrabold transition">
                    Đóng
                </a>
            </div>
        </div>
    </div>
}

<!-- ========================================================================= -->
<!-- MODAL 3: HỦY ĐƠN HÀNG (GỬI VỀ ONPOSTCANCELORDERASYNC)                     -->
<!-- ========================================================================= -->
<div id="cancelOrderModal" class="hidden fixed inset-0 z-50 items-center justify-center bg-black/60 backdrop-blur-sm p-4">
    <div class="bg-white rounded-3xl shadow-2xl border border-gray-200 w-full max-w-md overflow-hidden">
        <form method="post" asp-page-handler="CancelOrder">
            <div class="px-6 py-4 bg-red-highland text-white flex items-center justify-between">
                <h3 class="text-base font-black flex items-center gap-2">
                    <i class="fi fi-rr-exclamation"></i>
                    <span>Xác nhận hủy đơn hàng</span>
                </h3>
                <button type="button" onclick="closeCustomerCancelModal()" class="w-8 h-8 rounded-full bg-white/15 hover:bg-white/25 flex items-center justify-center text-white">
                    <i class="fi fi-rr-cross-small"></i>
                </button>
            </div>

            <div class="p-6 space-y-4">
                <input type="hidden" name="orderId" id="cancelOrderIdInput" />
                <input type="hidden" name="returnStatus" value="@Model.Status" />
                <input type="hidden" name="returnSearch" value="@Model.Search" />

                <p class="text-sm text-gray-700">
                    Bạn có chắc chắn muốn hủy đơn hàng <strong id="cancelOrderCodeLabel" class="text-red-highland font-black"></strong>?
                </p>

                <div class="space-y-2">
                    <label class="block text-xs font-extrabold uppercase text-gray-600">Lý do hủy đơn <span class="text-red-500">*</span></label>
                    <select onchange="if(this.value) document.getElementById('cancelReasonInput').value = this.value;"
                            class="w-full bg-gray-50 border border-gray-300 rounded-2xl px-3.5 py-2.5 text-xs font-semibold text-gray-800">
                        <option value="">-- Chọn nhanh lý do hủy --</option>
                        <option value="Muốn thay đổi món hoặc số lượng trong đơn">Muốn thay đổi món hoặc số lượng trong đơn</option>
                        <option value="Muốn đổi phương thức thanh toán hoặc mã giảm giá">Muốn đổi phương thức thanh toán hoặc mã giảm giá</option>
                        <option value="Thay đổi địa chỉ hoặc thời gian nhận hàng">Thay đổi địa chỉ hoặc thời gian nhận hàng</option>
                        <option value="Đặt nhầm đơn hàng">Đặt nhầm đơn hàng</option>
                    </select>
                    <textarea name="cancelReason" id="cancelReasonInput" rows="3" required
                              class="w-full bg-gray-50 border border-gray-300 rounded-2xl p-3.5 text-sm text-gray-800"
                              placeholder="Nhập lý do hủy đơn...">Khách hàng yêu cầu hủy đơn</textarea>
                </div>
            </div>

            <div class="px-6 py-4 bg-gray-50 border-t border-gray-100 flex justify-end gap-2.5">
                <button type="button" onclick="closeCustomerCancelModal()" class="px-4 py-2.5 rounded-2xl bg-gray-200 hover:bg-gray-300 text-gray-800 text-xs font-extrabold">
                    Quay lại
                </button>
                <button type="submit" class="px-5 py-2.5 rounded-2xl bg-red-highland hover:bg-red-highland-dark text-white text-xs font-extrabold shadow-sm">
                    Xác nhận hủy đơn
                </button>
            </div>
        </form>
    </div>
</div>

@section Scripts {
    <script>
        @if (Model.Created || Model.VnPayReturnResult != null || Request.Query.ContainsKey("vnp_ResponseCode"))
        {
            <text>
            if (typeof clearUserCart === 'function') {
                clearUserCart();
            }
            localStorage.removeItem('lowland_cart');
            window.dispatchEvent(new Event('storage'));
            if (typeof updateCartBadge === 'function') {
                updateCartBadge();
            }
            </text>
        }

        function openCustomerCancelModal(orderId, orderCode) {
            document.getElementById('cancelOrderIdInput').value = orderId;
            document.getElementById('cancelOrderCodeLabel').textContent = '#' + orderCode;
            const modal = document.getElementById('cancelOrderModal');
            modal.classList.remove('hidden');
            modal.classList.add('flex');
        }

        function closeCustomerCancelModal() {
            const modal = document.getElementById('cancelOrderModal');
            modal.classList.add('hidden');
            modal.classList.remove('flex');
        }
    </script>
}
