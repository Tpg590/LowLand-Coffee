@page "/Order"
@model CoffeeShop.WebRazorPages.Pages.OrderModel
@{
    Layout = "_Layout";
    ViewData["Title"] = "Xác Nhận & Thanh Toán Đơn Hàng - LowLand Coffee";
}

<!-- Hero Header -->
<section class="relative bg-gradient-to-r from-red-highland-dark via-red-highland to-red-800 text-white py-10 px-4 sm:px-8 lg:px-12 shadow-inner">
    <div class="max-w-7xl mx-auto flex flex-col sm:flex-row items-start sm:items-center justify-between gap-4">
        <div class="space-y-1.5">
            <div class="inline-flex items-center gap-2 px-3.5 py-1 rounded-full bg-amber-300/20 border border-amber-300/40 text-amber-200 text-xs font-extrabold uppercase tracking-wider">
                <i class="fi fi-rr-shopping-bag"></i>
                <span>Thanh Toán Đơn Hàng</span>
            </div>
            <h1 class="text-2xl sm:text-3xl font-black tracking-tight">Xác Nhận &amp; Đặt Hàng</h1>
            <p class="text-white/85 text-sm">Hoàn tất thông tin giao nhận, áp dụng mã giảm giá và chọn hình thức thanh toán.</p>
        </div>

        <div class="flex items-center gap-3">
            <a href="/Index#menu" class="px-4 py-2.5 rounded-2xl bg-white/15 hover:bg-white/25 text-white border border-white/30 text-xs font-extrabold transition flex items-center gap-2">
                <i class="fi fi-rr-arrow-left"></i>
                <span>Chọn thêm món</span>
            </a>
            <a asp-page="/MyOrders" class="px-4 py-2.5 rounded-2xl bg-amber-300 hover:bg-amber-200 text-red-950 text-xs font-extrabold shadow-md transition flex items-center gap-2">
                <i class="fi fi-rr-receipt"></i>
                <span>Đơn hàng của tôi</span>
            </a>
        </div>
    </div>
</section>

<div class="max-w-7xl mx-auto px-4 sm:px-8 lg:px-12 py-8">
    @if (!string.IsNullOrWhiteSpace(Model.ErrorMessage))
    {
        <div class="mb-6 p-4 rounded-2xl bg-red-50 border border-red-200 text-red-800 flex items-center gap-3 shadow-sm">
            <span class="w-8 h-8 rounded-xl bg-red-600 text-white flex items-center justify-center shrink-0">
                <i class="fi fi-rr-exclamation"></i>
            </span>
            <span class="text-sm font-bold">@Model.ErrorMessage</span>
        </div>
    }

    <form method="post" asp-page-handler="PlaceOrder" id="checkoutRazorForm">
        <input type="hidden" asp-for="CheckoutInput.CartJson" id="cartJsonInput" />
        <input type="hidden" asp-for="CheckoutInput.DiscountAmount" id="discountAmountInput" />

        <div class="grid grid-cols-1 lg:grid-cols-12 gap-8 items-start">
            <!-- Cột Trái (7 cols): Thông tin người nhận & Phương thức thanh toán -->
            <div class="lg:col-span-7 space-y-6">
                <!-- Bước 1: Thông tin người nhận -->
                <div class="bg-white rounded-3xl border border-gray-200 p-6 sm:p-8 shadow-sm space-y-5">
                    <div class="flex items-center gap-3 pb-3 border-b border-gray-100">
                        <span class="w-9 h-9 rounded-2xl bg-red-50 text-red-highland flex items-center justify-center font-black">1</span>
                        <div>
                            <h2 class="text-lg font-black text-gray-900">Thông tin giao nhận</h2>
                            <p class="text-xs text-gray-500">Vui lòng cung cấp chính xác thông tin để LowLand phục vụ nhanh nhất</p>
                        </div>
                    </div>

                    <div class="grid grid-cols-1 sm:grid-cols-2 gap-4">
                        <div>
                            <label asp-for="CheckoutInput.FullName" class="block text-xs font-extrabold uppercase text-gray-600 mb-1.5">
                                Họ và tên người nhận <span class="text-red-500">*</span>
                            </label>
                            <input asp-for="CheckoutInput.FullName"
                                   required
                                   placeholder="Nguyễn Văn A"
                                   class="w-full bg-gray-50 border border-gray-300 rounded-2xl px-4 py-3 text-sm font-semibold text-gray-900 focus:ring-2 focus:ring-red-highland" />
                        </div>

                        <div>
                            <label asp-for="CheckoutInput.Phone" class="block text-xs font-extrabold uppercase text-gray-600 mb-1.5">
                                Số điện thoại liên hệ <span class="text-red-500">*</span>
                            </label>
                            <input asp-for="CheckoutInput.Phone"
                                   required
                                   placeholder="0901234567"
                                   class="w-full bg-gray-50 border border-gray-300 rounded-2xl px-4 py-3 text-sm font-semibold text-gray-900 focus:ring-2 focus:ring-red-highland" />
                        </div>
                    </div>

                    <div>
                        <label class="block text-xs font-extrabold uppercase text-gray-600 mb-2">Hình thức nhận đơn</label>
                        <div class="grid grid-cols-1 sm:grid-cols-2 gap-3">
                            <label class="flex items-center gap-3 p-3.5 rounded-2xl border border-gray-200 bg-gray-50 hover:border-red-highland cursor-pointer transition">
                                <input type="radio" asp-for="CheckoutInput.OrderType" id="typeDelivery" value="delivery" checked onchange="toggleDeliveryType()" class="text-red-highland focus:ring-red-highland" />
                                <div>
                                    <div class="text-sm font-extrabold text-gray-900 flex items-center gap-1.5">
                                        <i class="fi fi-rr-Biking text-red-highland"></i>
                                        <span>Giao hàng tận nơi</span>
                                    </div>
                                    <span class="text-xs text-gray-500">Giao nhanh trong 20 - 30 phút</span>
                                </div>
                            </label>

                            <label class="flex items-center gap-3 p-3.5 rounded-2xl border border-gray-200 bg-gray-50 hover:border-red-highland cursor-pointer transition">
                                <input type="radio" asp-for="CheckoutInput.OrderType" id="typePickup" value="pickup" onchange="toggleDeliveryType()" class="text-red-highland focus:ring-red-highland" />
                                <div>
                                    <div class="text-sm font-extrabold text-gray-900 flex items-center gap-1.5">
                                        <i class="fi fi-rr-shop text-amber-600"></i>
                                        <span>Đến lấy tại quán</span>
                                    </div>
                                    <span class="text-xs text-gray-500">Nhận đồ uống trực tiếp tại quầy</span>
                                </div>
                            </label>
                        </div>
                    </div>

                    <div id="deliveryAddressGroup">
                        <label asp-for="CheckoutInput.Address" class="block text-xs font-extrabold uppercase text-gray-600 mb-1.5">
                            Địa chỉ giao hàng chi tiết <span class="text-red-500">*</span>
                        </label>
                        <input asp-for="CheckoutInput.Address"
                               id="addressInput"
                               placeholder="Số nhà, tên đường, phường/xã, quận/huyện..."
                               class="w-full bg-gray-50 border border-gray-300 rounded-2xl px-4 py-3 text-sm font-semibold text-gray-900 focus:ring-2 focus:ring-red-highland" />
                    </div>

                    <div id="pickupStoreGroup" class="hidden">
                        <label asp-for="CheckoutInput.StoreName" class="block text-xs font-extrabold uppercase text-gray-600 mb-1.5">
                            Chọn chi nhánh LowLand Coffee
                        </label>
                        <select asp-for="CheckoutInput.StoreName"
                                class="w-full bg-gray-50 border border-gray-300 rounded-2xl px-4 py-3 text-sm font-semibold text-gray-900">
                            <option value="LowLand Nguyễn Huệ (Quận 1)">LowLand Nguyễn Huệ - 125 Nguyễn Huệ, Quận 1, TP.HCM</option>
                            <option value="LowLand Thảo Điền (TP. Thủ Đức)">LowLand Thảo Điền - 42 Xuân Thủy, Thảo Điền, TP. Thủ Đức</option>
                            <option value="LowLand Phú Mỹ Hưng (Quận 7)">LowLand Phú Mỹ Hưng - Crescent Mall, Quận 7, TP.HCM</option>
                        </select>
                    </div>

                    <div>
                        <label asp-for="CheckoutInput.Note" class="block text-xs font-extrabold uppercase text-gray-600 mb-1.5">
                            Ghi chú cho Barista / Tài xế
                        </label>
                        <textarea asp-for="CheckoutInput.Note"
                                  rows="2"
                                  placeholder="Ví dụ: Ít đá, giảm ngọt 50%, gọi điện khi tới sảnh..."
                                  class="w-full bg-gray-50 border border-gray-300 rounded-2xl p-3.5 text-sm font-semibold text-gray-900 focus:ring-2 focus:ring-red-highland"></textarea>
                    </div>
                </div>

                <!-- Bước 2: Phương thức thanh toán -->
                <div class="bg-white rounded-3xl border border-gray-200 p-6 sm:p-8 shadow-sm space-y-5">
                    <div class="flex items-center gap-3 pb-3 border-b border-gray-100">
                        <span class="w-9 h-9 rounded-2xl bg-red-50 text-red-highland flex items-center justify-center font-black">2</span>
                        <div>
                            <h2 class="text-lg font-black text-gray-900">Phương thức thanh toán</h2>
                            <p class="text-xs text-gray-500">Hỗ trợ thanh toán tiền mặt khi nhận hàng hoặc quét mã QR VNPay</p>
                        </div>
                    </div>

                    <div class="grid grid-cols-1 sm:grid-cols-2 gap-4">
                        <label class="flex items-start gap-3.5 p-4 rounded-2xl border-2 border-gray-200 hover:border-red-highland bg-gray-50/70 cursor-pointer transition">
                            <input type="radio" asp-for="CheckoutInput.PaymentMethod" value="CASH" checked class="mt-1 text-red-highland focus:ring-red-highland" />
                            <div>
                                <div class="text-sm font-black text-gray-900 flex items-center gap-2">
                                    <i class="fi fi-rr-money-bill-wave text-emerald-600"></i>
                                    <span>Tiền mặt (COD)</span>
                                </div>
                                <p class="text-xs text-gray-500 mt-1">Thanh toán trực tiếp bằng tiền mặt khi nhận đồ uống.</p>
                            </div>
                        </label>

                        <label class="flex items-start gap-3.5 p-4 rounded-2xl border-2 border-gray-200 hover:border-blue-600 bg-gray-50/70 cursor-pointer transition">
                            <input type="radio" asp-for="CheckoutInput.PaymentMethod" value="VNPAY" class="mt-1 text-blue-600 focus:ring-blue-600" />
                            <div>
                                <div class="text-sm font-black text-gray-900 flex items-center gap-2">
                                    <i class="fi fi-rr-credit-card text-blue-600"></i>
                                    <span>Thanh toán VNPay</span>
                                </div>
                                <p class="text-xs text-gray-500 mt-1">Chuyển hướng trực tiếp sang trang cổng thanh toán VNPay Sandbox.</p>
                            </div>
                        </label>
                    </div>
                </div>
            </div>

            <!-- Cột Phải (5 cols): Giỏ hàng, Voucher & Tổng tiền -->
            <div class="lg:col-span-5">
                <div class="bg-white rounded-3xl border border-gray-200 p-6 sm:p-8 shadow-sm space-y-5 sticky top-28">
                    <div class="flex items-center justify-between pb-3 border-b border-gray-100">
                        <h2 class="text-lg font-black text-gray-900 flex items-center gap-2">
                            <i class="fi fi-rr-mug-hot-alt text-red-highland"></i>
                            <span>Giỏ hàng của bạn</span>
                        </h2>
                        <button type="button" onclick="clearCheckoutCart()" class="text-xs font-extrabold text-red-600 hover:underline flex items-center gap-1">
                            <i class="fi fi-rr-trash"></i>
                            <span>Xóa giỏ</span>
                        </button>
                    </div>

                    <div id="checkoutItemsContainer" class="divide-y divide-gray-100 max-h-80 overflow-y-auto pr-1">
                        <!-- Các món trong giỏ hàng -->
                    </div>

                    <!-- Mã khuyến mãi (Voucher) -->
                    <div class="pt-3 border-t border-gray-100 space-y-2.5">
                        <div class="flex items-center justify-between">
                            <label class="block text-xs font-extrabold uppercase text-gray-600 flex items-center gap-1.5">
                                <i class="fi fi-rr-ticket text-red-highland"></i>
                                <span>Mã khuyến mãi (Voucher)</span>
                            </label>
                            <a href="/Customer/Vouchers" class="text-[11px] font-bold text-red-highland hover:underline">Xem kho Voucher</a>
                        </div>
                        <div class="flex gap-2">
                            <input asp-for="CheckoutInput.VoucherCode"
                                   id="voucherCodeInput"
                                   placeholder="Nhập mã voucher (VD: WELCOME50)..."
                                   class="flex-1 bg-gray-50 border border-gray-300 rounded-2xl px-4 py-2.5 text-sm font-bold text-gray-900 uppercase" />
                            <button type="button"
                                    onclick="applyVoucherViaPageHandler()"
                                    class="px-5 py-2.5 rounded-2xl bg-gray-900 hover:bg-black text-white text-xs font-extrabold transition">
                                Áp dụng
                            </button>
                        </div>
                        <div id="voucherFeedback" class="text-xs"></div>

                        @if (Model.AvailableVouchers.Count > 0)
                        {
                            <div class="space-y-1.5 pt-1">
                                <div class="text-[11px] font-bold text-gray-500">Voucher khả dụng cho tài khoản của bạn:</div>
                                <div class="grid grid-cols-1 gap-1.5 max-h-40 overflow-y-auto pr-1" id="customerVoucherSuggestions">
                                    @foreach (var v in Model.AvailableVouchers)
                                    {
                                        var discountText = v.DiscountType == "PERCENTAGE"
                                            ? $"Giảm {v.DiscountValue:N0}%" + (v.MaxDiscountAmount.HasValue ? $" (tối đa {v.MaxDiscountAmount.Value:N0}đ)" : "")
                                            : $"Giảm {v.DiscountValue:N0}đ";
                                        <button type="button"
                                                data-min-order="@v.MinOrderValue"
                                                data-voucher-code="@v.Code"
                                                onclick="selectSuggestedVoucher('@v.Code')"
                                                class="customer-voucher-btn w-full text-left px-3 py-2 rounded-2xl bg-amber-50/70 hover:bg-amber-100/80 border border-amber-300 transition flex items-center justify-between gap-2">
                                            <div class="min-w-0">
                                                <div class="text-xs font-black text-amber-950 flex items-center gap-1.5">
                                                    <i class="fi fi-rr-ticket text-amber-600"></i>
                                                    <span>@v.Code</span>
                                                    <span class="px-2 py-0.5 rounded-lg bg-red-highland text-white text-[10px] font-extrabold">@discountText</span>
                                                </div>
                                                <div class="text-[11px] text-gray-600 truncate mt-0.5">
                                                    Đơn tối thiểu: <strong>@v.MinOrderValue.ToString("N0")đ</strong>
                                                </div>
                                            </div>
                                            <span class="voucher-eligibility-badge shrink-0 px-2.5 py-1 rounded-xl bg-amber-200/80 text-amber-950 text-[10px] font-extrabold">
                                                Dùng ngay
                                            </span>
                                        </button>
                                    }
                                </div>
                            </div>
                        }
                    </div>

                    <!-- Điểm thưởng thành viên & Đặc quyền Hạng thẻ (Loyalty Tier & Points) -->
                    @{
                        var availPoints = Model.MemberProfile?.CurrentPoints ?? 0;
                        var tierName = Model.MemberProfile?.TierName ?? "Hạng Đồng";
                        var multiplier = Model.MemberProfile?.PointMultiplier ?? 1.0m;
                        var tierDiscountPct = Model.MemberProfile?.DiscountPercent ?? 0m;
                    }
                    <div class="pt-3 border-t border-gray-100 space-y-2.5">
                        <div class="flex items-center justify-between">
                            <label class="block text-xs font-extrabold uppercase text-gray-600 flex items-center gap-1.5">
                                <i class="fi fi-sr-medal text-amber-500"></i>
                                <span>Hạng thẻ &amp; Điểm thưởng</span>
                            </label>
                            <span class="px-2.5 py-0.5 rounded-full bg-amber-100 text-amber-900 border border-amber-300 text-[11px] font-extrabold">
                                @tierName • <strong>@availPoints</strong> điểm khả dụng
                            </span>
                        </div>

                        <div class="p-3.5 rounded-2xl bg-gradient-to-r from-amber-50 to-orange-50 border border-amber-200/80 space-y-2">
                            <div class="flex flex-wrap items-center justify-between gap-1 text-xs text-blue-900 bg-blue-50/90 border border-blue-200 rounded-xl px-3 py-1.5 font-bold">
                                <span>🎁 Đặc quyền @tierName: Giảm <strong>@(tierDiscountPct.ToString("0.##"))%</strong> hóa đơn</span>
                                <span>⚡ Tích điểm: <strong>x@(multiplier.ToString("0.##"))</strong></span>
                            </div>
                            <div class="flex items-center justify-between text-xs text-amber-950">
                                <span>Quy đổi: <strong>1 điểm = 1.000 đ</strong> (Tối đa: @((availPoints * 1000).ToString("N0")) đ)</span>
                            </div>
                            <div class="flex gap-2">
                                <input asp-for="CheckoutInput.PointsToRedeem"
                                       type="number"
                                       id="pointsToRedeemInput"
                                       min="0"
                                       max="@availPoints"
                                       step="1"
                                       oninput="onCustomerPointsChange()"
                                       placeholder="Nhập số điểm muốn dùng..."
                                       class="flex-1 bg-white border border-amber-300 rounded-xl px-3.5 py-2 text-sm font-black text-gray-900 focus:ring-2 focus:ring-amber-500" />
                                <button type="button"
                                        onclick="applyMaxCustomerPoints()"
                                        @(availPoints <= 0 ? "disabled" : "")
                                        class="px-3.5 py-2 rounded-xl bg-amber-500 hover:bg-amber-600 disabled:bg-gray-300 text-white text-xs font-extrabold transition">
                                    Dùng tối đa
                                </button>
                            </div>
                            <div id="pointsFeedback" class="text-[11px] text-amber-800 font-semibold">
                                @if (availPoints > 0)
                                {
                                    <span>Bạn có <strong>@availPoints điểm</strong> có thể dùng để trừ trực tiếp vào hóa đơn.</span>
                                }
                                else
                                {
                                    <span>Bạn hiện có 0 điểm. Hoàn thành đơn hàng này để được cộng điểm thưởng tự động!</span>
                                }
                            </div>
                        </div>
                    </div>

                    <!-- Bảng tổng kết tiền -->
                    <div class="p-4 rounded-2xl bg-amber-50/70 border border-amber-200 space-y-2 text-sm">
                        <div class="flex justify-between text-gray-600">
                            <span>Tạm tính:</span>
                            <span id="subtotalDisplay" class="font-bold text-gray-900">0 đ</span>
                        </div>
                        <div class="flex justify-between text-blue-700">
                            <span>Đặc quyền @tierName (-@tierDiscountPct.ToString("0.##")%):</span>
                            <span id="tierDiscountDisplay" class="font-bold">-0 đ</span>
                        </div>
                        <div class="flex justify-between text-emerald-700">
                            <span>Giảm giá Voucher:</span>
                            <span id="discountDisplay" class="font-bold">-0 đ</span>
                        </div>
                        <div class="flex justify-between text-amber-700">
                            <span>Giảm điểm thưởng:</span>
                            <span id="pointsDiscountDisplay" class="font-bold">-0 đ</span>
                        </div>
                        <div class="flex justify-between pt-2 border-t border-amber-200 text-base font-black text-red-highland">
                            <span>Tổng thanh toán:</span>
                            <span id="finalTotalDisplay" class="text-xl">0 đ</span>
                        </div>
                        <div class="flex justify-between pt-1 text-xs font-bold text-amber-800">
                            <span>Điểm thưởng tích lũy khi hoàn thành:</span>
                            <span id="estimatedPointsEarnDisplay">+0 điểm</span>
                        </div>
                    </div>

                    <button type="submit"
                            id="btnPlaceOrder"
                            class="w-full py-4 px-6 rounded-2xl bg-red-highland hover:bg-red-highland-dark disabled:bg-gray-300 text-white font-black text-sm shadow-lg transition flex items-center justify-center gap-2">
                        <i class="fi fi-rr-check-circle text-base"></i>
                        <span>Xác Nhận Đặt Hàng</span>
                    </button>
                </div>
            </div>
        </div>
    </form>
</div>

@section Scripts {
    <script>
        let currentCart = [];
        let currentVoucherDiscount = parseFloat(document.getElementById('discountAmountInput').value || '0') || 0;
        const memberMaxPoints = @(Model.MemberProfile?.CurrentPoints ?? 0);
        const memberMultiplier = @((Model.MemberProfile?.PointMultiplier ?? 1.0m).ToString(System.Globalization.CultureInfo.InvariantCulture));
        const memberTierDiscountPercent = @((Model.MemberProfile?.DiscountPercent ?? 0m).ToString(System.Globalization.CultureInfo.InvariantCulture));

        document.addEventListener('DOMContentLoaded', () => {
            loadCartFromStorage();
            toggleDeliveryType();
            const prefilledVoucher = (document.getElementById('voucherCodeInput')?.value || '').trim();
            if (prefilledVoucher && currentCart.length > 0) {
                applyVoucherViaPageHandler();
            }

            const form = document.getElementById('checkoutRazorForm');
            if (form) {
                form.addEventListener('submit', () => {
                    document.getElementById('cartJsonInput').value = JSON.stringify(currentCart);
                    setTimeout(() => {
                        if (typeof clearUserCart === 'function') {
                            clearUserCart();
                        }
                        localStorage.removeItem('lowland_cart');
                    }, 150);
                });
            }
        });

        function toggleDeliveryType() {
            const isPickup = document.getElementById('typePickup').checked;
            document.getElementById('deliveryAddressGroup').classList.toggle('hidden', isPickup);
            document.getElementById('pickupStoreGroup').classList.toggle('hidden', !isPickup);
        }

        function loadCartFromStorage() {
            try {
                if (typeof getCart === 'function') {
                    currentCart = getCart() || [];
                } else {
                    currentCart = JSON.parse(localStorage.getItem('lowland_cart') || '[]');
                }
            } catch {
                currentCart = [];
            }
            syncAndRenderCart();
        }

        function syncAndRenderCart() {
            document.getElementById('cartJsonInput').value = JSON.stringify(currentCart);
            const container = document.getElementById('checkoutItemsContainer');
            const submitBtn = document.getElementById('btnPlaceOrder');

            if (!currentCart || currentCart.length === 0) {
                container.innerHTML = `
                    <div class="py-8 text-center space-y-3">
                        <div class="w-12 h-12 rounded-full bg-gray-100 text-gray-400 flex items-center justify-center text-xl mx-auto">
                            <i class="fi fi-rr-shopping-cart"></i>
                        </div>
                        <p class="text-sm font-bold text-gray-500">Giỏ hàng của bạn đang trống.</p>
                        <a href="/Index#menu" class="inline-block px-4 py-2 rounded-xl bg-red-highland text-white text-xs font-extrabold">Chọn món ngay</a>
                    </div>`;
                submitBtn.disabled = true;
                updateTotals(0);
                return;
            }

            submitBtn.disabled = false;
            let subtotal = 0;
            let html = '';

            currentCart.forEach((item, index) => {
                const qty = parseInt(item.quantity || 1);
                const price = parseFloat(item.price || 0);
                const lineTotal = qty * price;
                subtotal += lineTotal;
                const rawSize = (item.size || 'M').toString().trim();
                const displaySize = rawSize.toLowerCase().startsWith('size') ? rawSize : `Size ${rawSize}`;

                html += `
                    <div class="py-3 flex items-center justify-between gap-3">
                        <div class="min-w-0 flex-1">
                            <div class="text-sm font-extrabold text-gray-900 truncate">${item.name}</div>
                            <div class="text-xs text-gray-500">${displaySize} • ${price.toLocaleString('vi-VN')} đ</div>
                        </div>
                        <div class="flex items-center gap-2">
                            <div class="inline-flex items-center rounded-xl border border-gray-200 bg-gray-50">
                                <button type="button" onclick="changeCartItemQty(${index}, -1)" class="px-2.5 py-1 text-xs font-black text-gray-700 hover:bg-gray-200 rounded-l-xl">-</button>
                                <span class="px-2.5 py-1 text-xs font-black text-gray-900">${qty}</span>
                                <button type="button" onclick="changeCartItemQty(${index}, 1)" class="px-2.5 py-1 text-xs font-black text-gray-700 hover:bg-gray-200 rounded-r-xl">+</button>
                            </div>
                            <div class="text-sm font-extrabold text-gray-900 text-right min-w-[80px]">${lineTotal.toLocaleString('vi-VN')} đ</div>
                        </div>
                    </div>`;
            });

            container.innerHTML = html;
            updateTotals(subtotal);
        }

        function changeCartItemQty(index, delta) {
            if (!currentCart[index]) return;
            currentCart[index].quantity = (parseInt(currentCart[index].quantity || 1)) + delta;
            if (currentCart[index].quantity <= 0) {
                currentCart.splice(index, 1);
            }
            if (typeof saveCart === 'function') {
                saveCart(currentCart);
            } else {
                localStorage.setItem('lowland_cart', JSON.stringify(currentCart));
            }
            window.dispatchEvent(new Event('storage'));
            syncAndRenderCart();
        }

        function clearCheckoutCart() {
            currentCart = [];
            currentVoucherDiscount = 0;
            document.getElementById('discountAmountInput').value = '0';
            const ptsInput = document.getElementById('pointsToRedeemInput');
            if (ptsInput) ptsInput.value = '0';
            if (typeof clearUserCart === 'function') {
                clearUserCart();
            } else {
                localStorage.removeItem('lowland_cart');
            }
            window.dispatchEvent(new Event('storage'));
            syncAndRenderCart();
        }

        function updateVoucherEligibilityBadges(subtotal) {
            document.querySelectorAll('.customer-voucher-btn').forEach(btn => {
                const minOrder = parseFloat(btn.getAttribute('data-min-order') || '0');
                const badge = btn.querySelector('.voucher-eligibility-badge');
                if (subtotal >= minOrder) {
                    btn.classList.remove('opacity-60');
                    if (badge) {
                        badge.textContent = 'Đủ điều kiện';
                        badge.className = 'voucher-eligibility-badge shrink-0 px-2.5 py-1 rounded-xl bg-emerald-100 text-emerald-800 text-[10px] font-extrabold';
                    }
                } else {
                    btn.classList.add('opacity-60');
                    if (badge) {
                        badge.textContent = 'Chưa đủ ĐK';
                        badge.className = 'voucher-eligibility-badge shrink-0 px-2.5 py-1 rounded-xl bg-gray-200 text-gray-600 text-[10px] font-extrabold';
                    }
                }
            });
        }

        function onCustomerPointsChange() {
            const subtotal = currentCart.reduce((s, i) => s + (parseFloat(i.price || 0) * parseInt(i.quantity || 1)), 0);
            updateTotals(subtotal);
        }

        function applyMaxCustomerPoints() {
            const subtotal = currentCart.reduce((s, i) => s + (parseFloat(i.price || 0) * parseInt(i.quantity || 1)), 0);
            const tierDiscount = Math.round(subtotal * (memberTierDiscountPercent / 100));
            const remaining = Math.max(0, subtotal - tierDiscount - currentVoucherDiscount);
            const maxForOrder = Math.floor(remaining / 1000);
            const pointsToUse = Math.min(memberMaxPoints, maxForOrder);
            const ptsInput = document.getElementById('pointsToRedeemInput');
            if (ptsInput) {
                ptsInput.value = pointsToUse;
            }
            updateTotals(subtotal);
        }

        function updateTotals(subtotal) {
            updateVoucherEligibilityBadges(subtotal);

            const tierDiscount = Math.round(subtotal * (memberTierDiscountPercent / 100));
            const remainingAfterTier = Math.max(0, subtotal - tierDiscount);

            if (currentVoucherDiscount > remainingAfterTier) {
                currentVoucherDiscount = remainingAfterTier;
            }

            const ptsInput = document.getElementById('pointsToRedeemInput');
            let requestedPoints = parseInt(ptsInput?.value || '0') || 0;
            if (requestedPoints < 0) requestedPoints = 0;
            if (requestedPoints > memberMaxPoints) requestedPoints = memberMaxPoints;

            const remainingAfterVoucher = Math.max(0, remainingAfterTier - currentVoucherDiscount);
            const maxPointsForOrder = Math.floor(remainingAfterVoucher / 1000);
            if (requestedPoints > maxPointsForOrder) {
                requestedPoints = maxPointsForOrder;
            }
            if (ptsInput && parseInt(ptsInput.value || '0') !== requestedPoints) {
                ptsInput.value = requestedPoints;
            }

            const pointsDiscount = requestedPoints * 1000;
            const totalDiscount = Math.min(subtotal, tierDiscount + currentVoucherDiscount + pointsDiscount);
            const finalTotal = Math.max(0, subtotal - totalDiscount);

            document.getElementById('subtotalDisplay').textContent = subtotal.toLocaleString('vi-VN') + ' đ';
            const tierDisplay = document.getElementById('tierDiscountDisplay');
            if (tierDisplay) {
                tierDisplay.textContent = '-' + tierDiscount.toLocaleString('vi-VN') + ' đ';
            }
            document.getElementById('discountDisplay').textContent = '-' + currentVoucherDiscount.toLocaleString('vi-VN') + ' đ';
            const ptsDisplay = document.getElementById('pointsDiscountDisplay');
            if (ptsDisplay) {
                ptsDisplay.textContent = '-' + pointsDiscount.toLocaleString('vi-VN') + ' đ (' + requestedPoints + ' điểm)';
            }
            document.getElementById('finalTotalDisplay').textContent = finalTotal.toLocaleString('vi-VN') + ' đ';
            document.getElementById('discountAmountInput').value = totalDiscount;

            const estPoints = subtotal > 0 ? Math.max(1, Math.round((finalTotal / 10000) * memberMultiplier)) : 0;
            const estEl = document.getElementById('estimatedPointsEarnDisplay');
            if (estEl) {
                estEl.textContent = '+' + estPoints.toLocaleString('vi-VN') + ' điểm';
            }
        }

        function selectSuggestedVoucher(code) {
            document.getElementById('voucherCodeInput').value = code;
            applyVoucherViaPageHandler();
        }

        async function applyVoucherViaPageHandler() {
            const code = (document.getElementById('voucherCodeInput').value || '').trim();
            const feedback = document.getElementById('voucherFeedback');
            const subtotal = currentCart.reduce((s, i) => s + (parseFloat(i.price || 0) * parseInt(i.quantity || 1)), 0);

            if (!code) {
                currentVoucherDiscount = 0;
                feedback.innerHTML = '<span class="text-red-600 font-bold">Vui lòng nhập mã giảm giá.</span>';
                updateTotals(subtotal);
                return;
            }

            try {
                const res = await fetch(`/Order?handler=ValidateVoucher&code=${encodeURIComponent(code)}&orderAmount=${subtotal}`);
                const data = await res.json();
                if (data.isSuccess) {
                    currentVoucherDiscount = parseFloat(data.discountAmount || 0);
                    feedback.innerHTML = `<span class="text-emerald-700 font-bold">✓ ${data.message}</span>`;
                } else {
                    currentVoucherDiscount = 0;
                    feedback.innerHTML = `<span class="text-red-600 font-bold">✕ ${data.message}</span>`;
                }
                updateTotals(subtotal);
            } catch {
                feedback.innerHTML = '<span class="text-red-600 font-bold">Không thể kiểm tra mã giảm giá lúc này.</span>';
            }
        }
    </script>
}
