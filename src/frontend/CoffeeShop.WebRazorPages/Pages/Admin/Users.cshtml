@page
@model CoffeeShop.WebRazorPages.Pages.Admin.UsersModel
@{
    Layout = "_AdminLayout";
    ViewData["Title"] = "Quản lý Người dùng & Nhân viên - Quản trị viên";
}

<div class="w-full space-y-6">
    <!-- Top Bar Header & Action Button -->
    <div class="flex flex-col sm:flex-row sm:items-center justify-between pb-6 border-b border-gray-200 gap-4">
        <div>
            <div class="flex items-center gap-3.5">
                <span class="p-3 rounded-2xl bg-red-100 text-red-highland shadow-sm flex items-center justify-center">
                    <i class="fi fi-rr-users-alt text-2xl"></i>
                </span>
                <div>
                    <h1 class="text-2xl sm:text-3xl font-black text-gray-900 tracking-tight">Quản lý Tài khoản & Nhân viên</h1>
                    <p class="text-sm text-gray-500 mt-0.5">Danh sách người dùng, cấp tài khoản cho nhân viên thu ngân, khóa và mở khóa tài khoản</p>
                </div>
            </div>
        </div>

        <div class="flex items-center gap-3">
            <button type="button" onclick="openCreateStaffModal()" class="px-5 py-3 rounded-2xl bg-red-highland hover:bg-red-700 text-white font-extrabold text-sm uppercase tracking-wider shadow-md transition flex items-center gap-2 active:scale-95">
                <i class="fi fi-rr-user-add text-lg"></i>
                <span>Cấp tài khoản Nhân viên</span>
            </button>
        </div>
    </div>

    <!-- Alert Messages -->
    @if (!string.IsNullOrEmpty(Model.SuccessMessage))
    {
        <div class="p-4 rounded-2xl bg-emerald-50 border border-emerald-200 text-emerald-800 text-sm flex items-start gap-3">
            <i class="fi fi-rr-check-circle text-emerald-600 text-lg mt-0.5 flex-shrink-0"></i>
            <div class="flex-1 font-semibold">@Model.SuccessMessage</div>
        </div>
    }

    @if (!string.IsNullOrEmpty(Model.ErrorMessage))
    {
        <div class="p-4 rounded-2xl bg-red-50 border border-red-200 text-red-700 text-sm flex items-start gap-3">
            <i class="fi fi-rr-cross-circle text-red-600 text-lg mt-0.5 flex-shrink-0"></i>
            <div class="flex-1 font-semibold">@Model.ErrorMessage</div>
        </div>
    }

    <!-- Search & Filter Controls (Server-Side GET Form) -->
    <form method="get" class="bg-white p-4 sm:p-5 rounded-2xl border border-gray-200 shadow-sm flex flex-col sm:flex-row gap-4 items-center justify-between">
        <div class="w-full sm:w-96 relative">
            <input type="text" name="Search" value="@Model.Search" placeholder="Tìm theo tên, email, số điện thoại..." class="w-full bg-gray-50 border border-gray-300 rounded-xl pl-11 pr-4 py-3 text-sm font-semibold text-gray-900 focus:ring-2 focus:ring-red-highland placeholder-gray-400" />
            <span class="absolute left-3.5 top-3.5 text-gray-400 flex items-center">
                <i class="fi fi-rr-search text-base"></i>
            </span>
        </div>

        <div class="flex items-center gap-3 w-full sm:w-auto">
            <select name="RoleName" onchange="this.form.submit()" class="bg-gray-50 border border-gray-300 rounded-xl px-4 py-3 text-sm font-bold text-gray-800 focus:ring-2 focus:ring-red-highland">
                <option value="ALL" selected="@(string.IsNullOrEmpty(Model.RoleName) || Model.RoleName == "ALL")">Tất cả vai trò</option>
                <option value="Admin" selected="@(Model.RoleName == "Admin")">Admin (Quản trị viên)</option>
                <option value="Staff" selected="@(Model.RoleName == "Staff")">Nhân viên</option>
                <option value="Customer" selected="@(Model.RoleName == "Customer")">Khách hàng thành viên</option>
            </select>

            <select name="IsActive" onchange="this.form.submit()" class="bg-gray-50 border border-gray-300 rounded-xl px-4 py-3 text-sm font-bold text-gray-800 focus:ring-2 focus:ring-red-highland">
                <option value="" selected="@(!Model.IsActive.HasValue)">Tất cả trạng thái</option>
                <option value="true" selected="@(Model.IsActive == true)">Đang hoạt động</option>
                <option value="false" selected="@(Model.IsActive == false)">Đã khóa</option>
            </select>

            <button type="submit" class="px-5 py-3 rounded-xl bg-gray-900 hover:bg-black text-white font-bold text-sm transition">
                Lọc
            </button>
            @if (!string.IsNullOrEmpty(Model.Search) || (!string.IsNullOrEmpty(Model.RoleName) && Model.RoleName != "ALL") || Model.IsActive.HasValue)
            {
                <a asp-page="/Admin/Users" class="px-4 py-3 rounded-xl bg-gray-100 hover:bg-gray-200 text-gray-700 font-bold text-sm transition">
                    Đặt lại
                </a>
            }
        </div>
    </form>

    <!-- Users Table (Server-side Rendered) -->
    <div class="bg-white rounded-3xl border border-gray-200 shadow-xl overflow-hidden">
        <div class="overflow-x-auto">
            <table class="w-full text-left text-sm text-gray-700">
                <thead class="bg-gray-100 text-gray-800 uppercase font-black tracking-wider text-xs border-b border-gray-200">
                    <tr>
                        <th class="py-4 px-6">Họ và tên</th>
                        <th class="py-4 px-6">Email / Số điện thoại</th>
                        <th class="py-4 px-6">Địa chỉ</th>
                        <th class="py-4 px-6">Vai trò</th>
                        <th class="py-4 px-6">Trạng thái</th>
                        <th class="py-4 px-6">Ngày tham gia</th>
                        <th class="py-4 px-6 text-right">Thao tác</th>
                    </tr>
                </thead>
                <tbody class="divide-y divide-gray-200 font-medium">
                    @if (!Model.Users.Items.Any())
                    {
                        <tr>
                            <td colspan="7" class="text-center py-10 text-gray-400 font-medium text-sm">
                                Không tìm thấy người dùng phù hợp.
                            </td>
                        </tr>
                    }
                    else
                    {
                        @foreach (var user in Model.Users.Items)
                        {
                            var role = !string.IsNullOrEmpty(user.RoleName) ? user.RoleName : (user.Role ?? "Customer");
                            <tr class="hover:bg-gray-50 transition">
                                <td class="py-4 px-6 font-bold text-gray-900 text-sm">
                                    <div class="flex items-center gap-3">
                                        @if (!string.IsNullOrEmpty(user.AvatarUrl))
                                        {
                                            <img src="@user.AvatarUrl" alt="@user.FullName" class="w-9 h-9 rounded-full object-cover border" />
                                        }
                                        else
                                        {
                                            <div class="w-9 h-9 rounded-full bg-red-50 text-red-highland font-black flex items-center justify-center text-sm border border-red-200">
                                                @(!string.IsNullOrEmpty(user.FullName) ? user.FullName.Substring(0, 1).ToUpper() : "U")
                                            </div>
                                        }
                                        <span>@user.FullName</span>
                                    </div>
                                </td>
                                <td class="py-4 px-6">
                                    <div class="text-sm font-semibold text-gray-900">@user.Email</div>
                                    <div class="text-xs text-gray-500 font-medium">@(user.PhoneNumber ?? "---")</div>
                                </td>
                                <td class="py-4 px-6 text-sm text-gray-600 max-w-xs truncate">
                                    @(user.Address ?? "Chưa cập nhật")
                                </td>
                                <td class="py-4 px-6">
                                    @if (string.Equals(role, "Admin", StringComparison.OrdinalIgnoreCase))
                                    {
                                        <span class="px-3 py-1 rounded-full text-xs font-black uppercase tracking-wider bg-amber-100 text-amber-900 border border-amber-200">Admin</span>
                                    }
                                    else if (string.Equals(role, "Staff", StringComparison.OrdinalIgnoreCase))
                                    {
                                        <span class="px-3 py-1 rounded-full text-xs font-black uppercase tracking-wider bg-blue-100 text-blue-900 border border-blue-200">Nhân viên</span>
                                    }
                                    else
                                    {
                                        <span class="px-3 py-1 rounded-full text-xs font-black uppercase tracking-wider bg-emerald-100 text-emerald-900 border border-emerald-200">Khách hàng</span>
                                    }
                                </td>
                                <td class="py-4 px-6">
                                    @if (user.IsActive)
                                    {
                                        <span class="inline-flex items-center gap-1.5 px-3 py-1 rounded-full text-xs font-bold bg-emerald-50 text-emerald-700 border border-emerald-200">
                                            <span class="w-2 h-2 rounded-full bg-emerald-500"></span>Hoạt động
                                        </span>
                                    }
                                    else
                                    {
                                        <span class="inline-flex items-center gap-1.5 px-3 py-1 rounded-full text-xs font-bold bg-rose-50 text-rose-700 border border-rose-200">
                                            <span class="w-2 h-2 rounded-full bg-rose-500"></span>Đã khóa
                                        </span>
                                    }
                                </td>
                                <td class="py-4 px-6 text-xs text-gray-500 font-medium">
                                    @(user.CreatedAt.HasValue ? user.CreatedAt.Value.ToString("dd/MM/yyyy") : "---")
                                </td>
                                <td class="py-4 px-6 text-right">
                                    <div class="flex items-center justify-end gap-1.5">
                                        <!-- Chỉnh sửa -->
                                        <button type="button"
                                                onclick="openEditUserModal('@user.Id', '@Html.Raw(Html.Encode(user.FullName))', '@user.Email', '@user.PhoneNumber', '@Html.Raw(Html.Encode(user.Address ?? ""))')"
                                                class="p-2 rounded-xl text-gray-600 hover:text-blue-600 hover:bg-blue-50 transition" title="Chỉnh sửa thông tin">
                                            <i class="fi fi-rr-edit text-base"></i>
                                        </button>

                                        <!-- Khóa / Mở khóa (Server-side POST) -->
                                        @if (!string.Equals(role, "Admin", StringComparison.OrdinalIgnoreCase))
                                        {
                                            <form method="post" asp-page-handler="ToggleStatus" class="inline">
                                                @Html.AntiForgeryToken()
                                                <input type="hidden" name="id" value="@user.Id" />
                                                <input type="hidden" name="isActive" value="@((!user.IsActive).ToString().ToLower())" />
                                                <button type="submit"
                                                        class="p-2 rounded-xl @(user.IsActive ? "text-gray-600 hover:text-amber-600 hover:bg-amber-50" : "text-emerald-600 hover:bg-emerald-50") transition"
                                                        title="@(user.IsActive ? "Khóa tài khoản" : "Mở khóa tài khoản")">
                                                    <i class="fi @(user.IsActive ? "fi-rr-lock" : "fi-rr-unlock") text-base"></i>
                                                </button>
                                            </form>

                                            <!-- Xóa -->
                                            <button type="button"
                                                    onclick="openDeleteModal('@user.Id', '@Html.Raw(Html.Encode(user.FullName))', '@user.Email')"
                                                    class="p-2 rounded-xl text-gray-400 hover:text-red-highland hover:bg-red-50 transition" title="Xóa tài khoản">
                                                <i class="fi fi-rr-trash text-base"></i>
                                            </button>
                                        }
                                    </div>
                                </td>
                            </tr>
                        }
                    }
                </tbody>
            </table>
        </div>

        <!-- Table Footer Pagination -->
        <div class="p-4 sm:p-6 border-t border-gray-200 flex flex-col sm:flex-row items-center justify-between text-sm text-gray-600 gap-3">
            <span class="font-semibold">
                Hiển thị @Model.Users.Items.Count() trên tổng @Model.Users.TotalItems người dùng
            </span>
            @if (Model.Users.TotalPages > 1)
            {
                <div class="flex items-center gap-2">
                    @if (Model.PageNumber > 1)
                    {
                        <a asp-page="/Admin/Users"
                           asp-route-pageNumber="@(Model.PageNumber - 1)"
                           asp-route-search="@Model.Search"
                           asp-route-roleName="@Model.RoleName"
                           asp-route-isActive="@Model.IsActive"
                           class="px-4 py-2 rounded-xl border border-gray-300 bg-white hover:bg-gray-50 font-bold">
                            Trang trước
                        </a>
                    }
                    else
                    {
                        <button type="button" class="px-4 py-2 rounded-xl border border-gray-300 bg-white font-bold opacity-50 cursor-not-allowed" disabled>
                            Trang trước
                        </button>
                    }

                    @for (int p = 1; p <= Model.Users.TotalPages; p++)
                    {
                        if (p == Model.PageNumber)
                        {
                            <span class="px-4 py-2 rounded-xl bg-red-highland text-white font-bold">@p</span>
                        }
                        else
                        {
                            <a asp-page="/Admin/Users"
                               asp-route-pageNumber="@p"
                               asp-route-search="@Model.Search"
                               asp-route-roleName="@Model.RoleName"
                               asp-route-isActive="@Model.IsActive"
                               class="px-4 py-2 rounded-xl border border-gray-300 bg-white hover:bg-gray-50 font-bold">
                                @p
                            </a>
                        }
                    }

                    @if (Model.PageNumber < Model.Users.TotalPages)
                    {
                        <a asp-page="/Admin/Users"
                           asp-route-pageNumber="@(Model.PageNumber + 1)"
                           asp-route-search="@Model.Search"
                           asp-route-roleName="@Model.RoleName"
                           asp-route-isActive="@Model.IsActive"
                           class="px-4 py-2 rounded-xl border border-gray-300 bg-white hover:bg-gray-50 font-bold">
                            Trang sau
                        </a>
                    }
                    else
                    {
                        <button type="button" class="px-4 py-2 rounded-xl border border-gray-300 bg-white font-bold opacity-50 cursor-not-allowed" disabled>
                            Trang sau
                        </button>
                    }
                </div>
            }
        </div>
    </div>
</div>

<!-- ========================================================================= -->
<!-- Modal 1: Cấp tài khoản Staff mới (Create Staff Account - Server POST) -->
<!-- ========================================================================= -->
<div id="modal-create-staff" class="fixed inset-0 z-50 bg-black/60 backdrop-blur-sm hidden items-center justify-center p-4">
    <div class="bg-white rounded-3xl max-w-lg w-full p-6 sm:p-8 shadow-2xl space-y-6">
        <div class="flex items-center justify-between pb-4 border-b border-gray-100">
            <div class="flex items-center gap-3">
                <div class="w-12 h-12 rounded-2xl bg-red-50 text-red-highland flex items-center justify-center shadow-sm">
                    <i class="fi fi-rr-user-add text-2xl"></i>
                </div>
                <div>
                    <h3 class="text-xl font-black text-gray-900">Cấp tài khoản Nhân viên</h3>
                    <p class="text-xs text-gray-500 font-medium">Tạo tài khoản thu ngân bán hàng hoặc quầy pha chế</p>
                </div>
            </div>
            <button type="button" onclick="closeCreateStaffModal()" class="text-gray-400 hover:text-gray-600 text-lg font-bold">✕</button>
        </div>

        <form method="post" asp-page-handler="CreateStaff" class="space-y-4">
            @Html.AntiForgeryToken()
            <div>
                <label asp-for="CreateStaffInput.FullName" class="block text-sm font-bold text-gray-700 uppercase tracking-wider mb-2">Họ và tên nhân viên *</label>
                <input asp-for="CreateStaffInput.FullName" required class="w-full bg-[#F3F4F6] border border-gray-200 rounded-xl px-4 py-3 text-base text-gray-900 focus:ring-2 focus:ring-red-highland font-semibold" placeholder="Nguyễn Thu Ngân" />
                <span asp-validation-for="CreateStaffInput.FullName" class="text-xs text-red-600 font-semibold mt-1 block"></span>
            </div>

            <div class="grid grid-cols-1 sm:grid-cols-2 gap-4">
                <div>
                    <label asp-for="CreateStaffInput.Email" class="block text-sm font-bold text-gray-700 uppercase tracking-wider mb-2">Email *</label>
                    <input asp-for="CreateStaffInput.Email" type="email" required class="w-full bg-[#F3F4F6] border border-gray-200 rounded-xl px-4 py-3 text-base text-gray-900 focus:ring-2 focus:ring-red-highland font-semibold" placeholder="staff2@lowlandcoffee.com" />
                    <span asp-validation-for="CreateStaffInput.Email" class="text-xs text-red-600 font-semibold mt-1 block"></span>
                </div>
                <div>
                    <label asp-for="CreateStaffInput.PhoneNumber" class="block text-sm font-bold text-gray-700 uppercase tracking-wider mb-2">Số điện thoại *</label>
                    <input asp-for="CreateStaffInput.PhoneNumber" type="tel" required class="w-full bg-[#F3F4F6] border border-gray-200 rounded-xl px-4 py-3 text-base text-gray-900 focus:ring-2 focus:ring-red-highland font-semibold" placeholder="0902233999" />
                    <span asp-validation-for="CreateStaffInput.PhoneNumber" class="text-xs text-red-600 font-semibold mt-1 block"></span>
                </div>
            </div>

            <div>
                <label asp-for="CreateStaffInput.Address" class="block text-sm font-bold text-gray-700 uppercase tracking-wider mb-2">Địa chỉ làm việc</label>
                <input asp-for="CreateStaffInput.Address" class="w-full bg-[#F3F4F6] border border-gray-200 rounded-xl px-4 py-3 text-base text-gray-900 focus:ring-2 focus:ring-red-highland font-semibold" placeholder="Cửa hàng LowLand Coffee Thủ Đức" />
            </div>

            <div class="grid grid-cols-1 sm:grid-cols-2 gap-4">
                <div>
                    <label asp-for="CreateStaffInput.Password" class="block text-sm font-bold text-gray-700 uppercase tracking-wider mb-2">Mật khẩu tài khoản *</label>
                    <input asp-for="CreateStaffInput.Password" required minlength="6" class="w-full bg-[#F3F4F6] border border-gray-200 rounded-xl px-4 py-3 text-base text-gray-900 focus:ring-2 focus:ring-red-highland font-semibold" />
                    <p class="text-xs text-gray-500 mt-1">Mặc định: Admin@123 (tối thiểu 6 ký tự).</p>
                    <span asp-validation-for="CreateStaffInput.Password" class="text-xs text-red-600 font-semibold mt-1 block"></span>
                </div>
                <div>
                    <label class="block text-sm font-bold text-gray-700 uppercase tracking-wider mb-2">Vai trò được cấp</label>
                    <input type="text" readonly value="Nhân viên (Staff)" class="w-full bg-gray-200 border-0 rounded-xl px-4 py-3 text-base text-gray-700 font-bold" />
                </div>
            </div>

            <div class="flex gap-3 pt-4 border-t border-gray-100">
                <button type="button" onclick="closeCreateStaffModal()" class="flex-1 py-3.5 rounded-xl bg-gray-100 text-gray-700 font-bold text-sm hover:bg-gray-200 transition">Hủy bỏ</button>
                <button type="submit" class="flex-1 py-3.5 rounded-xl bg-red-highland text-white font-bold text-sm hover:bg-red-700 transition">Cấp tài khoản ngay</button>
            </div>
        </form>
    </div>
</div>

<!-- ========================================================================= -->
<!-- Modal 2: Chỉnh sửa Người dùng (Update User - Server POST) -->
<!-- ========================================================================= -->
<div id="modal-edit-user" class="fixed inset-0 z-50 bg-black/60 backdrop-blur-sm hidden items-center justify-center p-4">
    <div class="bg-white rounded-3xl max-w-lg w-full p-6 sm:p-8 shadow-2xl space-y-6">
        <div class="flex items-center justify-between pb-4 border-b border-gray-100">
            <div>
                <h3 class="text-xl font-black text-gray-900">Cập nhật thông tin Người dùng</h3>
                <p class="text-xs text-gray-500 font-medium">Chỉnh sửa họ tên, số điện thoại và địa chỉ</p>
            </div>
            <button type="button" onclick="closeEditUserModal()" class="text-gray-400 hover:text-gray-600 text-lg font-bold">✕</button>
        </div>

        <form method="post" asp-page-handler="UpdateUser" class="space-y-4">
            @Html.AntiForgeryToken()
            <input type="hidden" name="id" id="edit-user-id" />

            <div>
                <label asp-for="UpdateUserInput.FullName" class="block text-sm font-bold text-gray-700 uppercase tracking-wider mb-2">Họ và tên *</label>
                <input asp-for="UpdateUserInput.FullName" id="edit-fullname" required class="w-full bg-[#F3F4F6] border border-gray-200 rounded-xl px-4 py-3 text-base text-gray-900 focus:ring-2 focus:ring-red-highland font-semibold" />
                <span asp-validation-for="UpdateUserInput.FullName" class="text-xs text-red-600 font-semibold mt-1 block"></span>
            </div>

            <div class="grid grid-cols-1 sm:grid-cols-2 gap-4">
                <div>
                    <label class="block text-sm font-bold text-gray-700 uppercase tracking-wider mb-2">Email</label>
                    <input type="email" id="edit-email" readonly class="w-full bg-gray-200 border-0 rounded-xl px-4 py-3 text-base text-gray-600 font-bold cursor-not-allowed" />
                </div>
                <div>
                    <label asp-for="UpdateUserInput.PhoneNumber" class="block text-sm font-bold text-gray-700 uppercase tracking-wider mb-2">Số điện thoại</label>
                    <input asp-for="UpdateUserInput.PhoneNumber" id="edit-phone" class="w-full bg-[#F3F4F6] border border-gray-200 rounded-xl px-4 py-3 text-base text-gray-900 focus:ring-2 focus:ring-red-highland font-semibold" />
                    <span asp-validation-for="UpdateUserInput.PhoneNumber" class="text-xs text-red-600 font-semibold mt-1 block"></span>
                </div>
            </div>

            <div>
                <label asp-for="UpdateUserInput.Address" class="block text-sm font-bold text-gray-700 uppercase tracking-wider mb-2">Địa chỉ</label>
                <input asp-for="UpdateUserInput.Address" id="edit-address" class="w-full bg-[#F3F4F6] border border-gray-200 rounded-xl px-4 py-3 text-base text-gray-900 focus:ring-2 focus:ring-red-highland font-semibold" />
            </div>

            <div class="flex gap-3 pt-4 border-t border-gray-100">
                <button type="button" onclick="closeEditUserModal()" class="flex-1 py-3.5 rounded-xl bg-gray-100 text-gray-700 font-bold text-sm hover:bg-gray-200 transition">Hủy</button>
                <button type="submit" class="flex-1 py-3.5 rounded-xl bg-red-highland text-white font-bold text-sm hover:bg-red-700 transition">Lưu thay đổi</button>
            </div>
        </form>
    </div>
</div>

<!-- ========================================================================= -->
<!-- Modal 3: Xác nhận xóa người dùng (Delete User - Server POST) -->
<!-- ========================================================================= -->
<div id="modal-confirm-delete" class="fixed inset-0 z-50 hidden bg-black/60 backdrop-blur-sm items-center justify-center p-4">
    <div class="bg-white rounded-3xl max-w-sm w-full p-6 shadow-2xl border border-gray-100 text-center space-y-4">
        <div class="w-14 h-14 mx-auto rounded-2xl bg-red-100 text-red-highland flex items-center justify-center text-2xl shadow-sm">
            <i class="fi fi-rr-trash"></i>
        </div>
        <div>
            <h3 class="text-lg font-black text-gray-900">Xác nhận xóa tài khoản</h3>
            <p class="text-xs text-gray-500 mt-1 leading-relaxed" id="delete-confirm-text">
                Bạn có chắc chắn muốn xóa tài khoản này khỏi hệ thống?
            </p>
        </div>
        <form method="post" asp-page-handler="DeleteUser" class="flex gap-2.5 pt-2">
            @Html.AntiForgeryToken()
            <input type="hidden" name="id" id="delete-user-id" />
            <button type="button" onclick="closeDeleteConfirmModal()" class="flex-1 py-3 rounded-xl bg-gray-100 text-gray-700 font-bold text-xs hover:bg-gray-200 transition">
                Hủy bỏ
            </button>
            <button type="submit" class="flex-1 py-3 rounded-xl bg-red-highland text-white font-black text-xs hover:bg-red-700 shadow-md transition">
                Xóa ngay
            </button>
        </form>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
    <script>
        function openCreateStaffModal() {
            const m = document.getElementById('modal-create-staff');
            m.classList.remove('hidden');
            m.classList.add('flex');
        }

        function closeCreateStaffModal() {
            const m = document.getElementById('modal-create-staff');
            m.classList.add('hidden');
            m.classList.remove('flex');
        }

        function openEditUserModal(id, fullName, email, phone, address) {
            document.getElementById('edit-user-id').value = id;
            document.getElementById('edit-fullname').value = fullName;
            document.getElementById('edit-email').value = email;
            document.getElementById('edit-phone').value = (phone && phone !== '---') ? phone : '';
            document.getElementById('edit-address').value = (address && address !== 'Chưa cập nhật') ? address : '';

            const m = document.getElementById('modal-edit-user');
            m.classList.remove('hidden');
            m.classList.add('flex');
        }

        function closeEditUserModal() {
            const m = document.getElementById('modal-edit-user');
            m.classList.add('hidden');
            m.classList.remove('flex');
        }

        function openDeleteModal(id, fullName, email) {
            document.getElementById('delete-user-id').value = id;
            const textEl = document.getElementById('delete-confirm-text');
            if (textEl) {
                textEl.innerHTML = `Bạn có chắc chắn muốn xóa tài khoản <strong>"${fullName}"</strong> (${email})?`;
            }
            const modal = document.getElementById('modal-confirm-delete');
            modal.classList.remove('hidden');
            modal.classList.add('flex');
        }

        function closeDeleteConfirmModal() {
            const modal = document.getElementById('modal-confirm-delete');
            modal.classList.add('hidden');
            modal.classList.remove('flex');
        }
    </script>
}
