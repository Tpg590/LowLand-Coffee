    // Chức năng 20 (Staff): Bật/Tắt trạng thái Còn hàng / Hết hàng (kèm JWT Token xác thực quyền Staff/Admin)
    async function toggleStock(productId, newStatus, productName) {
        try {
            const token = localStorage.getItem('auth_token') || '';
            const headers = { 'Content-Type': 'application/json' };
            if (token) headers['Authorization'] = `Bearer ${token}`;

            const response = await fetch(`${PRODUCT_API_BASE}/api/products/${productId}/toggle-stock`, {
                method: 'PATCH',
                headers,
                body: JSON.stringify({ isAvailable: newStatus })
            });

            const resJson = await response.json().catch(() => null);
            if (!response.ok || !(resJson?.isSuccess ?? resJson?.success)) {
                throw new Error(resJson?.message || 'Cập nhật trạng thái thất bại');
            }

            const prod = allProducts.find(p => p.id === productId);
            if (prod) {
                prod.isAvailable = newStatus;
            }

            renderMetrics();
            applyProductFilters();

            const statusText = newStatus ? 'Còn hàng' : 'Hết hàng';
            if (typeof showToast === 'function') {
                showToast('Đã cập nhật tồn kho', `Món "${productName}" đã được chuyển sang trạng thái: ${statusText}.`, 'success');
            }
        } catch (error) {
            console.error('Lỗi toggle stock:', error);
            if (typeof showToast === 'function') {
                showToast('Lỗi cập nhật', error.message || 'Không thể cập nhật trạng thái món.', 'error');
            }
        }
    }

    // Chức năng 17: Xem thông tin chi tiết, Size, Topping, Giá
    async function viewProductDetail(productId) {
        try {
            const res = await fetch(`${PRODUCT_API_BASE}/api/products/${productId}`);
            const json = await res.json().catch(() => null);
            const prod = json?.data || allProducts.find(p => p.id === productId);
            if (!prod) return;

            const imgSrc = (prod.imageUrl && prod.imageUrl.startsWith('http') && !prod.imageUrl.includes('placehold.co'))
                ? prod.imageUrl
                : '/images/logo.jpg';

            document.getElementById('modal-img').src = imgSrc;
            document.getElementById('modal-title').innerText = prod.name;
            document.getElementById('modal-price').innerText = `Giá cơ bản: ${(prod.basePrice || prod.price || 0).toLocaleString('vi-VN')} đ`;
            document.getElementById('modal-desc').innerText = prod.description || 'Không có mô tả chi tiết cho sản phẩm này.';
            document.getElementById('modal-category-badge').innerHTML = `<i class="fi fi-rr-tag text-[10px]"></i><span>${prod.categoryName || prod.category?.name || 'Danh mục'}</span>`;

            const statusBadge = document.getElementById('modal-status-badge');
            if (prod.isAvailable) {
                statusBadge.innerHTML = `<span class="px-3 py-1 rounded-full text-xs font-bold bg-emerald-100 text-emerald-800 border border-emerald-200 flex items-center gap-1"><i class="fi fi-rr-check-circle"></i><span>Còn hàng</span></span>`;
            } else {
                statusBadge.innerHTML = `<span class="px-3 py-1 rounded-full text-xs font-bold bg-rose-100 text-rose-800 border border-rose-200 flex items-center gap-1"><i class="fi fi-rr-cross-circle"></i><span>Tạm hết hàng</span></span>`;
            }

            const options = prod.options || [];
            const sizes = prod.sizes || options.filter(o => (o.optionType || '').toUpperCase() === 'SIZE');
            const toppings = prod.toppings || options.filter(o => (o.optionType || '').toUpperCase() === 'TOPPING');

            const sizesContainer = document.getElementById('modal-sizes');
            if (sizes.length === 0) {
                sizesContainer.innerHTML = `<span class="text-xs text-gray-400 italic">Mặc định (Không có Size phụ thu)</span>`;
            } else {
                sizesContainer.innerHTML = sizes.map(s => `
                    <div class="px-3 py-1.5 rounded-xl bg-blue-50 border border-blue-200 text-xs font-bold text-blue-900 flex items-center gap-1.5">
                        <i class="fi fi-rr-cup-togo text-blue-600"></i>
                        <span>${s.name}</span>
                        <span class="text-blue-600">+${(s.extraPrice || 0).toLocaleString('vi-VN')}đ</span>
                    </div>
                `).join('');
            }

            const toppingsContainer = document.getElementById('modal-toppings');
            if (toppings.length === 0) {
                toppingsContainer.innerHTML = `<span class="text-xs text-gray-400 italic">Không có Topping đi kèm</span>`;
            } else {
                toppingsContainer.innerHTML = toppings.map(t => `
                    <div class="px-3 py-1.5 rounded-xl bg-amber-50 border border-amber-200 text-xs font-bold text-amber-900 flex items-center gap-1.5">
                        <i class="fi fi-rr-sparkles text-amber-600"></i>
                        <span>${t.name}</span>
                        <span class="text-amber-700">+${(t.extraPrice || 0).toLocaleString('vi-VN')}đ</span>
                    </div>
                `).join('');
            }

            document.getElementById('product-detail-modal').classList.remove('hidden');
        } catch (err) {
            console.error(err);
        }
    }

    function closeProductModal() {
        document.getElementById('product-detail-modal').classList.add('hidden');
    }
</script>
}
