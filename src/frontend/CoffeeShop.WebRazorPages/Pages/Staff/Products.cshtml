@page
@model CoffeeShop.WebRazorPages.Pages.Staff.ProductsModel
@{
    Layout = "_StaffLayout";
    ViewData["Title"] = "Quản lý Sản phẩm - Nhân viên";
}

<style>
    @@keyframes floatCup {
        0%, 100% {
            transform: translateY(0px) rotate(0deg);
        }
        50% {
            transform: translateY(-14px) rotate(2deg);
        }
    }
    .animate-floating-cup {
        animation: floatCup 3.6s ease-in-out infinite;
    }
</style>

<div class="w-full px-4 sm:px-6 lg:px-8 py-6 space-y-6">
    <!-- Header -->
    <div class="flex flex-col sm:flex-row sm:items-center justify-between pb-5 border-b border-gray-200 gap-4">
        <div class="flex items-center gap-3.5">
            <span class="w-12 h-12 rounded-2xl bg-red-highland text-white flex items-center justify-center font-black text-xl shadow-md">
                <i class="fi fi-rr-box-alt flex items-center"></i>
            </span>
            <div>
                <h1 class="text-2xl sm:text-3xl font-black text-gray-900 tracking-tight flex items-center gap-3">
                    <span>Thực đơn &amp; Trạng thái Món</span>
                    <span class="px-3 py-1 rounded-full bg-emerald-100 text-emerald-800 text-xs font-black uppercase border border-emerald-200 flex items-center gap-1">
                        <i class="fi fi-rr-badge-check"></i>
                        <span>Quyền Nhân viên (Staff)</span>
                    </span>
                </h1>
                <p class="text-sm text-gray-500 font-medium mt-0.5">Duyệt danh sách món, tìm kiếm &amp; lọc theo giá/danh mục, xem chi tiết Size/Topping và bật/tắt nhanh trạng thái <strong class="text-gray-700">Còn hàng / Hết hàng</strong></p>
            </div>
        </div>

        <div class="flex items-center gap-2.5">
            <a href="/Staff/Categories" class="px-4 py-2.5 rounded-xl bg-white border border-gray-300 hover:bg-gray-50 text-gray-700 text-sm font-bold shadow-xs flex items-center gap-2 transition">
                <i class="fi fi-rr-apps text-sm text-red-highland flex items-center"></i>
                <span>Xem Danh mục</span>
            </a>
            <button type="button" onclick="loadCatalogData()" class="px-4 py-2.5 rounded-xl bg-red-highland hover:bg-red-highland-700 text-white text-sm font-bold shadow-sm flex items-center gap-2 transition active:scale-95">
                <i class="fi fi-rr-refresh text-sm flex items-center"></i>
                <span>Làm mới dữ liệu</span>
            </button>
        </div>
    </div>

    <!-- ========================================================================= -->
    <!-- SWIPER.JS HERO BANNER SLIDER + FLOATING CUP ANIMATION (Quy tắc 5 & 6) -->
    <!-- ========================================================================= -->
    <div class="swiper staffProductSwiper rounded-3xl overflow-hidden shadow-lg border border-gray-200">
        <div class="swiper-wrapper">
            <div class="swiper-slide bg-gradient-to-r from-[#2D1A12] via-[#4A2518] to-red-highland text-white">
                <div class="grid grid-cols-1 lg:grid-cols-12 items-center px-6 sm:px-10 py-6 gap-6">
                    <div class="lg:col-span-8 space-y-2">
                        <span class="inline-flex items-center gap-2 px-3 py-1 rounded-full bg-white/15 backdrop-blur-md text-amber-300 text-xs font-extrabold uppercase tracking-wider">
                            <i class="fi fi-rr-mug-hot-alt flex items-center"></i>
                            <span>Quầy Pha Chế LowLand Coffee</span>
                        </span>
                        <h2 class="text-xl sm:text-2xl font-black tracking-tight">
                            Kiểm Soát Trạng Thái Tồn Kho Thực Đơn Thời Gian Thực
                        </h2>
                        <p class="text-xs sm:text-sm text-gray-200 max-w-2xl leading-relaxed">
                            Nhân viên pha chế &amp; thu ngân có thể bật/tắt nhanh trạng thái <strong class="text-amber-300">Còn hàng / Tạm hết hàng</strong> ngay khi nguyên liệu tại quầy thay đổi.
                        </p>
                    </div>
                    <div class="lg:col-span-4 flex items-center justify-center relative py-2">
                        <div class="absolute w-32 h-32 rounded-full bg-amber-400/20 blur-2xl"></div>
                        <img src="https://images.unsplash.com/photo-1514432324607-a09d9b4aefdd?auto=format&fit=crop&w=400&q=80"
                             alt="Floating Coffee Cup"
                             class="animate-float animate-floating-cup relative z-10 w-28 h-28 sm:w-32 sm:h-32 object-cover rounded-full border-4 border-amber-300/50 shadow-2xl"
                             onerror="this.src='/images/logo.jpg'" />
                    </div>
                </div>
            </div>

            <div class="swiper-slide bg-gradient-to-r from-red-highland via-[#8E1C22] to-[#2D1A12] text-white">
                <div class="grid grid-cols-1 lg:grid-cols-12 items-center px-6 sm:px-10 py-6 gap-6">
                    <div class="lg:col-span-8 space-y-2">
                        <span class="inline-flex items-center gap-2 px-3 py-1 rounded-full bg-white/15 backdrop-blur-md text-amber-200 text-xs font-extrabold uppercase tracking-wider">
                            <i class="fi fi-rr-sparkles flex items-center"></i>
                            <span>Chuẩn Công Thức Size &amp; Topping</span>
                        </span>
                        <h2 class="text-xl sm:text-2xl font-black tracking-tight">
                            Tra Cứu Nhanh Định Lượng Size (S/M/L) &amp; Topping Đi Kèm
                        </h2>
                        <p class="text-xs sm:text-sm text-gray-100 max-w-2xl leading-relaxed">
                            Nhấn vào từng thẻ sản phẩm để xem chi tiết cấu hình Size và các loại Topping phụ thu.
                        </p>
                    </div>
                    <div class="lg:col-span-4 flex items-center justify-center relative py-2">
                        <div class="absolute w-32 h-32 rounded-full bg-white/15 blur-2xl"></div>
                        <img src="https://images.unsplash.com/photo-1556679343-c7306c1976bc?auto=format&fit=crop&w=400&q=80"
                             alt="Floating Tea Cup"
                             class="animate-float animate-floating-cup relative z-10 w-28 h-28 sm:w-32 sm:h-32 object-cover rounded-full border-4 border-white/40 shadow-2xl"
                             onerror="this.src='/images/logo.jpg'" />
                    </div>
                </div>
            </div>
        </div>
        <div class="swiper-pagination"></div>
    </div>

    <!-- Thống kê nhanh (KPI Metrics) -->
    <div class="grid grid-cols-2 sm:grid-cols-4 gap-4">
        <div class="bg-white p-5 rounded-2xl border border-gray-200 shadow-xs flex items-center gap-4">
            <div class="w-12 h-12 rounded-xl bg-amber-50 text-amber-700 flex items-center justify-center text-xl shrink-0">
                <i class="fi fi-rr-apps flex items-center"></i>
            </div>
            <div>
                <div class="text-xs font-bold text-gray-400 uppercase tracking-wider">Danh mục</div>
                <div class="text-2xl font-black text-gray-900" id="stat-category-count">0</div>
            </div>
        </div>

        <div class="bg-white p-5 rounded-2xl border border-gray-200 shadow-xs flex items-center gap-4">
            <div class="w-12 h-12 rounded-xl bg-red-50 text-red-highland flex items-center justify-center text-xl shrink-0">
                <i class="fi fi-rr-mug-hot-alt flex items-center"></i>
            </div>
            <div>
                <div class="text-xs font-bold text-gray-400 uppercase tracking-wider">Tổng số món</div>
                <div class="text-2xl font-black text-gray-900" id="stat-product-count">0</div>
            </div>
        </div>

        <div class="bg-white p-5 rounded-2xl border border-gray-200 shadow-xs flex items-center gap-4">
            <div class="w-12 h-12 rounded-xl bg-emerald-50 text-emerald-700 flex items-center justify-center text-xl shrink-0">
                <i class="fi fi-rr-check-circle flex items-center"></i>
            </div>
            <div>
                <div class="text-xs font-bold text-gray-400 uppercase tracking-wider">Đang phục vụ</div>
                <div class="text-2xl font-black text-emerald-600" id="stat-available-count">0</div>
            </div>
        </div>

        <div class="bg-white p-5 rounded-2xl border border-gray-200 shadow-xs flex items-center gap-4">
            <div class="w-12 h-12 rounded-xl bg-rose-50 text-rose-700 flex items-center justify-center text-xl shrink-0">
                <i class="fi fi-rr-cross-circle flex items-center"></i>
            </div>
            <div>
                <div class="text-xs font-bold text-gray-400 uppercase tracking-wider">Tạm hết hàng</div>
                <div class="text-2xl font-black text-rose-600" id="stat-out-of-stock-count">0</div>
            </div>
        </div>
    </div>

    <!-- KHỐI 2: DANH SÁCH SẢN PHẨM, TÌM KIẾM, LỌC & BẬT/TẮT HẾT HÀNG -->
    <div class="bg-white rounded-3xl border border-gray-200 shadow-xs overflow-hidden">
        <!-- Bộ lọc & Tìm kiếm (Chức năng 18: Tìm kiếm theo từ khóa, lọc theo giá, danh mục) -->
        <div class="p-6 border-b border-gray-200 space-y-4 bg-slate-50/50">
            <div class="flex flex-col lg:flex-row gap-3.5 items-center justify-between">
                <div class="flex flex-wrap sm:flex-nowrap items-center gap-3 w-full lg:w-auto">
                    <!-- Tìm kiếm theo từ khóa -->
                    <div class="relative flex-1 sm:w-80">
                        <input type="text" id="filter-search" onkeyup="applyProductFilters()" placeholder="Tìm theo tên món, mô tả..." class="w-full bg-white border border-gray-300 rounded-xl pl-10 pr-4 py-2.5 text-sm font-semibold text-gray-900 focus:ring-2 focus:ring-red-highland focus:border-red-highland placeholder-gray-400 transition" />
                        <span class="absolute left-3.5 top-3 text-gray-400">
                            <i class="fi fi-rr-search text-sm flex items-center"></i>
                        </span>
                    </div>

                    <!-- Lọc theo khoảng giá -->
                    <select id="filter-price" onchange="applyProductFilters()" class="bg-white border border-gray-300 rounded-xl px-3.5 py-2.5 text-sm font-bold text-gray-700 focus:ring-2 focus:ring-red-highland transition">
                        <option value="ALL">Tất cả mức giá</option>
                        <option value="UNDER_30">Dưới 30.000đ</option>
                        <option value="30_TO_45">Từ 30.000đ - 45.000đ</option>
                        <option value="OVER_45">Trên 45.000đ</option>
                    </select>

                    <!-- Lọc trạng thái còn/hết hàng -->
                    <select id="filter-status" onchange="applyProductFilters()" class="bg-white border border-gray-300 rounded-xl px-3.5 py-2.5 text-sm font-bold text-gray-700 focus:ring-2 focus:ring-red-highland transition">
                        <option value="ALL">Tất cả trạng thái</option>
                        <option value="AVAILABLE">Chỉ món Còn hàng</option>
                        <option value="OUT_OF_STOCK">Chỉ món Hết hàng</option>
                    </select>
                </div>

                <!-- Chuyển đổi chế độ hiển thị: Flowbite Card Grid / Data Table -->
                <div class="flex items-center gap-2">
                    <div class="flex items-center gap-1.5 bg-gray-100 p-1 rounded-xl border border-gray-200">
                        <button type="button" id="btn-staff-view-cards" onclick="switchStaffViewMode('CARDS')" class="py-2 px-3 rounded-lg text-xs font-extrabold bg-red-highland text-white shadow-xs flex items-center gap-1.5 transition">
                            <i class="fi fi-rr-apps flex items-center"></i>
                            <span>Thẻ Card</span>
                        </button>
                        <button type="button" id="btn-staff-view-table" onclick="switchStaffViewMode('TABLE')" class="py-2 px-3 rounded-lg text-xs font-bold text-gray-600 hover:text-gray-900 flex items-center gap-1.5 transition">
                            <i class="fi fi-rr-list flex items-center"></i>
                            <span>Bảng</span>
                        </button>
                    </div>
                </div>
            </div>

            <!-- Flowbite Tabs cho danh mục (Quy tắc 4) -->
            <div class="border-b border-gray-200">
                <ul id="filter-cat-tabs" class="flex flex-wrap -mb-px text-sm font-bold text-center text-gray-500 gap-2" role="tablist">
                    <li role="presentation">
                        <button type="button" role="tab" onclick="selectCategoryTab('ALL')" class="cat-pill inline-flex items-center gap-2 px-4 py-2.5 border-b-2 border-red-highland text-red-highland bg-red-50/60 rounded-t-xl font-extrabold text-xs transition" data-cat="ALL">
                            <i class="fi fi-rr-apps flex items-center"></i>
                            <span>Tất cả</span>
                        </button>
                    </li>
                </ul>
            </div>
        </div>

        <!-- VIEW 1: FLOWBITE PRODUCT CARDS GRID (Quy tắc 4 - Mặc định hiển thị) -->
        <div id="staff-products-card-view" class="p-6 bg-gray-50/40">
            <div id="staff-product-cards-grid" class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 xl:grid-cols-4 gap-6">
                <div class="col-span-full py-12 text-center text-gray-400">
                    <i class="fi fi-rr-spinner animate-spin text-2xl mb-2 inline-block"></i>
                    <p class="text-xs font-semibold">Đang tải dữ liệu sản phẩm từ máy chủ...</p>
                </div>
            </div>
        </div>

        <!-- VIEW 2: BẢNG SẢN PHẨM -->
        <div id="staff-products-table-view" class="overflow-x-auto hidden">
            <table class="w-full text-left text-sm text-gray-600">
                <thead class="text-xs font-black text-gray-400 uppercase bg-gray-50 border-b border-gray-200">
                    <tr>
                        <th class="px-6 py-4">Sản phẩm</th>
                        <th class="px-6 py-4">Danh mục</th>
                        <th class="px-6 py-4">Giá cơ bản</th>
                        <th class="px-6 py-4">Size &amp; Topping</th>
                        <th class="px-6 py-4 text-center">Trạng thái kho</th>
                        <th class="px-6 py-4 text-center">Thao tác của Staff</th>
                    </tr>
                </thead>
                <tbody id="product-table-body" class="divide-y divide-gray-100 font-medium">
                    <tr>
                        <td colspan="6" class="py-12 text-center text-gray-400">
                            <i class="fi fi-rr-spinner animate-spin text-2xl mb-2 inline-block"></i>
                            <p class="text-xs font-semibold">Đang tải dữ liệu sản phẩm từ máy chủ...</p>
                        </td>
                    </tr>
                </tbody>
            </table>
        </div>
    </div>
</div>

<!-- ========================================================================= -->
<!-- MODAL CHI TIẾT SẢN PHẨM (Chức năng 17: Xem thông tin chi tiết, Size, Topping, Giá) -->
<!-- ========================================================================= -->
<div id="product-detail-modal" class="fixed inset-0 z-50 bg-black/60 backdrop-blur-sm hidden flex items-center justify-center p-4">
    <div class="bg-white rounded-3xl max-w-lg w-full overflow-hidden shadow-2xl border border-gray-200 max-h-[90vh] flex flex-col">
        <div class="relative h-52 bg-amber-50 flex items-center justify-center overflow-hidden border-b border-gray-100 shrink-0">
            <img id="modal-img" src="" alt="Product" class="w-full h-full object-cover" onerror="this.src='/images/logo.jpg'" />
            <button type="button" onclick="closeProductModal()" class="absolute top-4 right-4 w-9 h-9 rounded-full bg-black/40 hover:bg-black/60 text-white flex items-center justify-center transition">
                <i class="fi fi-rr-cross-small text-lg flex items-center"></i>
            </button>
            <span id="modal-category-badge" class="absolute bottom-4 left-4 px-3 py-1 rounded-full bg-black/60 backdrop-blur-sm text-white text-xs font-bold flex items-center gap-1">
                <i class="fi fi-rr-tag text-[10px]"></i>
                <span>Danh mục</span>
            </span>
        </div>

        <div class="p-6 space-y-4 overflow-y-auto">
            <div class="flex items-start justify-between gap-4">
                <div>
                    <h3 id="modal-title" class="text-xl font-black text-gray-900">Tên sản phẩm</h3>
                    <div id="modal-price" class="text-lg font-black text-red-highland mt-0.5">0 đ</div>
                </div>
                <div id="modal-status-badge">
                    <!-- Badge trạng thái -->
                </div>
            </div>

            <div>
                <div class="text-xs font-black uppercase tracking-wider text-gray-400 mb-1">Mô tả sản phẩm</div>
                <p id="modal-desc" class="text-sm text-gray-600 bg-gray-50 p-3.5 rounded-2xl border border-gray-100 leading-relaxed">
                    Không có mô tả.
                </p>
            </div>

            <!-- Danh sách Size -->
            <div>
                <div class="text-xs font-black uppercase tracking-wider text-gray-400 mb-2 flex items-center gap-1.5">
                    <i class="fi fi-rr-cup-togo text-red-highland"></i>
                    <span>Kích cỡ (Size) &amp; Giá phụ thu</span>
                </div>
                <div id="modal-sizes" class="flex flex-wrap gap-2"></div>
            </div>

            <!-- Danh sách Topping -->
            <div>
                <div class="text-xs font-black uppercase tracking-wider text-gray-400 mb-2 flex items-center gap-1.5">
                    <i class="fi fi-rr-sparkles text-amber-600"></i>
                    <span>Topping đi kèm &amp; Giá phụ thu</span>
                </div>
                <div id="modal-toppings" class="flex flex-wrap gap-2"></div>
            </div>

            <div class="pt-3 border-t border-gray-100 flex items-center justify-end gap-3">
                <button type="button" onclick="closeProductModal()" class="px-5 py-2.5 rounded-xl bg-gray-100 hover:bg-gray-200 font-bold text-xs text-gray-700 transition">
                    Đóng cửa sổ
                </button>
            </div>
        </div>
    </div>
</div>

@section Scripts {
<script>
    const PRODUCT_API_BASE = 'http://localhost:8080';
    let allCategories = [];
    let allProducts = [];
    let currentSelectedCategory = 'ALL';

    document.addEventListener('DOMContentLoaded', () => {
        if (typeof Swiper !== 'undefined') {
            new Swiper('.staffProductSwiper', {
                loop: true,
                speed: 700,
                autoplay: {
                    delay: 4500,
                    disableOnInteraction: false
                },
                pagination: {
                    el: '.swiper-pagination',
                    clickable: true
                }
            });
        }
        loadCatalogData();
    });

    function switchStaffViewMode(mode) {
        const cardView = document.getElementById('staff-products-card-view');
        const tableView = document.getElementById('staff-products-table-view');
        const btnCards = document.getElementById('btn-staff-view-cards');
        const btnTable = document.getElementById('btn-staff-view-table');

        if (mode === 'CARDS') {
            cardView.classList.remove('hidden');
            tableView.classList.add('hidden');
            btnCards.className = 'py-2 px-3 rounded-lg text-xs font-extrabold bg-red-highland text-white shadow-xs flex items-center gap-1.5 transition';
            btnTable.className = 'py-2 px-3 rounded-lg text-xs font-bold text-gray-600 hover:text-gray-900 flex items-center gap-1.5 transition';
        } else {
            cardView.classList.add('hidden');
            tableView.classList.remove('hidden');
            btnTable.className = 'py-2 px-3 rounded-lg text-xs font-extrabold bg-red-highland text-white shadow-xs flex items-center gap-1.5 transition';
            btnCards.className = 'py-2 px-3 rounded-lg text-xs font-bold text-gray-600 hover:text-gray-900 flex items-center gap-1.5 transition';
        }
    }

    async function loadCatalogData() {
        try {
            const catRes = await fetch(`${PRODUCT_API_BASE}/api/categories`);
            if (catRes.ok) {
                const catJson = await catRes.json();
                allCategories = catJson.data || [];
            }

            const prodRes = await fetch(`${PRODUCT_API_BASE}/api/products?pageSize=200`);
            if (prodRes.ok) {
                const prodJson = await prodRes.json();
                allProducts = (prodJson.data && prodJson.data.items) ? prodJson.data.items : [];
            }

            renderMetrics();
            renderCategoryTabs();

            const urlParams = new URLSearchParams(window.location.search);
            const catParam = urlParams.get('category');
            if (catParam) {
                selectCategoryTab(catParam);
            } else {
                applyProductFilters();
            }

        } catch (error) {
            console.error('Lỗi khi tải dữ liệu catalog:', error);
            if (typeof showToast === 'function') {
                showToast('Lỗi kết nối', 'Không thể kết nối đến API Gateway (8080)', 'error');
            }
        }
    }

    function renderMetrics() {
        const catCount = allCategories.length;
        const prodCount = allProducts.length;
        const availableCount = allProducts.filter(p => p.isAvailable).length;
        const outOfStockCount = prodCount - availableCount;

        document.getElementById('stat-category-count').innerText = catCount;
        document.getElementById('stat-product-count').innerText = prodCount;
        document.getElementById('stat-available-count').innerText = availableCount;
        document.getElementById('stat-out-of-stock-count').innerText = outOfStockCount;
    }

    function renderCategoryTabs() {
        const container = document.getElementById('filter-cat-tabs');
        if (!container) return;

        let html = `
            <li role="presentation">
                <button type="button" role="tab" onclick="selectCategoryTab('ALL')" class="cat-pill inline-flex items-center gap-2 px-4 py-2.5 border-b-2 border-red-highland text-red-highland bg-red-50/60 rounded-t-xl font-extrabold text-xs transition" data-cat="ALL">
                    <i class="fi fi-rr-apps flex items-center"></i>
                    <span>Tất cả (${allProducts.length})</span>
                </button>
            </li>
        `;

        allCategories.forEach(cat => {
            const count = allProducts.filter(p => p.categoryId === cat.id).length;
            html += `
                <li role="presentation">
                    <button type="button" role="tab" onclick="selectCategoryTab('${cat.id}')" class="cat-pill inline-flex items-center gap-2 px-4 py-2.5 border-b-2 border-transparent hover:text-gray-700 hover:border-gray-300 rounded-t-xl font-bold text-xs text-gray-500 transition" data-cat="${cat.id}">
                        <i class="fi fi-rr-cup-togo flex items-center"></i>
                        <span>${cat.name} (${count})</span>
                    </button>
                </li>
            `;
        });

        container.innerHTML = html;
    }

    function selectCategoryTab(catId) {
        currentSelectedCategory = catId;
        document.querySelectorAll('.cat-pill').forEach(btn => {
            if (btn.getAttribute('data-cat') === catId) {
                btn.className = "cat-pill inline-flex items-center gap-2 px-4 py-2.5 border-b-2 border-red-highland text-red-highland bg-red-50/60 rounded-t-xl font-extrabold text-xs transition";
            } else {
                btn.className = "cat-pill inline-flex items-center gap-2 px-4 py-2.5 border-b-2 border-transparent hover:text-gray-700 hover:border-gray-300 rounded-t-xl font-bold text-xs text-gray-500 transition";
            }
        });
        applyProductFilters();
    }

    // Chức năng 18: Lọc theo từ khóa, khoảng giá, danh mục, trạng thái kho
    function applyProductFilters() {
        const keyword = (document.getElementById('filter-search')?.value || '').toLowerCase().trim();
        const priceFilter = document.getElementById('filter-price')?.value || 'ALL';
        const statusFilter = document.getElementById('filter-status')?.value || 'ALL';

        let filtered = allProducts.filter(p => {
            if (currentSelectedCategory !== 'ALL' && p.categoryId !== currentSelectedCategory) {
                return false;
            }
            const price = p.basePrice || p.price || 0;
            if (priceFilter === 'UNDER_30' && price >= 30000) return false;
            if (priceFilter === '30_TO_45' && (price < 30000 || price > 45000)) return false;
            if (priceFilter === 'OVER_45' && price <= 45000) return false;

            if (statusFilter === 'AVAILABLE' && !p.isAvailable) return false;
            if (statusFilter === 'OUT_OF_STOCK' && p.isAvailable) return false;

            if (keyword) {
                const matchName = (p.name || '').toLowerCase().includes(keyword);
                const matchDesc = (p.description || '').toLowerCase().includes(keyword);
                const matchCat = (p.categoryName || '').toLowerCase().includes(keyword);
                if (!matchName && !matchDesc && !matchCat) return false;
            }
            return true;
        });

        renderStaffProductCards(filtered);
        renderProductTable(filtered);
    }

    // Render Flowbite Product Cards Grid (Quy tắc 4)
