                    <td class="px-6 py-4">
                        <div class="flex flex-wrap gap-1.5">
                            <span class="px-2 py-0.5 rounded-md bg-blue-50 text-blue-700 border border-blue-200 text-xs font-bold">${sizes.length} Size</span>
