                : `<button type="button" onclick="toggleStock('${p.id}', true, '${safeName}')" class="px-3 py-1.5 rounded-xl bg-emerald-50 hover:bg-emerald-100 text-emerald-700 border border-emerald-200 font-bold text-xs flex items-center gap-1.5 transition">
