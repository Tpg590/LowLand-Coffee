                    <option value="Không liên hệ được số điện thoại người nhận">Không liên hệ được số điện thoại người nhận</option>
                    <option value="Quán quá tải / ngoài khu vực giao hàng">Quán quá tải / ngoài khu vực giao hàng</option>
                    <option value="OTHER">Nhập lý do cụ thể khác...</option>
