@section Scripts {
    <script>
        // =========================================================================
        // BIẾN TRẠNG THÁI TOÀN CỤC CỦA MÀN HÌNH STAFF POS & ĐIỀU PHỐI ĐƠN
        // Toàn bộ dữ liệu sản phẩm và đơn hàng được nạp 100% từ Backend API thực tế
        // =========================================================================
        // Đường dẫn tương đối gọi qua YARP Reverse Proxy
        const API_GATEWAY_URL = '';
        let posProducts = [];
        let currentCategory = 'ALL';
        let posCart = [];
        let orderType = 'DINE_IN';
        let currentPosPayment = 'CASH';

        // Thông tin khách hàng thành viên được chọn tại quầy POS
        let posCustomer = null;
        let customerSearchTimeout = null;
        let lastSearchResults = [];

        // Danh sách đơn hàng & trạng thái bộ lọc ở View 2 (Điều phối đơn)
        let posOrders = [];
        let staffOrdersStatusFilter = '';
        let staffOrdersSearchQuery = '';
        let staffPendingCancelOrderId = null;
        let staffCurrentDetailOrder = null;

        // Từ điển dịch trạng thái đơn hàng & thanh toán sang Tiếng Việt rõ ràng
        const STATUS_VI = {
            'PENDING':    'Pending (Chờ xác nhận)',
            'PROCESSING': 'Processing (Đang pha chế)',
            'CONFIRMED':  'Processing (Đang pha chế)',
            'SHIPPING':   'Shipping (Đang giao hàng)',
            'DELIVERING': 'Shipping (Đang giao hàng)',
            'COMPLETED':  'Completed (Đã hoàn thành)',
            'CANCELLED':  'Cancelled (Đã hủy)'
        };
        const PAY_STATUS_VI = {
            'PENDING':   'Chờ thanh toán',
            'SUCCESS':   'Đã thanh toán',
            'PAID':      'Đã thanh toán',
            'FAILED':    'Thanh toán lỗi',
            'CANCELLED': 'Đã hủy',
            'UNPAID':    'Chưa thanh toán'
        };
        const PAY_METHOD_VI = {
            'CASH':  'Tiền mặt',
            'VNPAY': 'VNPay QR'
        };

        /**
         * Nạp danh sách danh mục đồ uống qua API Gateway (Port 8080 -> Product.API).
         */
        async function loadCategoriesFromApi() {
            try {
                const res = await fetch(`${API_GATEWAY_URL}/api/categories`);
                if (res.ok) {
                    const result = await res.json();
                    const cats = result.data || [];
                    const container = document.getElementById('pos-category-pills');
                    if (container && Array.isArray(cats) && cats.length > 0) {
                        let html = `
                            <button type="button" onclick="setCategoryFilter('ALL', this)" class="pos-cat-btn active px-4 py-2.5 rounded-xl text-sm font-bold bg-[#4F392E] text-white transition flex-shrink-0 shadow-sm flex items-center gap-1.5">
                                <i class="fi fi-rr-apps text-xs"></i>
                                <span>Tất cả món</span>
                            </button>
                        `;
                        cats.forEach(c => {
                            let icon = 'fi-rr-coffee';
                            const cName = (c.name || '').toLowerCase();
                            if (cName.includes('trà') || cName.includes('tea')) icon = 'fi-rr-leaf';
                            else if (cName.includes('freeze') || cName.includes('đá xay')) icon = 'fi-rr-glass';
                            else if (cName.includes('bánh') || cName.includes('mousse')) icon = 'fi-rr-cake-birthday';

                            html += `
                                <button type="button" onclick="setCategoryFilter('${c.id}', this)" class="pos-cat-btn px-4 py-2.5 rounded-xl text-sm font-bold bg-gray-100 hover:bg-gray-200 text-gray-700 transition flex-shrink-0 flex items-center gap-1.5">
                                    <i class="fi ${icon} text-xs"></i>
                                    <span>${c.name}</span>
                                </button>
                            `;
                        });
                        container.innerHTML = html;
                    }
                }
            } catch (err) {
                console.error('Không thể tải danh mục từ Product.API:', err);
            }
        }

        /**
         * Nạp danh sách sản phẩm thực tế qua API Gateway (Port 8080 -> Product.API) để hiển thị trên màn hình POS.
         */
        async function loadProductsFromApi() {
            await loadCategoriesFromApi();
            try {
                const res = await fetch(`${API_GATEWAY_URL}/api/products?pageSize=100`);
                if (res.ok) {
                    const result = await res.json();
                    const items = result.data?.items || result.data || [];
                    if (items && items.length > 0) {
                        posProducts = items.map(p => ({
                            id: p.id,
                            name: p.name,
                            categoryId: p.categoryId,
                            categoryName: p.categoryName || '',
                            price: p.basePrice || 0,
                            img: (p.imageUrl && p.imageUrl.startsWith('http') && !p.imageUrl.includes('placehold.co'))
                                 ? p.imageUrl
                                 : '/images/logo.jpg'
                        }));
                    }
                }
            } catch (err) {
                console.error('Lỗi khi tải danh sách món từ Product.API:', err);
            }
            filterPosProducts();
        }

        /**
         * Render lưới sản phẩm trên màn hình bán hàng tại quầy POS.
         */
        function renderCatalog(items) {
            const grid = document.getElementById('pos-product-grid');
            if (!grid) return;
            grid.innerHTML = '';

            if (!items || items.length === 0) {
                grid.innerHTML = '<div class="col-span-full py-12 text-center text-gray-400 font-bold">Không tìm thấy món nào trong danh mục này.</div>';
                return;
            }

            items.forEach(p => {
                const card = document.createElement('div');
                card.className = 'bg-white rounded-2xl border border-gray-200 shadow-sm hover:shadow-lg transition p-3.5 flex flex-col justify-between cursor-pointer group active:scale-95';
                card.onclick = () => addItemToPosTicket(p);
                card.innerHTML = `
                    <div>
                        <div class="h-32 rounded-xl bg-gray-50 flex items-center justify-center overflow-hidden mb-2.5 border border-gray-100">
                            <img src="${p.img}" alt="${p.name}" onerror="this.src='/images/logo.jpg'" class="h-full w-full object-cover group-hover:scale-105 transition duration-300" />
                        </div>
                        <h4 class="font-extrabold text-sm sm:text-base text-gray-900 group-hover:text-red-highland transition line-clamp-2 leading-snug">${p.name}</h4>
                    </div>
                    <div class="mt-3 flex items-center justify-between pt-2.5 border-t border-gray-100">
                        <span class="font-black text-sm sm:text-base text-red-highland">${p.price.toLocaleString('vi-VN')} đ</span>
                        <span class="w-8 h-8 rounded-full bg-red-highland text-white flex items-center justify-center text-base font-bold shadow-sm group-hover:scale-110 transition">+</span>
                    </div>
                `;
                grid.appendChild(card);
            });
        }

        /**
         * Lọc sản phẩm trên màn hình POS theo từ khóa tìm kiếm và danh mục.
         */
        function filterPosProducts() {
            const searchInput = document.getElementById('pos-search');
            const keyword = searchInput ? searchInput.value.toLowerCase().trim() : '';
            const filtered = posProducts.filter(p => {
                const matchName = p.name.toLowerCase().includes(keyword);
                const matchCat = currentCategory === 'ALL' ||
                                 p.categoryId === currentCategory ||
                                 (p.categoryName && p.categoryName.toLowerCase() === currentCategory.toLowerCase());
                return matchName && matchCat;
            });
            renderCatalog(filtered);
        }

        function setCategoryFilter(cat, btn) {
            currentCategory = cat;
            document.querySelectorAll('.pos-cat-btn').forEach(b => {
                b.className = 'pos-cat-btn px-4 py-2.5 rounded-xl text-sm font-bold bg-gray-100 hover:bg-gray-200 text-gray-700 transition flex-shrink-0 flex items-center gap-1.5';
            });
            if (btn) {
                btn.className = 'pos-cat-btn active px-4 py-2.5 rounded-xl text-sm font-bold bg-[#4F392E] text-white transition flex-shrink-0 shadow-sm flex items-center gap-1.5';
            }
            filterPosProducts();
        }

        /**
         * Thêm món vào hóa đơn thu ngân POS.
         */
        function addItemToPosTicket(prod) {
            const existing = posCart.find(i => i.id === prod.id);
            if (existing) {
                existing.qty++;
            } else {
                posCart.push({
                    id: prod.id,
                    name: prod.name,
                    price: prod.price,
                    qty: 1
                });
            }
            renderTicket();
            showToast('Đã thêm món', `+1 "${prod.name}" vào hóa đơn tại quầy`, 'info', 1500);
        }

        function changeTicketQty(id, delta) {
            const item = posCart.find(i => i.id === id);
            if (!item) return;

            item.qty += delta;
            if (item.qty <= 0) {
                posCart = posCart.filter(i => i.id !== id);
            }
            renderTicket();
        }

        /**
         * Render danh sách món trong hóa đơn POS bên phải và tính tổng tiền.
         */
        function renderTicket() {
            const container = document.getElementById('pos-ticket-items');
            container.innerHTML = '';

            if (posCart.length === 0) {
                container.innerHTML = `
                    <div id="pos-empty-cart-message" class="text-center py-10 text-gray-400 text-sm">
                        <i class="fi fi-rr-shopping-bag text-4xl mx-auto mb-2 text-gray-300 block"></i>
                        <span class="font-medium">Chưa có món nào trong hóa đơn.<br />Chạm vào món bên trái để thêm!</span>
                    </div>
                `;
            } else {
                posCart.forEach(item => {
                    const row = document.createElement('div');
                    row.className = 'pt-2.5 flex items-center justify-between gap-2.5';
                    row.innerHTML = `
                        <div class="flex-1 min-w-0">
                            <span class="font-extrabold text-sm text-gray-900 truncate block">${item.name}</span>
                            <span class="text-xs text-gray-500 font-medium">${item.price.toLocaleString('vi-VN')} đ/phần</span>
                        </div>
                        <div class="flex items-center gap-1.5">
                            <button type="button" onclick="changeTicketQty('${item.id}', -1)" class="w-7 h-7 rounded-lg bg-gray-100 hover:bg-gray-200 text-gray-800 flex items-center justify-center font-bold text-sm">-</button>
                            <span class="text-sm font-black w-6 text-center text-gray-900">${item.qty}</span>
                            <button type="button" onclick="changeTicketQty('${item.id}', 1)" class="w-7 h-7 rounded-lg bg-red-highland text-white flex items-center justify-center font-bold text-sm">+</button>
                        </div>
                        <span class="font-black text-sm text-gray-900 min-w-[70px] text-right">${(item.price * item.qty).toLocaleString('vi-VN')} đ</span>
                    `;
                    container.appendChild(row);
                });
            }

            const subtotal = posCart.reduce((sum, i) => sum + (i.price * i.qty), 0);
            document.getElementById('pos-subtotal').textContent = `${subtotal.toLocaleString('vi-VN')} đ`;
            document.getElementById('pos-total').textContent = `${subtotal.toLocaleString('vi-VN')} đ`;
            calculateChange();
        }

        function setOrderType(type) {
            orderType = type;
            const btnDine = document.getElementById('btn-dine-in');
            const btnTake = document.getElementById('btn-take-away');

            if (type === 'DINE_IN') {
                btnDine.className = 'px-3 py-1.5 rounded-lg bg-white shadow-sm text-gray-900 font-bold transition';
                btnTake.className = 'px-3 py-1.5 rounded-lg text-gray-500 hover:text-gray-900 font-bold transition';
            } else {
                btnTake.className = 'px-3 py-1.5 rounded-lg bg-white shadow-sm text-gray-900 font-bold transition';
                btnDine.className = 'px-3 py-1.5 rounded-lg text-gray-500 hover:text-gray-900 font-bold transition';
            }
        }

        function setPosPaymentMethod(method) {
            currentPosPayment = method;
            const btnCash = document.getElementById('btn-pay-cash');
            const btnVn = document.getElementById('btn-pay-vnpay');
            const drawer = document.getElementById('cash-drawer-box');

            if (method === 'CASH') {
                btnCash.className = 'py-3 px-3.5 rounded-2xl border-2 border-red-highland bg-red-50 text-red-highland font-black text-sm flex items-center justify-center gap-2 transition shadow-sm';
                btnVn.className = 'py-3 px-3.5 rounded-2xl border border-gray-300 bg-white text-gray-700 font-bold text-sm flex items-center justify-center gap-2 transition hover:bg-gray-50';
                drawer.classList.remove('hidden');
            } else {
                btnVn.className = 'py-3 px-3.5 rounded-2xl border-2 border-blue-600 bg-blue-50 text-blue-700 font-black text-sm flex items-center justify-center gap-2 transition shadow-sm';
                btnCash.className = 'py-3 px-3.5 rounded-2xl border border-gray-300 bg-white text-gray-700 font-bold text-sm flex items-center justify-center gap-2 transition hover:bg-gray-50';
                drawer.classList.add('hidden');
            }
        }

        function setQuickCash(amount) {
            document.getElementById('cash-given').value = amount;
            calculateChange();
        }

        function calculateChange() {
            const total = posCart.reduce((sum, i) => sum + (i.price * i.qty), 0);
            const given = parseFloat(document.getElementById('cash-given').value) || 0;
            const change = given - total;
            const changeEl = document.getElementById('cash-change');

            if (change >= 0) {
                changeEl.textContent = `${change.toLocaleString('vi-VN')} đ`;
                changeEl.className = 'text-lg font-black text-emerald-600';
            } else {
                changeEl.textContent = `Thiếu ${Math.abs(change).toLocaleString('vi-VN')} đ`;
                changeEl.className = 'text-lg font-black text-rose-600';
            }
        }

        function clearPosTicket() {
            posCart = [];
            document.getElementById('cash-given').value = '';
            document.getElementById('cash-change').textContent = '0 đ';
            const noteInput = document.getElementById('pos-note-input');
            if (noteInput) noteInput.value = '';
            renderTicket();
            clearCustomer();
        }

        function checkoutPosOrder() {
            if (posCart.length === 0) {
                showToast('Hóa đơn trống', 'Vui lòng chọn ít nhất 1 món vào hóa đơn trước khi thanh toán!', 'warning');
                return;
            }
            completePosTransaction(currentPosPayment);
        }

        /**
         * Tìm kiếm tài khoản khách hàng thành viên qua Auth.API (Port 5001) khi tạo đơn tại quầy.
         */
        async function searchCustomer(query) {
            clearTimeout(customerSearchTimeout);
            const dropdown = document.getElementById('customer-dropdown');
            if (!dropdown) return;

            if (!query || query.trim().length === 0) {
                dropdown.classList.add('hidden');
                lastSearchResults = [];
                return;
            }

            dropdown.innerHTML = `
                <div class="p-3.5 text-xs text-gray-500 text-center flex items-center justify-center gap-2">
                    <span>Đang tìm kiếm khách hàng...</span>
                </div>`;
            dropdown.classList.remove('hidden');

            customerSearchTimeout = setTimeout(async () => {
                try {
                    const token = localStorage.getItem('auth_token');
                    const headers = token ? { 'Authorization': `Bearer ${token}` } : {};

                    const res = await fetch(`${API_GATEWAY_URL}/api/users/search?q=${encodeURIComponent(query.trim())}&pageSize=10`, {
                        headers: headers
                    });

                    if (!res.ok) {
                        dropdown.innerHTML = `
                            <div class="p-3 text-xs text-gray-500 text-center italic">
                                Tên "${query}" sẽ được lưu cho khách lẻ tại quầy.
                            </div>`;
                        return;
                    }

                    const json = await res.json();
                    const rawUsers = json.data?.items || json.data || [];
                    const users = (Array.isArray(rawUsers) ? rawUsers : []).filter(u => {
                        const role = (u.roleName || u.role || 'Customer').toLowerCase();
                        return role === 'customer';
                    });
                    lastSearchResults = users;

                    if (lastSearchResults.length === 0) {
                        dropdown.innerHTML = `
                            <div class="p-3.5 text-xs text-gray-500 text-center italic">
                                Không tìm thấy tài khoản thành viên.<br />
                                <span class="text-gray-800 font-bold">Tên "${query}" sẽ được lưu làm khách lẻ.</span>
                            </div>`;
                        return;
                    }

                    dropdown.innerHTML = lastSearchResults.map(u => {
                        const name = (u.fullName || u.email || 'Khách hàng').replace(/'/g, '&#39;');
                        const phone = (u.phoneNumber || u.phone || '').replace(/'/g, '&#39;');
                        const email = (u.email || '').replace(/'/g, '&#39;');
                        const initial = (name || '?')[0].toUpperCase();
                        return `
                        <div onclick="selectCustomer('${u.id}', '${name}', '${phone}', '${email}')"
                             class="p-3 hover:bg-red-50/70 cursor-pointer flex items-center justify-between text-sm transition border-b border-gray-100 last:border-b-0 group">
                            <div class="flex items-center gap-3 min-w-0">
                                <span class="w-9 h-9 rounded-full bg-red-highland text-white flex items-center justify-center text-xs font-black flex-shrink-0 shadow-sm">${initial}</span>
                                <div class="truncate">
                                    <div class="font-extrabold text-sm text-gray-900 group-hover:text-red-highland transition truncate">${u.fullName || '(Chưa đặt tên)'}</div>
                                    <div class="text-xs text-gray-500 flex items-center gap-1.5 flex-wrap">
                                        ${phone ? `<span class="font-bold text-emerald-700 bg-emerald-50 px-1.5 py-0.5 rounded border border-emerald-200">SĐT: ${phone}</span>` : ''}
                                        ${email ? `<span class="text-gray-400 truncate text-[11px]">${email}</span>` : ''}
                                    </div>
                                </div>
                            </div>
                            <span class="px-3 py-1.5 rounded-xl text-xs font-black text-white bg-red-highland">Chọn</span>
                        </div>
                    `;}).join('');
                } catch (e) {
                    dropdown.classList.add('hidden');
                }
            }, 200);
        }

        function selectFirstCustomer() {
            if (lastSearchResults && lastSearchResults.length > 0) {
                const u = lastSearchResults[0];
                selectCustomer(u.id, u.fullName || u.email, u.phoneNumber || u.phone || '', u.email || '');
            }
        }

        function selectCustomer(id, name, phone, email) {
            posCustomer = { id: id, name: name, phone: phone, email: email };
            document.getElementById('pos-customer-search').value = name;
            document.getElementById('customer-dropdown').classList.add('hidden');
            document.getElementById('selected-customer-name').textContent = name;
            document.getElementById('selected-customer-phone').textContent = phone ? `SĐT: ${phone}` : 'Chưa có SĐT';
            document.getElementById('selected-customer-email').textContent = email ? `• ${email}` : '';
            document.getElementById('selected-customer-badge').classList.remove('hidden');
        }

        function clearCustomer() {
            posCustomer = null;
            lastSearchResults = [];
            document.getElementById('pos-customer-search').value = '';
            document.getElementById('selected-customer-badge').classList.add('hidden');
            document.getElementById('customer-dropdown').classList.add('hidden');
        }

        document.addEventListener('click', (e) => {
            if (!e.target.closest('#pos-customer-search') && !e.target.closest('#customer-dropdown')) {
                document.getElementById('customer-dropdown')?.classList.add('hidden');
            }
        });

        /**
         * [Mục 22 & Mục 28]: Nhân viên tạo đơn tại quán (POST /api/orders).
         * - Nếu chọn CASH: Đơn tự động xác nhận đã thu tiền mặt và chuyển sang PROCESSING (Đang pha chế).
         * - Nếu chọn VNPAY: Hiển thị ngay Modal Mã QR VNPay tại quầy để khách quét hoặc mở cổng thanh toán.
         */
        async function completePosTransaction(method) {
            const total = posCart.reduce((sum, i) => sum + (i.price * i.qty), 0);
            const token = localStorage.getItem('auth_token');

            if (!token) {
                showToast('Chưa đăng nhập', 'Vui lòng đăng nhập tài khoản Nhân viên (Staff) để tạo đơn!', 'error');
                return;
            }

            const typedCustomerName = document.getElementById('pos-customer-search')?.value?.trim();
            const customNote = document.getElementById('pos-note-input')?.value?.trim();
            const baseNote = orderType === 'DINE_IN' ? 'Uống tại quán (POS)' : 'Khách mang về (POS)';

            const payload = {
                customerId: posCustomer ? posCustomer.id : null,
                customerName: posCustomer ? posCustomer.name : (typedCustomerName || null),
                items: posCart.map(item => ({
                    productId: item.id,
                    productName: item.name,
                    unitPrice: item.price,
                    quantity: item.qty
                })),
                discountAmount: 0,
                paymentMethod: method,
                note: customNote ? `${baseNote} | ${customNote}` : baseNote,
                returnUrl: window.location.origin + '/Staff/Orders?view=orders'
            };

            try {
                const res = await fetch(`${API_GATEWAY_URL}/api/orders`, {
                    method: 'POST',
                    headers: {
                        'Content-Type': 'application/json',
                        'Authorization': `Bearer ${token}`
                    },
                    body: JSON.stringify(payload)
                });

                const data = await res.json().catch(() => null);
                const created = data?.data || {};

                if (!res.ok || data?.isSuccess === false) {
                    const msg = data?.message || (data?.errors && data.errors[0]) || 'Không thể tạo đơn hàng tại quầy.';
                    showToast('Lỗi tạo đơn', msg, 'error');
                    return;
                }

                clearPosTicket();
                await loadPosOrdersList();

                // Nếu chọn thanh toán VNPAY: Hiển thị Modal QR VNPay ngay tại quầy POS (Mục 28)
                if (method === 'VNPAY') {
                    const vnpayUrl = created?.vnPayPayment?.paymentUrl;
                    if (vnpayUrl) {
                        showStaffVnPayQrModal(created.orderCode, created.finalAmount || total, vnpayUrl);
                        return;
                    }
                }

                showToast('Tạo đơn thành công', `Đơn #${created.orderCode} (${total.toLocaleString('vi-VN')} đ) đã chuyển sang Pha chế!`, 'success');
            } catch (e) {
                console.error(e);
                showToast('Lỗi kết nối', 'Không thể kết nối đến máy chủ Order.API (Port 5003).', 'error');
            }
        }

        /**
         * Chuyển đổi qua lại giữa View 1 (Bán hàng POS) và View 2 (Điều phối đơn hàng).
         */
        function switchView(view) {
            const posView = document.getElementById('view-pos');
            const ordersView = document.getElementById('view-orders');
            const btnPos = document.getElementById('tab-btn-pos');
            const btnOrders = document.getElementById('tab-btn-orders');

            if (view === 'pos') {
                posView.classList.remove('hidden');
                ordersView.classList.add('hidden');
                btnPos.className = 'px-5 py-2.5 rounded-xl bg-white text-gray-900 shadow-sm transition flex items-center gap-2';
                btnOrders.className = 'px-5 py-2.5 rounded-xl text-gray-600 hover:text-gray-900 transition flex items-center gap-2';
            } else {
                ordersView.classList.remove('hidden');
                posView.classList.add('hidden');
                btnOrders.className = 'px-5 py-2.5 rounded-xl bg-white text-gray-900 shadow-sm transition flex items-center gap-2';
                btnPos.className = 'px-5 py-2.5 rounded-xl text-gray-600 hover:text-gray-900 transition flex items-center gap-2';
                loadPosOrdersList();
            }
        }

        /**
         * [Mục 23 & Mục 25 - View Order List & Search/Filter Order]:
         * Tải danh sách toàn bộ đơn hàng từ Order.API kèm bộ lọc trạng thái & từ khóa tìm kiếm.
         */
        async function loadPosOrdersList() {
            const tbody = document.getElementById('pos-orders-table-body');
            if (!tbody) return;

            const token = localStorage.getItem('auth_token');
            if (!token) return;

            try {
                const queryParams = new URLSearchParams({
                    pageNumber: '1',
                    pageSize: '100'
                });
                if (staffOrdersStatusFilter) {
                    queryParams.set('status', staffOrdersStatusFilter);
                }
                if (staffOrdersSearchQuery) {
                    queryParams.set('orderCode', staffOrdersSearchQuery);
                }

                const res = await fetch(`${API_GATEWAY_URL}/api/orders?${queryParams.toString()}`, {
                    headers: {
                        'Authorization': `Bearer ${token}`
                    }
                });

                if (res.ok) {
                    const data = await res.json();
                    const items = data.data?.items || data.data || [];
                    if (Array.isArray(items)) {
                        posOrders = items.map(o => ({
                            id: o.id,
                            rawOrderCode: o.orderCode || o.id.substring(0, 8).toUpperCase(),
                            orderCode: o.orderCode ? `#${o.orderCode}` : `#${o.id.substring(0, 8).toUpperCase()}`,
                            customerName: o.customerName || 'Khách vãng lai',
                            itemsSummary: o.itemsSummary || `${o.totalItems || 1} món`,
                            totalAmount: o.finalAmount || o.totalAmount || 0,
                            paymentMethod: (o.paymentMethod || 'CASH').toUpperCase(),
                            paymentStatus: (o.paymentStatus || 'PENDING').toUpperCase(),
                            status: (o.status || 'PENDING').toUpperCase(),
                            note: o.note || '',
                            cancelReason: o.cancelReason || '',
                            createdAt: o.createdAt
                        }));
                    }
                }
            } catch (err) {
                console.error('Không thể tải danh sách đơn hàng từ Order.API:', err);
            }

            tbody.innerHTML = '';

            // Cập nhật số lượng đơn đang cần xử lý lên huy hiệu (badge)
            const activeCount = posOrders.filter(o => o.status === 'PENDING' || o.status === 'PROCESSING' || o.status === 'SHIPPING').length;
            const badge = document.getElementById('pending-orders-badge');
            if (badge) badge.innerText = activeCount;

            if (posOrders.length === 0) {
                tbody.innerHTML = `
                    <tr>
                        <td colspan="7" class="py-12 text-center text-gray-400 font-medium">
                            <i class="fi fi-rr-inbox text-3xl block mb-2 text-gray-300"></i>
                            Không có đơn hàng nào khớp với bộ lọc hiện tại
                        </td>
                    </tr>
                `;
                return;
            }

            posOrders.forEach(ord => {
                const tr = document.createElement('tr');
                tr.className = 'hover:bg-gray-50 transition';

                let statusBadge = '';
                let nextStepBtn = '';
                const canCancel = ord.status !== 'COMPLETED' && ord.status !== 'CANCELLED';
                const isPaid = ord.paymentStatus === 'SUCCESS' || ord.paymentStatus === 'PAID';

                // [Mục 26 - Update Order Status]: Luồng chuyển trạng thái tuần tự Pending -> Processing -> Shipping -> Completed
                if (ord.status === 'PENDING') {
                    statusBadge = '<span class="px-3 py-1 rounded-full text-xs font-black bg-amber-100 text-amber-900 border border-amber-200 inline-flex items-center gap-1.5"><i class="fi fi-rr-hourglass-end text-[11px]"></i><span>Pending</span></span>';
                    nextStepBtn = `
                        <button type="button" onclick="updateOrderStatus('${ord.id}', 'PROCESSING')" class="px-3 py-2 rounded-xl bg-blue-600 hover:bg-blue-700 text-white font-bold text-xs shadow-sm transition active:scale-95 flex items-center gap-1.5" title="Chuyển từ Pending sang Processing (Pha chế)">
                            <i class="fi fi-rr-coffee"></i>
                            <span>Pha chế</span>
                        </button>
                    `;
                } else if (ord.status === 'PROCESSING' || ord.status === 'CONFIRMED') {
                    statusBadge = '<span class="px-3 py-1 rounded-full text-xs font-black bg-blue-100 text-blue-900 border border-blue-200 inline-flex items-center gap-1.5"><i class="fi fi-rr-coffee text-[11px]"></i><span>Processing</span></span>';
                    nextStepBtn = `
                        <button type="button" onclick="updateOrderStatus('${ord.id}', 'SHIPPING')" class="px-3 py-2 rounded-xl bg-purple-600 hover:bg-purple-700 text-white font-bold text-xs shadow-sm transition active:scale-95 flex items-center gap-1.5" title="Chuyển từ Processing sang Shipping (Giao hàng)">
                            <i class="fi fi-rr-motorcycle"></i>
                            <span>Giao hàng</span>
                        </button>
                    `;
                } else if (ord.status === 'SHIPPING' || ord.status === 'DELIVERING') {
                    statusBadge = '<span class="px-3 py-1 rounded-full text-xs font-black bg-purple-100 text-purple-900 border border-purple-200 inline-flex items-center gap-1.5"><i class="fi fi-rr-paper-plane text-[11px]"></i><span>Shipping</span></span>';
                    nextStepBtn = `
                        <button type="button" onclick="updateOrderStatus('${ord.id}', 'COMPLETED')" class="px-3 py-2 rounded-xl bg-emerald-600 hover:bg-emerald-700 text-white font-bold text-xs shadow-sm transition active:scale-95 flex items-center gap-1.5" title="Chuyển từ Shipping sang Completed (Hoàn thành)">
                            <i class="fi fi-rr-check"></i>
                            <span>Hoàn thành</span>
                        </button>
                    `;
                } else if (ord.status === 'COMPLETED') {
                    statusBadge = '<span class="px-3 py-1 rounded-full text-xs font-black bg-emerald-100 text-emerald-900 border border-emerald-200 inline-flex items-center gap-1.5"><i class="fi fi-rr-check text-[11px]"></i><span>Completed</span></span>';
                    nextStepBtn = `<span class="text-xs text-emerald-700 font-bold italic">Đã hoàn tất</span>`;
                } else {
                    statusBadge = '<span class="px-3 py-1 rounded-full text-xs font-black bg-rose-100 text-rose-900 border border-rose-200 inline-flex items-center gap-1.5"><i class="fi fi-rr-cross-circle text-[11px]"></i><span>Cancelled</span></span>';
                    nextStepBtn = `<span class="text-xs text-rose-500 font-bold italic" title="${ord.cancelReason}">Đã hủy</span>`;
                }

                tr.innerHTML = `
                    <td class="py-4 px-4 font-black font-mono text-red-highland text-sm">${ord.orderCode}</td>
                    <td class="py-4 px-4">
                        <div class="flex items-center gap-2">
                            <span class="w-7 h-7 rounded-full bg-gray-200 flex items-center justify-center text-xs font-black text-gray-600 flex-shrink-0">${(ord.customerName || 'K')[0].toUpperCase()}</span>
                            <span class="font-semibold text-gray-900 text-sm truncate max-w-[140px]">${ord.customerName}</span>
                        </div>
                    </td>
                    <td class="py-4 px-4 font-semibold text-gray-900 max-w-xs text-sm">
                        <div>${ord.itemsSummary}</div>
                        ${ord.note ? `<div class="text-[11px] text-amber-700 italic truncate max-w-[220px]">${ord.note}</div>` : ''}
                    </td>
                    <td class="py-4 px-4 font-black text-gray-900 text-sm">${ord.totalAmount.toLocaleString('vi-VN')} đ</td>
                    <td class="py-4 px-4">
                        ${isPaid ? `
                            <span class="px-2.5 py-1 rounded-lg text-xs font-bold inline-flex items-center gap-1.5 bg-emerald-50 text-emerald-800 border border-emerald-200">
                                <i class="fi fi-rr-check-circle text-xs text-emerald-600"></i>
                                <span>${PAY_METHOD_VI[ord.paymentMethod] || ord.paymentMethod} (Đã thu)</span>
                            </span>
                        ` : `
                            <div class="flex items-center gap-1.5 flex-wrap">
                                <span class="px-2.5 py-1 rounded-lg text-xs font-bold inline-flex items-center gap-1.5 bg-amber-50 text-amber-800 border border-amber-200">
                                    <span>${PAY_METHOD_VI[ord.paymentMethod] || ord.paymentMethod} (Chờ thu)</span>
                                </span>
                                ${canCancel && ord.paymentMethod === 'CASH' ? `
                                    <!-- Mục 29: Staff xác nhận thu tiền mặt -->
                                    <button type="button" onclick="confirmCashPayment('${ord.id}')" class="px-2.5 py-1 rounded-lg bg-emerald-600 hover:bg-emerald-700 text-white font-bold text-[11px] shadow-sm transition active:scale-95" title="Mục 29: Xác nhận đã thu tiền mặt">
                                        Thu tiền mặt
                                    </button>
                                ` : ''}
                                ${canCancel ? `
                                    <!-- Mục 28: Staff tạo mã QR VNPay cho đơn hàng -->
                                    <button type="button" onclick="generateStaffVnPayQr('${ord.id}')" class="px-2.5 py-1 rounded-lg bg-blue-600 hover:bg-blue-700 text-white font-bold text-[11px] shadow-sm transition active:scale-95" title="Mục 28: Tạo mã QR VNPay cho đơn hàng">
                                        Tạo QR VNPay
                                    </button>
                                ` : ''}
                            </div>
                        `}
                    </td>
                    <td class="py-4 px-4">${statusBadge}</td>
                    <td class="py-4 px-4 text-center">
                        <div class="flex items-center justify-center gap-2 flex-wrap">
                            <!-- Mục 24: Xem chi tiết đơn -->
                            <button type="button" onclick="viewOrderDetailModal('${ord.id}')" class="p-2 rounded-xl bg-gray-100 hover:bg-gray-200 text-gray-700 transition" title="Mục 24: Xem chi tiết đơn hàng">
                                <i class="fi fi-rr-eye text-base flex items-center"></i>
                            </button>
                            <!-- Mục 26: Cập nhật trạng thái kế tiếp -->
                            ${nextStepBtn}
                            <!-- Mục 27: Staff hủy đơn kèm lý do bắt buộc -->
                            ${canCancel ? `
                                <button type="button" onclick="openStaffCancelModal('${ord.id}', '${ord.orderCode}')" class="p-2 rounded-xl bg-rose-50 hover:bg-rose-100 text-rose-600 border border-rose-200 transition" title="Mục 27: Hủy đơn kèm lý do">
                                    <i class="fi fi-rr-cross-circle text-base flex items-center"></i>
                                </button>
                            ` : ''}
                        </div>
                    </td>
                `;

                tbody.appendChild(tr);
            });
        }

        /**
         * [Mục 26 - Update Order Status]: Nhân viên cập nhật trạng thái đơn hàng tuần tự:
         * Pending -> Processing -> Shipping -> Completed.
         */
        async function updateOrderStatus(orderId, nextStatus) {
            const token = localStorage.getItem('auth_token');
            try {
                const res = await fetch(`${API_GATEWAY_URL}/api/orders/${orderId}/status`, {
                    method: 'PUT',
                    headers: {
                        'Content-Type': 'application/json',
                        'Authorization': `Bearer ${token}`
                    },
                    body: JSON.stringify({ status: nextStatus })
                });

                const data = await res.json().catch(() => null);
                if (!res.ok || data?.isSuccess === false) {
                    showToast('Lỗi cập nhật trạng thái', data?.message || 'Không thể chuyển trạng thái đơn hàng.', 'error');
                    return;
                }

                showToast('Đã cập nhật trạng thái', `Đơn hàng đã chuyển sang "${STATUS_VI[nextStatus] || nextStatus}"`, 'success');
                await loadPosOrdersList();
            } catch (e) {
                console.error(e);
                showToast('Lỗi kết nối', 'Không thể kết nối đến máy chủ Order.API', 'error');
            }
        }

        /**
         * [Mục 24 - View Order Detail]: Nhân viên xem chi tiết các món (items), tùy chọn và giá tiền trong đơn.
         */
        async function viewOrderDetailModal(orderId) {
            const token = localStorage.getItem('auth_token');
            try {
                const res = await fetch(`${API_GATEWAY_URL}/api/orders/${orderId}`, {
                    headers: {
                        'Authorization': `Bearer ${token}`
                    }
                });

                if (!res.ok) {
                    showToast('Lỗi tải chi tiết', 'Không thể tải thông tin chi tiết đơn hàng.', 'error');
                    return;
                }

                const resJson = await res.json();
                const order = resJson.data || resJson;
                if (!order) return;

                staffCurrentDetailOrder = order;

                document.getElementById('detail-order-code').innerText = order.orderCode ? `#${order.orderCode}` : `#${order.id.substring(0, 8).toUpperCase()}`;

                const d = new Date(order.createdAt);
                document.getElementById('detail-order-time').innerText = d.toLocaleDateString('vi-VN', {
                    hour: '2-digit', minute: '2-digit', day: '2-digit', month: '2-digit', year: 'numeric'
                });

                const statusUpper = (order.status || '').toUpperCase();
                document.getElementById('detail-order-status').innerText = STATUS_VI[statusUpper] || order.status || 'Không rõ';

                const pmVI = PAY_METHOD_VI[(order.paymentMethod || '').toUpperCase()] || order.paymentMethod || 'Tiền mặt';
                const psUpper = (order.paymentStatus || '').toUpperCase();
                const psVI = PAY_STATUS_VI[psUpper] || order.paymentStatus || 'Chưa thanh toán';
                document.getElementById('detail-order-payment').innerText = `${pmVI} — ${psVI}`;

                document.getElementById('detail-order-subtotal').innerText = `${(order.totalAmount || 0).toLocaleString('vi-VN')} đ`;
                document.getElementById('detail-order-discount').innerText = `-${(order.discountAmount || 0).toLocaleString('vi-VN')} đ`;
                document.getElementById('detail-order-total').innerText = `${(order.finalAmount || order.totalAmount || 0).toLocaleString('vi-VN')} đ`;

                const customerNameEl = document.getElementById('detail-customer-name');
                if (customerNameEl) customerNameEl.innerText = order.customerName || 'Khách vãng lai';

                const cancelBox = document.getElementById('detail-cancel-reason-box');
                if (statusUpper === 'CANCELLED' && order.cancelReason) {
                    cancelBox.classList.remove('hidden');
                    document.getElementById('detail-cancel-reason-text').innerText = order.cancelReason;
                } else {
                    cancelBox.classList.add('hidden');
                }

                const itemsBox = document.getElementById('detail-items-list');
                if (order.items && order.items.length > 0) {
                    itemsBox.innerHTML = order.items.map(item => `
                        <div class="py-2.5 px-3 flex items-center justify-between text-xs">
                            <div>
                                <div class="font-bold text-gray-900">${item.productName || 'Đồ uống'}</div>
                                <div class="text-gray-500">${item.optionsSummary || 'Tiêu chuẩn'}</div>
                            </div>
                            <div class="text-right">
                                <div class="font-black text-gray-900">${(item.subtotal || item.unitPrice * item.quantity).toLocaleString('vi-VN')} đ</div>
                                <div class="text-gray-500">x${item.quantity} (${(item.unitPrice || 0).toLocaleString('vi-VN')} đ)</div>
                            </div>
                        </div>
                    `).join('');
                } else {
                    itemsBox.innerHTML = `<div class="p-3 text-xs text-gray-500 italic text-center">Không có dữ liệu món</div>`;
                }

                const noteBox = document.getElementById('detail-note-box');
                if (order.note) {
                    noteBox.classList.remove('hidden');
                    document.getElementById('detail-order-note').innerText = order.note;
                } else {
                    noteBox.classList.add('hidden');
                }

                const canCancel = statusUpper !== 'COMPLETED' && statusUpper !== 'CANCELLED';
                const isPaid = psUpper === 'SUCCESS' || psUpper === 'PAID';
                const btnCancel = document.getElementById('detail-btn-staff-cancel');
                const btnQr = document.getElementById('detail-btn-staff-qr');

                if (canCancel) btnCancel.classList.remove('hidden');
                else btnCancel.classList.add('hidden');

                if (canCancel && !isPaid) btnQr.classList.remove('hidden');
                else btnQr.classList.add('hidden');

                const modal = document.getElementById('modal-order-detail');
                modal.classList.remove('hidden');
                modal.classList.add('flex');
            } catch (e) {
                console.error(e);
                showToast('Lỗi kết nối', 'Không thể kết nối máy chủ khi tải chi tiết đơn.', 'error');
            }
        }

        function closeOrderDetailModal() {
            const modal = document.getElementById('modal-order-detail');
            modal.classList.add('hidden');
            modal.classList.remove('flex');
            staffCurrentDetailOrder = null;
        }

        /**
         * [Mục 25 - Search & Filter Order]: Lọc trạng thái & tìm kiếm đơn hàng dành cho Staff.
         */
        function setStaffOrdersStatusFilter(status, btnEl) {
            staffOrdersStatusFilter = status;
            document.querySelectorAll('#staff-orders-filter-pills .staff-filter-btn').forEach(b => {
                b.classList.remove('active', 'bg-gray-900', 'text-white');
                b.classList.add('bg-white', 'text-gray-700');
            });
            if (btnEl) {
                btnEl.classList.remove('bg-white', 'text-gray-700');
                btnEl.classList.add('active', 'bg-gray-900', 'text-white');
            }
            loadPosOrdersList();
        }

        function onStaffOrdersSearch(query) {
            staffOrdersSearchQuery = query ? query.trim() : '';
            loadPosOrdersList();
        }

        /**
         * [Mục 27 - Cancel Order]: Nhân viên hủy đơn hàng kèm lý do bắt buộc.
         */
        function openStaffCancelModal(orderId, orderCode) {
            staffPendingCancelOrderId = orderId;
            document.getElementById('staff-cancel-order-code').innerText = orderCode || orderId;
            document.getElementById('staff-cancel-reason-select').value = 'Hết nguyên liệu pha chế món này';
            document.getElementById('staff-custom-reason-box').classList.add('hidden');
            document.getElementById('staff-cancel-custom-reason').value = '';
            const modal = document.getElementById('modal-staff-cancel');
            modal.classList.remove('hidden');
            modal.classList.add('flex');
        }

        function openStaffCancelModalFromDetail() {
            if (!staffCurrentDetailOrder) return;
            const oid = staffCurrentDetailOrder.id;
            const ocode = staffCurrentDetailOrder.orderCode ? `#${staffCurrentDetailOrder.orderCode}` : `#${oid}`;
            closeOrderDetailModal();
            openStaffCancelModal(oid, ocode);
        }

        function closeStaffCancelModal() {
            const modal = document.getElementById('modal-staff-cancel');
            modal.classList.add('hidden');
            modal.classList.remove('flex');
            staffPendingCancelOrderId = null;
        }

        function toggleStaffCustomReason(val) {
            const box = document.getElementById('staff-custom-reason-box');
            if (val === 'OTHER') box.classList.remove('hidden');
            else box.classList.add('hidden');
        }

        async function submitStaffCancelOrder() {
            if (!staffPendingCancelOrderId) return;
            const token = localStorage.getItem('auth_token');
            const selectVal = document.getElementById('staff-cancel-reason-select').value;
            let reason = selectVal;
            if (selectVal === 'OTHER') {
                const custom = document.getElementById('staff-cancel-custom-reason').value.trim();
                if (!custom) {
                    showToast('Thiếu lý do hủy', 'Nhân viên bắt buộc phải nhập lý do hủy đơn cụ thể!', 'warning');
                    return;
                }
                reason = custom;
            }

            const btn = document.getElementById('btn-staff-submit-cancel');
            btn.disabled = true;
            btn.innerHTML = 'Đang hủy đơn...';

            try {
                const res = await fetch(`${API_GATEWAY_URL}/api/orders/${staffPendingCancelOrderId}/cancel`, {
                    method: 'POST',
                    headers: {
                        'Content-Type': 'application/json',
                        'Authorization': `Bearer ${token}`
                    },
                    body: JSON.stringify({ reason: reason })
                });

                const data = await res.json().catch(() => null);
                if (res.ok && data?.isSuccess !== false) {
                    closeStaffCancelModal();
                    showToast('Đã hủy đơn hàng', `Đã hủy đơn với lý do: "${reason}"`, 'warning');
                    await loadPosOrdersList();
                } else {
                    const msg = data?.message || (data?.errors && data.errors[0]) || 'Không thể hủy đơn hàng.';
                    showToast('Lỗi hủy đơn', msg, 'error');
                }
            } catch (e) {
                console.error('Lỗi khi hủy đơn:', e);
                showToast('Lỗi kết nối', 'Không thể kết nối đến máy chủ Order.API', 'error');
            } finally {
                btn.disabled = false;
                btn.innerHTML = 'Xác nhận hủy đơn';
            }
        }

        /**
         * [Mục 28 - Generate VNPay QR]: Nhân viên tạo mã QR VNPay cho đơn hàng bất kỳ chưa thanh toán.
         */
        async function generateStaffVnPayQr(orderId) {
            const token = localStorage.getItem('auth_token');
            try {
                const res = await fetch(`${API_GATEWAY_URL}/api/payments/vnpay/create-url`, {
                    method: 'POST',
                    headers: {
                        'Content-Type': 'application/json',
                        'Authorization': `Bearer ${token}`
                    },
                    body: JSON.stringify({ orderId: orderId })
                });

                const data = await res.json().catch(() => null);
                const payment = data?.data;
                if (res.ok && payment?.paymentUrl) {
                    showStaffVnPayQrModal(payment.orderCode, payment.amount, payment.paymentUrl);
                } else {
                    showToast('Không thể tạo mã QR', data?.message || 'Không thể tạo mã QR VNPay cho đơn hàng này.', 'error');
                }
            } catch (e) {
                console.error(e);
                showToast('Lỗi kết nối', 'Không thể kết nối máy chủ Order.API khi tạo QR VNPay.', 'error');
            }
        }

        function generateStaffVnPayQrFromDetail() {
            if (!staffCurrentDetailOrder) return;
            const oid = staffCurrentDetailOrder.id;
            closeOrderDetailModal();
            generateStaffVnPayQr(oid);
        }

        function showStaffVnPayQrModal(orderCode, amount, paymentUrl) {
            document.getElementById('staff-qr-ordercode').textContent = `#${orderCode || ''}`;
            document.getElementById('staff-qr-amount').textContent = `${Number(amount || 0).toLocaleString('vi-VN')} đ`;
            document.getElementById('staff-qr-gateway-link').href = paymentUrl;
            document.getElementById('staff-qr-img').src = `https://api.qrserver.com/v1/create-qr-code/?size=240x240&data=${encodeURIComponent(paymentUrl)}`;

            const modal = document.getElementById('modal-staff-vnpay-qr');
            modal.classList.remove('hidden');
            modal.classList.add('flex');
        }

        function closeStaffVnPayQrModal() {
            const modal = document.getElementById('modal-staff-vnpay-qr');
            modal.classList.add('hidden');
            modal.classList.remove('flex');
        }

        /**
         * [Mục 29 - Confirm Payment]: Nhân viên xác nhận đã thu tiền mặt cho đơn hàng (PUT /api/payments/{id}/cash-confirm).
         */
        async function confirmCashPayment(orderId) {
            const token = localStorage.getItem('auth_token');
            if (!token) {
                showToast('Chưa đăng nhập', 'Vui lòng đăng nhập tài khoản Nhân viên (Staff)', 'error');
                return;
            }
            try {
                const res = await fetch(`${API_GATEWAY_URL}/api/payments/${orderId}/cash-confirm`, {
                    method: 'PUT',
                    headers: {
                        'Content-Type': 'application/json',
                        'Authorization': `Bearer ${token}`
                    },
                    body: JSON.stringify({})
                });
                const data = await res.json().catch(() => null);
                if (res.ok && data?.isSuccess !== false) {
                    showToast('Đã xác nhận thu tiền', 'Xác nhận thanh toán tiền mặt thành công! Đơn đã chuyển sang Pha chế.', 'success');
                    await loadPosOrdersList();
                } else {
                    showToast('Không thành công', data?.message || 'Không thể xác nhận thanh toán tiền mặt.', 'error');
                }
            } catch (e) {
                console.error(e);
                showToast('Lỗi kết nối', 'Không thể kết nối đến máy chủ Order.API', 'error');
            }
        }

        /**
         * [Mục 29B]: Đồng bộ kết quả khi cổng VNPay redirect về màn hình Staff POS.
         */
        async function checkVnPayPosCallback() {
            const params = new URLSearchParams(window.location.search);
            const responseCode = params.get('vnp_ResponseCode');
            const txnRef = params.get('vnp_TxnRef');
            const amount = params.get('vnp_Amount');

            if (responseCode) {
                try {
                    const res = await fetch(`${API_GATEWAY_URL}/api/payments/vnpay-return${window.location.search}`);
                    const json = await res.json().catch(() => null);

                    if (responseCode === '00' && (res.ok || json?.isSuccess)) {
                        const formattedAmt = amount ? (parseInt(amount) / 100).toLocaleString('vi-VN') + ' đ' : '';
                        showToast('Thanh toán VNPay thành công', `Giao dịch ${txnRef || ''} (${formattedAmt}) đã thanh toán thành công!`, 'success', 5000);
                    } else {
                        showToast('Thanh toán chưa hoàn tất', json?.message || 'Giao dịch qua VNPay chưa hoàn tất.', 'warning', 5000);
                    }
                } catch (e) {
                    console.error('Lỗi đồng bộ VNPay Return:', e);
                } finally {
                    window.history.replaceState({}, document.title, window.location.pathname + '?view=orders');
                    switchView('orders');
                }
            }
        }

        // Khởi tạo màn hình Staff khi trang tải xong
        document.addEventListener('DOMContentLoaded', () => {
            const now = new Date();
            const timeEl = document.getElementById('pos-time');
            if (timeEl) timeEl.innerText = now.toLocaleTimeString('vi-VN', { hour: '2-digit', minute: '2-digit' });

            // Hiển thị tên thật của nhân viên đang đăng nhập từ localStorage
            try {
                const userStr = localStorage.getItem('current_user');
                if (userStr) {
                    const user = JSON.parse(userStr);
                    const bEl = document.getElementById('pos-staff-badge');
                    if (bEl && (user.fullName || user.email)) {
                        bEl.innerText = user.fullName || user.email;
                    }
                }
            } catch (e) {}

            loadProductsFromApi();
            renderTicket();
            checkVnPayPosCallback();

            const urlParams = new URLSearchParams(window.location.search);
            if (urlParams.get('view') === 'orders' || urlParams.get('tab') === 'orders') {
                switchView('orders');
            } else {
                switchView('pos');
                loadPosOrdersList();
            }

            // Tự động làm mới danh sách đơn điều phối mỗi 10 giây
            setInterval(() => {
                loadPosOrdersList();
            }, 10000);
        });
    </script>
}
