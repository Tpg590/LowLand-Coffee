            <!-- Danh sách chi tiết các món & giá tiền -->
            <div>
                <h4 class="text-xs font-black uppercase text-gray-500 tracking-wider mb-2.5">Danh sách món & đơn giá</h4>
                <div id="detail-items-list" class="divide-y divide-gray-100 border border-gray-200 rounded-2xl overflow-hidden bg-gray-50/50">
                </div>
            </div>

            <!-- Tổng tiền -->
            <div class="p-4 bg-gray-50 rounded-2xl border border-gray-200 space-y-1.5 text-sm">
                <div class="flex justify-between text-xs text-gray-500">
                    <span>Tạm tính</span>
                    <span id="detail-order-subtotal" class="font-bold text-gray-800">0 đ</span>
                </div>
                <div class="flex justify-between text-xs text-gray-500">
                    <span>Giảm giá</span>
                    <span id="detail-order-discount" class="font-bold text-emerald-600">-0 đ</span>
                </div>
                <div class="pt-1.5 border-t border-gray-200 flex justify-between items-center">
                    <span class="font-bold text-gray-900">Tổng thanh toán</span>
                    <span id="detail-order-total" class="font-black text-red-highland text-xl">0 đ</span>
                </div>
            </div>

            <!-- Ghi chú đơn hàng -->
            <div id="detail-note-box" class="p-3 bg-amber-50 border border-amber-200 rounded-xl text-xs text-amber-900 hidden">
                <span class="font-bold block mb-0.5">Ghi chú đơn hàng:</span>
                <span id="detail-order-note" class="italic"></span>
            </div>
        </div>

        <!-- Chân Modal: Nút Hủy đơn kèm lý do (Mục 27) & Tạo QR VNPay (Mục 28) -->
        <div class="px-6 py-3.5 bg-gray-50 border-t border-gray-100 flex items-center justify-between gap-2">
            <div class="flex items-center gap-2">
                <button type="button" id="detail-btn-staff-cancel" onclick="openStaffCancelModalFromDetail()" class="hidden px-3.5 py-2 rounded-xl bg-rose-50 hover:bg-rose-100 text-rose-700 border border-rose-200 font-bold text-xs flex items-center gap-1.5 transition">
                    <i class="fi fi-rr-cross-circle"></i>
                    <span>Hủy đơn kèm lý do</span>
                </button>
                <button type="button" id="detail-btn-staff-qr" onclick="generateStaffVnPayQrFromDetail()" class="hidden px-3.5 py-2 rounded-xl bg-blue-600 hover:bg-blue-700 text-white font-bold text-xs flex items-center gap-1.5 transition">
                    <i class="fi fi-rr-qrcode"></i>
                    <span>Tạo QR VNPay</span>
                </button>
            </div>
            <button type="button" onclick="closeOrderDetailModal()" class="px-5 py-2 rounded-xl border border-gray-300 hover:bg-gray-200 text-gray-700 font-bold text-sm transition">Đóng</button>
