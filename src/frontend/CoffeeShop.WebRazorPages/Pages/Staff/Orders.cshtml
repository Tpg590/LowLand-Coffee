<!-- MODAL 1: CHI TIẾT ĐƠN HÀNG CHO STAFF (SERVER-RENDERED)                     -->
<!-- ========================================================================= -->
@if (Model.SelectedOrderDetail != null)
{
    var detail = Model.SelectedOrderDetail;
    <div class="fixed inset-0 z-50 flex items-center justify-center bg-black/60 backdrop-blur-sm p-4 overflow-y-auto">
        <div class="bg-white rounded-3xl shadow-2xl border border-slate-200 w-full max-w-2xl overflow-hidden my-8">
            <div class="px-6 py-4 bg-slate-900 text-white flex items-center justify-between">
                <div>
                    <h3 class="text-lg font-black">Chi tiết hóa đơn #@detail.OrderCode</h3>
                    <p class="text-xs text-slate-400">Thời gian tạo: @detail.CreatedAt.ToLocalTime().ToString("dd/MM/yyyy HH:mm")</p>
                </div>
                <a asp-page="/Staff/Orders" asp-route-View="orders" asp-route-Status="@Model.Status" asp-route-Search="@Model.Search"
                   class="w-8 h-8 rounded-full bg-white/10 hover:bg-white/20 flex items-center justify-center text-white">
                    <i class="fi fi-rr-cross-small"></i>
                </a>
            </div>

            <div class="p-6 space-y-5 max-h-[75vh] overflow-y-auto">
                <div class="grid grid-cols-1 sm:grid-cols-2 gap-4">
                    <div class="p-4 rounded-2xl bg-slate-50 border border-slate-200 space-y-1">
                        <div class="text-[11px] font-extrabold uppercase text-slate-400">Thông tin khách &amp; Trạng thái</div>
                        <div class="text-sm font-black text-slate-900">@(string.IsNullOrWhiteSpace(detail.CustomerName) ? "Khách hàng LowLand" : detail.CustomerName)</div>
                        <div class="text-xs font-bold text-blue-700">Trạng thái: @detail.StatusDisplayName</div>
                        @if (!string.IsNullOrWhiteSpace(detail.Note))
                        {
                            <div class="text-xs text-slate-600">Ghi chú: @detail.Note</div>
                        }
                        @if (!string.IsNullOrWhiteSpace(detail.CancelReason))
                        {
                            <div class="text-xs text-red-600 font-bold">Lý do hủy: @detail.CancelReason</div>
                        }
                    </div>

                    <div class="p-4 rounded-2xl bg-slate-50 border border-slate-200 space-y-2">
                        <div class="text-[11px] font-extrabold uppercase text-slate-400">Thanh toán</div>
                        <div class="text-sm font-black text-slate-900">@detail.PaymentMethodDisplayName</div>
                        <div class="text-xs font-extrabold @(detail.IsPaid ? "text-emerald-700" : "text-amber-700")">
                            @detail.PaymentStatusDisplayName
                        </div>
                        @if (!detail.IsPaid && !detail.IsCancelled)
                        {
                            <div class="flex flex-wrap gap-2 pt-1">
                                <form method="post" asp-page-handler="ConfirmCash" class="inline">
                                    <input type="hidden" name="orderId" value="@detail.Id" />
                                    <input type="hidden" name="returnStatus" value="@Model.Status" />
                                    <input type="hidden" name="returnSearch" value="@Model.Search" />
                                    <button type="submit" class="px-3 py-1.5 rounded-xl bg-emerald-600 hover:bg-emerald-700 text-white text-xs font-extrabold">
                                        Thu tiền mặt
                                    </button>
                                </form>
                                <form method="post" asp-page-handler="GenerateQr" class="inline">
                                    <input type="hidden" name="orderId" value="@detail.Id" />
                                    <input type="hidden" name="returnStatus" value="@Model.Status" />
                                    <input type="hidden" name="returnSearch" value="@Model.Search" />
                                    <button type="submit" class="px-3 py-1.5 rounded-xl bg-blue-600 hover:bg-blue-700 text-white text-xs font-extrabold">
                                        Tạo mã QR VNPay
                                    </button>
                                </form>
                            </div>
                        }
                    </div>
                </div>

                <div class="border border-slate-200 rounded-2xl overflow-hidden">
                    <table class="w-full text-sm text-left">
                        <thead class="bg-slate-50 text-xs font-extrabold uppercase text-slate-500 border-b border-slate-200">
                            <tr>
                                <th class="px-4 py-2.5">Món</th>
                                <th class="px-3 py-2.5 text-center">SL</th>
                                <th class="px-4 py-2.5 text-right">Đơn giá</th>
                                <th class="px-4 py-2.5 text-right">Thành tiền</th>
                            </tr>
                        </thead>
                        <tbody class="divide-y divide-slate-100">
                            @foreach (var item in detail.Items)
                            {
                                <tr>
                                    <td class="px-4 py-2.5">
                                        <div class="font-bold text-slate-900">@item.ProductName</div>
                                        @if (!string.IsNullOrWhiteSpace(item.OptionsSummary))
                                        {
                                            <div class="text-xs text-slate-500">@item.OptionsSummary</div>
                                        }
                                    </td>
                                    <td class="px-3 py-2.5 text-center font-bold">x@(item.Quantity)</td>
                                    <td class="px-4 py-2.5 text-right">@item.UnitPrice.ToString("N0") đ</td>
                                    <td class="px-4 py-2.5 text-right font-extrabold">@item.Subtotal.ToString("N0") đ</td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>

                <div class="flex items-center justify-between p-4 rounded-2xl bg-amber-50 border border-amber-200">
                    <div class="text-xs text-slate-600">
                        Tạm tính: <strong>@detail.TotalAmount.ToString("N0") đ</strong> • Giảm giá: <strong class="text-emerald-700">-@detail.DiscountAmount.ToString("N0") đ</strong>
                    </div>
                    <div class="text-lg font-black text-red-highland">
                        Tổng: @detail.FinalAmount.ToString("N0") đ
                    </div>
                </div>
            </div>

            <div class="px-6 py-4 bg-slate-50 border-t border-slate-100 flex justify-end">
                <a asp-page="/Staff/Orders" asp-route-View="orders" asp-route-Status="@Model.Status" asp-route-Search="@Model.Search"
                   class="px-5 py-2 rounded-2xl bg-slate-200 hover:bg-slate-300 text-slate-800 text-xs font-extrabold">
                    Đóng
                </a>
            </div>
        </div>
    </div>
}

