@page "/Staff/Orders"
@model CoffeeShop.WebRazorPages.Pages.Staff.OrdersModel
@{
    Layout = "_StaffLayout";
    ViewData["Title"] = Model.View == "orders" ? "Điều Phối & Quản Lý Đơn Hàng" : "Bán Hàng Tại Quầy (POS)";
}

<div class="space-y-6">
    <!-- Thanh Chuyển Đổi Chế Độ POS / Điều Phối Đơn -->
    <div class="bg-white p-4 rounded-3xl border border-slate-200 shadow-sm flex flex-wrap items-center justify-between gap-4">
        <div class="inline-flex p-1.5 rounded-2xl bg-slate-100 gap-1.5">
            <a asp-page="/Staff/Orders" asp-route-View="pos"
               class="px-5 py-2.5 rounded-xl text-xs sm:text-sm font-extrabold transition flex items-center gap-2 @(Model.View == "pos" ? "bg-red-highland text-white shadow-md" : "text-slate-700 hover:bg-slate-200")">
                <i class="fi fi-rr-shop"></i>
                <span>Quầy POS (Tạo đơn tại quán)</span>
            </a>
            <a asp-page="/Staff/Orders" asp-route-View="orders"
               class="px-5 py-2.5 rounded-xl text-xs sm:text-sm font-extrabold transition flex items-center gap-2 @(Model.View == "orders" ? "bg-red-highland text-white shadow-md" : "text-slate-700 hover:bg-slate-200")">
                <i class="fi fi-rr-clipboard-list"></i>
                <span>Điều phối &amp; Danh sách đơn (@Model.TotalCount)</span>
                @if (Model.PendingCount > 0)
                {
                    <span class="px-2 py-0.5 rounded-full bg-amber-300 text-red-950 text-[11px] font-black">@Model.PendingCount mới</span>
                }
            </a>
        </div>

        <a asp-page="/Staff/Orders" asp-route-View="@Model.View" asp-route-Status="@Model.Status" asp-route-Search="@Model.Search"
           class="px-4 py-2.5 rounded-2xl bg-slate-100 hover:bg-slate-200 text-slate-800 text-xs font-extrabold transition flex items-center gap-2">
            <i class="fi fi-rr-refresh"></i>
            <span>Làm mới dữ liệu</span>
        </a>
    </div>

    <!-- Thông báo phản hồi từ Server (TempData) -->
    @if (!string.IsNullOrWhiteSpace(Model.SuccessMessage))
    {
        <div class="p-4 rounded-2xl bg-emerald-50 border border-emerald-200 text-emerald-800 flex items-center gap-3 shadow-sm">
            <span class="w-8 h-8 rounded-xl bg-emerald-600 text-white flex items-center justify-center shrink-0">
                <i class="fi fi-rr-check"></i>
            </span>
            <span class="text-sm font-bold">@Model.SuccessMessage</span>
        </div>
    }

    @if (!string.IsNullOrWhiteSpace(Model.ErrorMessage))
    {
        <div class="p-4 rounded-2xl bg-red-50 border border-red-200 text-red-800 flex items-center gap-3 shadow-sm">
            <span class="w-8 h-8 rounded-xl bg-red-600 text-white flex items-center justify-center shrink-0">
                <i class="fi fi-rr-exclamation"></i>
            </span>
            <span class="text-sm font-bold">@Model.ErrorMessage</span>
        </div>
    }

    @if (Model.View == "pos")
    {
        <!-- ========================================================================= -->
        <!-- CHẾ ĐỘ 1: QUẦY BÁN HÀNG TẠI QUÁN (POS CREATE ORDER)                        -->
        <!-- ========================================================================= -->
        <div class="grid grid-cols-1 xl:grid-cols-12 gap-6 items-start">
            <!-- Danh mục & Thực đơn sản phẩm (8 cols) -->
            <div class="xl:col-span-8 bg-white rounded-3xl border border-slate-200 p-5 shadow-sm space-y-5">
                <div class="flex flex-col md:flex-row items-stretch md:items-center justify-between gap-3 pb-4 border-b border-slate-100">
                    <div class="flex flex-wrap gap-2" id="posCategoryPills">
                        <button type="button" onclick="filterPosCategory('ALL', this)"
                                class="pos-cat-btn px-4 py-2 rounded-xl text-xs font-extrabold bg-slate-900 text-white transition">
                            Tất cả món (@Model.Products.Count)
                        </button>
                        @foreach (var cat in Model.Categories)
                        {
                            <button type="button" onclick="filterPosCategory('@cat.Id', this)"
                                    class="pos-cat-btn px-4 py-2 rounded-xl text-xs font-extrabold bg-slate-100 text-slate-700 hover:bg-slate-200 transition">
                                @cat.Name
                            </button>
                        }
                    </div>

                    <div class="relative w-full md:w-64">
                        <input type="text" id="posSearchInput" oninput="filterPosProducts()"
                               placeholder="Tìm nhanh tên món..."
                               class="w-full bg-slate-50 border border-slate-300 rounded-2xl pl-9 pr-4 py-2 text-xs font-semibold text-slate-900" />
                        <span class="absolute left-3 top-2.5 text-slate-400">
                            <i class="fi fi-rr-search text-xs"></i>
                        </span>
                    </div>
                </div>

                <div class="grid grid-cols-2 sm:grid-cols-3 lg:grid-cols-4 gap-4" id="posProductGrid">
                    @foreach (var prod in Model.Products.Where(p => p.IsAvailable))
                    {
                        var img = string.IsNullOrWhiteSpace(prod.ImageUrl)
                            ? "https://images.unsplash.com/photo-1509042239860-f550ce710b93?w=400"
                            : prod.ImageUrl;
                        var safeName = (prod.Name ?? "").Replace("'", "\\'");

                        <div class="pos-product-card bg-slate-50/70 rounded-2xl border border-slate-200 overflow-hidden flex flex-col justify-between hover:shadow-md transition"
                             data-category="@prod.CategoryId"
                             data-name="@(prod.Name?.ToLowerInvariant() ?? "")">
                            <div>
                                <img src="@img" alt="@prod.Name"
                                     class="w-full h-32 object-cover bg-amber-50"
                                     onerror="this.src='https://images.unsplash.com/photo-1509042239860-f550ce710b93?w=400'" />
                                <div class="p-3 pb-2">
                                    <div class="text-xs font-extrabold text-slate-900 truncate" title="@prod.Name">@prod.Name</div>
                                    <div class="text-sm font-black text-red-highland mt-0.5">@prod.BasePrice.ToString("N0") đ</div>
                                </div>
                            </div>

                            <div class="p-2.5 pt-0 grid grid-cols-3 gap-1">
                                <button type="button"
                                        onclick="addPosItem('@prod.Id', '@safeName', @prod.BasePrice, 'S')"
                                        class="py-1.5 rounded-lg bg-white hover:bg-slate-100 border border-slate-200 text-[11px] font-extrabold text-slate-700 transition">
                                    + Size S
                                </button>
                                <button type="button"
                                        onclick="addPosItem('@prod.Id', '@safeName', @(prod.BasePrice + 6000), 'M')"
                                        class="py-1.5 rounded-lg bg-red-highland hover:bg-red-highland-dark text-[11px] font-extrabold text-white transition">
                                    + Size M
                                </button>
                                <button type="button"
                                        onclick="addPosItem('@prod.Id', '@safeName', @(prod.BasePrice + 12000), 'L')"
                                        class="py-1.5 rounded-lg bg-slate-800 hover:bg-slate-900 text-[11px] font-extrabold text-white transition">
                                    + Size L
                                </button>
                            </div>
                        </div>
                    }
                </div>
            </div>

            <!-- Hóa đơn tại quầy POS (4 cols) -->
            <div class="xl:col-span-4 bg-white rounded-3xl border border-slate-200 p-5 shadow-sm sticky top-24">
                <form method="post" asp-page-handler="CreatePosOrder" id="posOrderForm" class="space-y-4">
                    <input type="hidden" name="posCartJson" id="posCartJsonInput" value="[]" />
                    <input type="hidden" name="discountAmount" id="posDiscountInput" value="0" />

                    <div class="flex items-center justify-between pb-3 border-b border-slate-100">
                        <h3 class="text-base font-black text-slate-900 flex items-center gap-2">
                            <i class="fi fi-rr-receipt text-red-highland"></i>
                            <span>Hóa đơn tại quầy POS</span>
                        </h3>
                        <button type="button" onclick="clearPosCart()" class="text-xs font-extrabold text-red-600 hover:underline">
                            Làm mới
                        </button>
                    </div>

                    <div>
                        <label class="block text-[11px] font-extrabold uppercase text-slate-500 mb-1">Tên khách hàng / Số bàn</label>
                        <input type="text" name="customerName" placeholder="VD: Khách tại quầy - Bàn 05"
                               class="w-full bg-slate-50 border border-slate-300 rounded-xl px-3.5 py-2 text-xs font-semibold text-slate-900" />
                    </div>

                    <div id="posCartContainer" class="bg-slate-50 rounded-2xl border border-slate-200 p-3 max-h-60 overflow-y-auto divide-y divide-slate-200/70">
                        <!-- Render danh sách món POS -->
                    </div>

                    <div>
                        <label class="block text-[11px] font-extrabold uppercase text-slate-500 mb-1">Mã giảm giá (Voucher)</label>
                        <div class="flex gap-2">
                            <input type="text" name="voucherCode" id="posVoucherInput" placeholder="Nhập mã khuyến mãi..."
                                   class="flex-1 bg-slate-50 border border-slate-300 rounded-xl px-3.5 py-2 text-xs font-bold uppercase" />
                            <button type="button" onclick="applyPosVoucher()"
                                    class="px-4 py-2 rounded-xl bg-slate-800 hover:bg-black text-white text-xs font-extrabold">
                                Áp dụng
                            </button>
                        </div>
                        <div id="posVoucherMsg" class="text-xs mt-1"></div>
                    </div>

                    <div>
                        <label class="block text-[11px] font-extrabold uppercase text-slate-500 mb-1">Ghi chú pha chế</label>
                        <input type="text" name="note" placeholder="VD: Ít đá, dùng tại quán / mang đi..."
                               class="w-full bg-slate-50 border border-slate-300 rounded-xl px-3.5 py-2 text-xs font-semibold text-slate-900" />
                    </div>

                    <div class="space-y-2">
                        <label class="block text-[11px] font-extrabold uppercase text-slate-500">Phương thức thanh toán</label>
                        <div class="grid grid-cols-2 gap-2.5">
                            <label class="flex items-center gap-2 p-2.5 rounded-xl border border-slate-200 bg-slate-50 cursor-pointer">
                                <input type="radio" name="paymentMethod" value="CASH" checked onchange="togglePosCashOption(this.value)" class="text-emerald-600" />
                                <span class="text-xs font-extrabold text-slate-800">Tiền mặt</span>
                            </label>
                            <label class="flex items-center gap-2 p-2.5 rounded-xl border border-slate-200 bg-slate-50 cursor-pointer">
                                <input type="radio" name="paymentMethod" value="VNPAY" onchange="togglePosCashOption(this.value)" class="text-blue-600" />
                                <span class="text-xs font-extrabold text-slate-800">VNPay QR</span>
                            </label>
                        </div>

                        <label id="collectCashNowGroup" class="flex items-center gap-2 pt-1 cursor-pointer">
                            <input type="checkbox" name="collectCashNow" value="true" checked class="rounded text-emerald-600" />
                            <span class="text-xs font-bold text-emerald-700">Đã thu đủ tiền mặt từ khách ngay tại quầy</span>
                        </label>
                    </div>

                    <div class="p-3.5 rounded-2xl bg-amber-50/80 border border-amber-200 space-y-1 text-xs">
                        <div class="flex justify-between text-slate-600">
                            <span>Tạm tính:</span>
                            <span id="posSubtotalLabel" class="font-bold">0 đ</span>
                        </div>
                        <div class="flex justify-between text-emerald-700">
                            <span>Giảm giá:</span>
                            <span id="posDiscountLabel" class="font-bold">-0 đ</span>
                        </div>
                        <div class="flex justify-between pt-1.5 border-t border-amber-200 text-sm font-black text-red-highland">
                            <span>Khách cần trả:</span>
                            <span id="posFinalLabel" class="text-base">0 đ</span>
                        </div>
                    </div>

                    <button type="submit" id="posSubmitBtn" disabled
                            class="w-full py-3.5 px-5 rounded-2xl bg-red-highland hover:bg-red-highland-dark disabled:bg-slate-300 text-white font-black text-xs uppercase tracking-wider shadow-md transition">
                        Tạo Đơn Hàng Tại Quầy
                    </button>
                </form>
            </div>
        </div>
    }
    else
    {
        <!-- ========================================================================= -->
        <!-- CHẾ ĐỘ 2: ĐIỀU PHỐI & QUẢN LÝ TOÀN BỘ ĐƠN HÀNG (STAFF DISPATCH)            -->
        <!-- ========================================================================= -->
        <div class="grid grid-cols-2 lg:grid-cols-4 gap-4">
            <div class="bg-white p-4 rounded-2xl border border-slate-200 shadow-sm">
                <div class="text-[11px] font-extrabold uppercase text-slate-400">1. Tiếp nhận / 2. Pha chế</div>
                <div class="text-xl font-black text-amber-600 mt-1">
                    @Model.PendingCount chờ <span class="text-sm text-blue-600 font-bold">• @Model.ProcessingCount đang pha</span>
                </div>
            </div>
            <div class="bg-white p-4 rounded-2xl border border-slate-200 shadow-sm">
                <div class="text-[11px] font-extrabold uppercase text-slate-400">3. Đang giao / Chờ nhận</div>
                <div class="text-xl font-black text-purple-700 mt-1">@Model.ShippingCount đơn</div>
            </div>
            <div class="bg-white p-4 rounded-2xl border border-slate-200 shadow-sm">
                <div class="text-[11px] font-extrabold uppercase text-slate-400">Đơn chưa thu tiền</div>
                <div class="text-xl font-black text-red-600 mt-1">@Model.UnpaidCount đơn</div>
            </div>
            <div class="bg-white p-4 rounded-2xl border border-slate-200 shadow-sm">
                <div class="text-[11px] font-extrabold uppercase text-slate-400">Doanh thu đã thu tiền</div>
                <div class="text-xl font-black text-emerald-700 mt-1">@Model.TotalPaidRevenue.ToString("N0") đ</div>
            </div>
        </div>

        <!-- Thanh Lọc Trạng Thái & Tìm Kiếm Đơn Hàng (Server-side Razor Form GET) -->
        <div class="bg-white p-4 rounded-3xl border border-slate-200 shadow-sm flex flex-col xl:flex-row gap-4 items-stretch xl:items-center justify-between">
            <div class="flex flex-wrap gap-1.5">
                @{
                    var staffTabs = new (string Key, string Label, int Count)[]
                    {
                        ("ALL", "Tất cả", Model.TotalCount),
                        ("PENDING", "1. Tiếp nhận", Model.PendingCount),
                        ("PROCESSING", "2. Đang pha chế", Model.ProcessingCount),
                        ("SHIPPING", "3. Đang giao", Model.ShippingCount),
                        ("COMPLETED", "4. Hoàn thành", Model.CompletedCount),
                        ("CANCELLED", "Đã hủy", Model.CancelledCount)
                    };
                }
                @foreach (var t in staffTabs)
                {
                    var active = string.Equals(Model.Status, t.Key, StringComparison.OrdinalIgnoreCase);
                    <a asp-page="/Staff/Orders"
                       asp-route-View="orders"
                       asp-route-Status="@t.Key"
                       asp-route-Search="@Model.Search"
                       class="px-3.5 py-2 rounded-xl text-xs font-extrabold transition @(active ? "bg-slate-900 text-white shadow-sm" : "bg-slate-100 text-slate-700 hover:bg-slate-200")">
                        @t.Label (@t.Count)
                    </a>
                }
            </div>

            <form method="get" asp-page="/Staff/Orders" class="flex items-center gap-2 w-full xl:w-96">
                <input type="hidden" name="View" value="orders" />
                <input type="hidden" name="Status" value="@Model.Status" />
                <input type="text" name="Search" value="@Model.Search"
                       placeholder="Tìm mã đơn, tên khách, món..."
                       class="flex-1 bg-slate-50 border border-slate-300 rounded-xl px-3.5 py-2 text-xs font-semibold text-slate-900" />
                <button type="submit" class="px-4 py-2 rounded-xl bg-red-highland hover:bg-red-highland-dark text-white text-xs font-extrabold">
                    Tìm
                </button>
                @if (!string.IsNullOrWhiteSpace(Model.Search))
                {
                    <a asp-page="/Staff/Orders" asp-route-View="orders" asp-route-Status="@Model.Status"
                       class="px-3 py-2 rounded-xl bg-slate-100 hover:bg-slate-200 text-slate-700 text-xs font-bold">
                        Xóa
                    </a>
                }
            </form>
        </div>

        <!-- Bảng Điều Phối Đơn Hàng -->
        <div class="bg-white rounded-3xl border border-slate-200 shadow-sm overflow-hidden">
            <div class="overflow-x-auto">
                <table class="w-full text-left text-sm">
                    <thead class="bg-slate-50 border-b border-slate-200 text-[11px] font-extrabold uppercase text-slate-500">
                        <tr>
                            <th class="px-4 py-3.5">Mã đơn / Thời gian</th>
                            <th class="px-4 py-3.5">Khách hàng &amp; Món đặt</th>
                            <th class="px-4 py-3.5 text-right">Tổng tiền</th>
                            <th class="px-4 py-3.5">Trạng thái Thanh toán</th>
                            <th class="px-4 py-3.5">Trạng thái Đơn</th>
                            <th class="px-4 py-3.5 text-right">Điều phối &amp; Thao tác</th>
                        </tr>
                    </thead>
                    <tbody class="divide-y divide-slate-100">
                        @if (Model.Orders.Count == 0)
                        {
                            <tr>
                                <td colspan="6" class="px-6 py-12 text-center text-slate-400 font-semibold">
                                    Không tìm thấy đơn hàng nào khớp với bộ lọc hiện tại.
                                </td>
                            </tr>
                        }
                        else
                        {
                            foreach (var order in Model.Orders)
                            {
                                var statusCls = order.NormalizedStatus switch
                                {
                                    "PENDING" => "bg-amber-100 text-amber-800",
                                    "PROCESSING" => "bg-blue-100 text-blue-800",
                                    "SHIPPING" => "bg-purple-100 text-purple-800",
                                    "COMPLETED" => "bg-emerald-100 text-emerald-800",
                                    "CANCELLED" => "bg-red-100 text-red-800",
                                    _ => "bg-slate-100 text-slate-800"
                                };

                                var payCls = order.IsPaid
                                    ? "bg-emerald-100 text-emerald-800"
                                    : (order.NormalizedPaymentStatus == "FAILED" ? "bg-red-100 text-red-700" : "bg-amber-100 text-amber-800");

                                <tr class="hover:bg-slate-50/80 transition">
                                    <td class="px-4 py-3.5 whitespace-nowrap">
                                        <div class="font-mono font-black text-slate-900">#@order.OrderCode</div>
                                        <div class="text-xs text-slate-500">@order.CreatedAt.ToLocalTime().ToString("dd/MM/yyyy HH:mm")</div>
                                    </td>

                                    <td class="px-4 py-3.5 max-w-xs">
                                        <div class="font-extrabold text-slate-900">
                                            @(string.IsNullOrWhiteSpace(order.CustomerName) ? "Khách hàng LowLand" : order.CustomerName)
                                        </div>
                                        <div class="text-xs text-slate-600 truncate" title="@order.ItemsSummary">
                                            @(string.IsNullOrWhiteSpace(order.ItemsSummary) ? $"{order.TotalItems} món" : order.ItemsSummary)
                                        </div>
                                        @if (!string.IsNullOrWhiteSpace(order.Note))
                                        {
                                            <div class="text-[11px] text-slate-400 italic truncate" title="@order.Note">@order.Note</div>
                                        }
                                    </td>

                                    <td class="px-4 py-3.5 text-right whitespace-nowrap">
                                        <div class="font-black text-red-highland">@order.FinalAmount.ToString("N0") đ</div>
                                        @if (order.DiscountAmount > 0)
                                        {
                                            <div class="text-[11px] font-bold text-emerald-600">-@order.DiscountAmount.ToString("N0") đ</div>
                                        }
                                    </td>

                                    <td class="px-4 py-3.5">
                                        <span class="inline-block px-2.5 py-1 rounded-lg text-[11px] font-extrabold @payCls">
                                            @order.PaymentMethodDisplayName • @order.PaymentStatusDisplayName
                                        </span>

                                        <!-- Nghiệp vụ 2 & 3: Nếu chưa thanh toán và chưa hủy, luôn hiện nút Thu tiền mặt & QR VNPay -->
                                        @if (!order.IsPaid && !order.IsCancelled)
                                        {
                                            <div class="flex flex-wrap gap-1.5 mt-1.5">
                                                <form method="post" asp-page-handler="ConfirmCash" class="inline">
                                                    <input type="hidden" name="orderId" value="@order.Id" />
                                                    <input type="hidden" name="returnStatus" value="@Model.Status" />
                                                    <input type="hidden" name="returnSearch" value="@Model.Search" />
                                                    <button type="submit"
                                                            class="px-2.5 py-1 rounded-lg bg-emerald-600 hover:bg-emerald-700 text-white text-[11px] font-extrabold shadow-sm transition flex items-center gap-1">
                                                        <i class="fi fi-rr-money-bill-wave"></i>
                                                        <span>Thu tiền mặt</span>
                                                    </button>
                                                </form>

                                                <form method="post" asp-page-handler="GenerateQr" class="inline">
                                                    <input type="hidden" name="orderId" value="@order.Id" />
                                                    <input type="hidden" name="returnStatus" value="@Model.Status" />
                                                    <input type="hidden" name="returnSearch" value="@Model.Search" />
                                                    <button type="submit"
                                                            class="px-2.5 py-1 rounded-lg bg-blue-600 hover:bg-blue-700 text-white text-[11px] font-extrabold shadow-sm transition flex items-center gap-1">
                                                        <i class="fi fi-rr-qrcode"></i>
                                                        <span>QR VNPay</span>
                                                    </button>
                                                </form>
                                            </div>
                                        }
                                    </td>

                                    <td class="px-4 py-3.5 whitespace-nowrap">
                                        <span class="px-3 py-1 rounded-full text-xs font-extrabold @statusCls">
                                            @order.StatusDisplayName
                                        </span>
                                        @if (order.IsCancelled && !string.IsNullOrWhiteSpace(order.CancelReason))
                                        {
                                            <div class="text-[11px] text-red-600 font-semibold mt-1 max-w-[180px] truncate" title="@order.CancelReason">
                                                Lý do: @order.CancelReason
                                            </div>
                                        }
                                    </td>

                                    <td class="px-4 py-3.5 text-right whitespace-nowrap">
                                        <div class="flex flex-wrap items-center justify-end gap-1.5">
                                            <a asp-page="/Staff/Orders"
                                               asp-route-View="orders"
                                               asp-route-Status="@Model.Status"
                                               asp-route-Search="@Model.Search"
                                               asp-route-DetailId="@order.Id"
                                               class="px-3 py-1.5 rounded-xl bg-slate-100 hover:bg-slate-200 text-slate-800 text-xs font-extrabold transition">
                                                Chi tiết
                                            </a>

                                            @if (order.IsPending)
                                            {
                                                <form method="post" asp-page-handler="UpdateStatus" class="inline">
                                                    <input type="hidden" name="orderId" value="@order.Id" />
                                                    <input type="hidden" name="nextStatus" value="PROCESSING" />
                                                    <input type="hidden" name="returnStatus" value="@Model.Status" />
                                                    <input type="hidden" name="returnSearch" value="@Model.Search" />
                                                    <button type="submit" class="px-3 py-1.5 rounded-xl bg-blue-600 hover:bg-blue-700 text-white text-xs font-extrabold shadow-sm transition">
                                                        Nhận &amp; Pha chế
                                                    </button>
                                                </form>
                                            }
                                            else if (order.IsProcessing)
                                            {
                                                <form method="post" asp-page-handler="UpdateStatus" class="inline">
                                                    <input type="hidden" name="orderId" value="@order.Id" />
                                                    <input type="hidden" name="nextStatus" value="SHIPPING" />
                                                    <input type="hidden" name="returnStatus" value="@Model.Status" />
                                                    <input type="hidden" name="returnSearch" value="@Model.Search" />
                                                    <button type="submit" class="px-3 py-1.5 rounded-xl bg-purple-600 hover:bg-purple-700 text-white text-xs font-extrabold shadow-sm transition">
                                                        Giao hàng / Sẵn sàng
                                                    </button>
                                                </form>
                                            }
                                            else if (order.IsShipping)
                                            {
                                                @if (order.IsPaid)
                                                {
                                                    <form method="post" asp-page-handler="UpdateStatus" class="inline">
                                                        <input type="hidden" name="orderId" value="@order.Id" />
                                                        <input type="hidden" name="nextStatus" value="COMPLETED" />
                                                        <input type="hidden" name="returnStatus" value="@Model.Status" />
                                                        <input type="hidden" name="returnSearch" value="@Model.Search" />
                                                        <button type="submit" class="px-3 py-1.5 rounded-xl bg-emerald-600 hover:bg-emerald-700 text-white text-xs font-extrabold shadow-sm transition">
                                                            ✓ Hoàn thành đơn
                                                        </button>
                                                    </form>
                                                }
                                                else
                                                {
                                                    <button type="button" disabled
                                                            title="Phải thu tiền (xác nhận thanh toán) trước khi bấm Hoàn thành"
                                                            class="px-3 py-1.5 rounded-xl bg-amber-100 text-amber-900 border border-amber-300 text-xs font-extrabold cursor-not-allowed">
                                                        🔒 Cần thu tiền trước khi Hoàn thành
                                                    </button>
                                                }
                                            }

                                            @if (!order.IsCompleted && !order.IsCancelled)
                                            {
                                                <button type="button"
                                                        onclick="openStaffCancelModal('@order.Id', '@order.OrderCode')"
                                                        class="px-3 py-1.5 rounded-xl bg-red-50 hover:bg-red-100 text-red-700 border border-red-200 text-xs font-extrabold transition">
                                                    Hủy
                                                </button>
                                            }
                                        </div>
                                    </td>
                                </tr>
                            }
                        }
                    </tbody>
                </table>
            </div>
        </div>
    }
</div>

