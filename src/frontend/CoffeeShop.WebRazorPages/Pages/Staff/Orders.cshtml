                    <select onchange="if(this.value) document.getElementById('staffCancelReasonInput').value = this.value;"
                            class="w-full bg-slate-50 border border-slate-300 rounded-xl px-3 py-2 text-xs font-semibold">
                        <option value="">-- Chọn nhanh lý do hủy --</option>
                        <option value="Hết nguyên liệu pha chế món trong đơn">Hết nguyên liệu pha chế món trong đơn</option>
                        <option value="Khách hàng liên hệ nhờ nhân viên hủy đơn">Khách hàng liên hệ nhờ nhân viên hủy đơn</option>
                        <option value="Không liên hệ được khách hàng khi giao">Không liên hệ được khách hàng khi giao</option>
                    </select>
                    <textarea name="cancelReason" id="staffCancelReasonInput" rows="3" required
                              class="w-full bg-slate-50 border border-slate-300 rounded-xl p-3 text-xs"
                              placeholder="Nhập lý do hủy đơn..."></textarea>
                </div>
            </div>
