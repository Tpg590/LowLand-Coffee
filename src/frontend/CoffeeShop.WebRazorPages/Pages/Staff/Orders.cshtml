@page
@model CoffeeShop.WebRazorPages.Pages.Staff.OrdersModel
@{
    Layout = "_StaffLayout";
    ViewData["Title"] = "Màn hình Thu ngân POS & Điều phối đơn - Nhân viên";
}

<div class="w-full px-4 sm:px-6 lg:px-8 py-5 space-y-6">
    <!-- Top Action Bar with Clear Mode Switcher -->
    <div class="flex flex-col sm:flex-row sm:items-center justify-between pb-4 border-b border-gray-200 gap-4">
        <div class="flex items-center gap-3.5">
            <span class="w-12 h-12 rounded-2xl bg-red-highland text-white flex items-center justify-center font-black text-xl shadow-md">
                POS
            </span>
            <div>
                <h1 class="text-2xl sm:text-3xl font-black text-gray-900 tracking-tight flex items-center gap-3">
                    <span>Màn hình Bán hàng Quầy Thu ngân</span>
                    <span class="px-3 py-1 rounded-full bg-blue-100 text-blue-900 text-xs font-black uppercase border border-blue-200">Khu vực Nhân viên</span>
                </h1>
                <p class="text-sm text-gray-500 font-medium mt-0.5">Nhân viên: <span class="font-bold text-gray-800" id="pos-staff-badge">Thu Ngân 01</span> • Bán hàng & Điều phối đơn</p>
            </div>
        </div>

        <div class="flex items-center gap-3">
            <!-- Mode Switcher Tabs (To, rõ ràng, Flaticon icon) -->
            <div class="bg-gray-200 p-1.5 rounded-2xl flex items-center gap-1.5 text-sm font-bold shadow-inner">
                <button type="button" id="tab-btn-pos" onclick="switchView('pos')" class="px-5 py-2.5 rounded-xl bg-white text-gray-900 shadow-sm transition flex items-center gap-2">
                    <i class="fi fi-rr-shopping-cart text-base text-red-highland flex items-center"></i>
                    <span>Bán hàng tại quầy</span>
                </button>
                <button type="button" id="tab-btn-orders" onclick="switchView('orders')" class="px-5 py-2.5 rounded-xl text-gray-600 hover:text-gray-900 transition flex items-center gap-2">
                    <i class="fi fi-rr-clipboard-list text-base flex items-center"></i>
                    <span>Điều phối đơn hàng</span>
                    <span id="pending-orders-badge" class="px-2 py-0.5 rounded-full bg-red-highland text-white text-xs font-black shadow-sm">2</span>
                </button>
            </div>
        </div>
    </div>

    <!-- ========================================================================= -->
    <!-- VIEW 1: POS Counter Register (Màn hình Bán hàng tại quầy) -->
    <!-- ========================================================================= -->
    <div id="view-pos" class="grid grid-cols-1 lg:grid-cols-12 gap-6 items-start">
        <!-- Left: Product Catalog & Fast Filters (lg:col-span-8) -->
        <div class="lg:col-span-8 space-y-4">
            <!-- Category Tabs & Search Bar -->
            <div class="bg-white p-4 sm:p-5 rounded-2xl border border-gray-200 shadow-sm flex flex-col sm:flex-row gap-3.5 items-center justify-between">
                <!-- Search Input -->
                <div class="relative w-full sm:w-80">
                    <input type="text" id="pos-search" onkeyup="filterPosProducts()" placeholder="Tìm món nhanh (tên món)..." class="w-full bg-gray-50 border border-gray-300 rounded-xl pl-11 pr-4 py-3 text-sm font-semibold text-gray-900 focus:ring-2 focus:ring-red-highland focus:bg-white placeholder-gray-400 transition" />
                    <span class="absolute left-3.5 top-3.5 text-gray-400">
                        <i class="fi fi-rr-search text-base flex items-center"></i>
                    </span>
                </div>

                <!-- Category Pills (Tải động từ Product.API) -->
                <div id="pos-category-pills" class="flex items-center gap-2 overflow-x-auto w-full sm:w-auto pb-1 sm:pb-0">
                    <button type="button" onclick="setCategoryFilter('ALL', this)" class="pos-cat-btn active px-4 py-2.5 rounded-xl text-sm font-bold bg-[#4F392E] text-white transition flex-shrink-0 shadow-sm flex items-center gap-1.5">
                        <i class="fi fi-rr-apps text-xs"></i>
                        <span>Tất cả món</span>
                    </button>
                </div>
            </div>

            <!-- Products Grid (Chữ to rõ, hình ảnh sắc nét, chạm 1 chạm để thêm) -->
            <div id="pos-product-grid" class="grid grid-cols-2 sm:grid-cols-3 xl:grid-cols-4 gap-4">
                <!-- Được nạp tự động qua API Products hoặc dữ liệu thực -->
            </div>
        </div>

        <!-- Right: Current Bill / Register Ticket (Hóa đơn thu ngân) -->
        <div class="lg:col-span-4 sticky top-20">
            <div class="bg-white rounded-3xl p-5 sm:p-6 shadow-xl border border-gray-200 space-y-4">
                <!-- Bill Header & Order Type Toggle -->
                <div class="flex items-center justify-between pb-3.5 border-b border-gray-200">
                    <div>
                        <span id="pos-bill-code" class="text-sm font-black text-red-highland uppercase tracking-wider block">HÓA ĐƠN BÁN LẺ</span>
                        <span class="text-xs text-gray-500 font-medium">Giờ tạo: <span id="pos-time" class="font-bold text-gray-800">11:30</span></span>
                    </div>

                    <!-- Dine-in / Take-away toggle -->
                    <div class="bg-gray-100 p-1 rounded-xl flex text-xs font-bold">
                        <button type="button" id="btn-dine-in" onclick="setOrderType('DINE_IN')" class="px-3 py-1.5 rounded-lg bg-white shadow-sm text-gray-900 transition">Tại quán</button>
                        <button type="button" id="btn-take-away" onclick="setOrderType('TAKE_AWAY')" class="px-3 py-1.5 rounded-lg text-gray-500 hover:text-gray-900 transition">Mang về</button>
                    </div>
                </div>

                <!-- Customer lookup -->
                <div class="pb-1 relative">
                    <div class="flex items-center justify-between mb-1.5">
                        <label class="text-xs font-black text-gray-500 uppercase tracking-wider block">Khách hàng</label>
                        <span class="text-[11px] text-gray-400 font-medium">Tìm tên hoặc SĐT</span>
                    </div>
                    <div class="relative">
                        <input type="text" id="pos-customer-search" 
                               oninput="searchCustomer(this.value)" 
                               onfocus="if (this.value) searchCustomer(this.value)"
                               onclick="if (this.value) searchCustomer(this.value)"
                               onkeydown="if (event.key === 'Enter') { event.preventDefault(); selectFirstCustomer(); }"
                               placeholder="Nhập tên hoặc SĐT khách..." autocomplete="off"
                               class="w-full bg-gray-50 border border-gray-200 rounded-xl pl-10 pr-4 py-2.5 text-sm font-semibold text-gray-900 focus:ring-2 focus:ring-red-highland focus:bg-white placeholder-gray-400 transition" />
                        <span class="absolute left-3 top-2.5 text-gray-400"><i class="fi fi-rr-user text-base flex items-center"></i></span>
                        <div id="customer-dropdown" class="absolute z-50 left-0 right-0 top-full mt-1.5 bg-white border border-gray-200 rounded-2xl shadow-2xl hidden max-h-64 overflow-y-auto divide-y divide-gray-100"></div>
                    </div>
                    
                    <!-- Khách hàng đã chọn -->
                    <div id="selected-customer-badge" class="hidden mt-2 p-3 bg-emerald-50 border-2 border-emerald-300 rounded-2xl text-xs text-emerald-900 shadow-sm animate-fade-in">
                        <div class="flex items-center justify-between gap-2">
                            <div class="flex items-center gap-2.5 min-w-0">
                                <span class="w-8 h-8 rounded-full bg-emerald-600 text-white flex items-center justify-center text-sm font-black flex-shrink-0 shadow">
                                    <i class="fi fi-rr-check"></i>
                                </span>
                                <div class="truncate">
                                    <div class="flex items-center gap-1.5">
                                        <span class="text-[10px] font-black uppercase tracking-wider text-emerald-700 bg-emerald-100 px-1.5 py-0.5 rounded">Thành viên</span>
                                        <span id="selected-customer-name" class="font-black text-sm text-emerald-950 truncate">--</span>
                                    </div>
                                    <div class="text-xs text-emerald-800 font-semibold mt-0.5 flex items-center gap-2">
                                        <span id="selected-customer-phone">--</span>
                                        <span id="selected-customer-email" class="text-emerald-600 text-[11px] truncate"></span>
                                    </div>
                                </div>
                            </div>
                            <button type="button" onclick="clearCustomer()" class="px-2.5 py-1.5 rounded-xl bg-white hover:bg-red-50 text-red-600 border border-red-200 text-xs font-bold transition flex items-center gap-1 flex-shrink-0 shadow-sm" title="Hủy chọn khách này">
                                <i class="fi fi-rr-cross text-xs"></i>
                                <span>Bỏ chọn</span>
                            </button>
                        </div>
                    </div>
                </div>

                <!-- Ticket Items List -->
                <div id="pos-ticket-items" class="max-h-[320px] overflow-y-auto space-y-3.5 divide-y divide-gray-100 pr-1">
                    <div id="pos-empty-cart-message" class="text-center py-12 text-gray-400 text-sm">
                        <i class="fi fi-rr-shopping-bag text-4xl mx-auto mb-2 text-gray-300 block"></i>
                        <span class="font-medium">Chưa có món nào trong hóa đơn.<br />Chạm vào món bên trái để thêm!</span>
                    </div>
                </div>

                <!-- Price Calculation Breakdown (To rõ ràng) -->
                <div class="space-y-2.5 pt-3.5 border-t border-gray-200 text-sm">
                    <div class="flex justify-between text-gray-600 font-medium">
                        <span>Tạm tính</span>
                        <span id="pos-subtotal" class="font-bold text-gray-900">0đ</span>
                    </div>
                    <div class="flex justify-between text-gray-600 font-medium">
                        <span>Giảm giá / Khuyến mãi</span>
                        <span id="pos-discount" class="font-bold text-emerald-600">-0đ</span>
                    </div>
                    <div class="flex justify-between items-baseline pt-2.5 border-t-2 border-gray-200">
                        <span class="text-base font-black text-gray-900">Tổng thanh toán:</span>
                        <span id="pos-total" class="text-2xl sm:text-3xl font-black text-red-highland">0đ</span>
                    </div>
                </div>

                <!-- Payment Method Tabs: Tiền mặt vs VNPay QR (Flaticon Icons) -->
                <div class="space-y-3 pt-2">
                    <div class="grid grid-cols-2 gap-2.5">
                        <button type="button" id="btn-pay-cash" onclick="setPosPaymentMethod('CASH')" class="py-3 px-3.5 rounded-2xl border-2 border-red-highland bg-red-50 text-red-highland font-black text-sm flex items-center justify-center gap-2 transition shadow-sm">
                            <i class="fi fi-rr-money-bill-wave text-base flex items-center"></i>
                            <span>Tiền mặt</span>
                        </button>
                        <button type="button" id="btn-pay-vnpay" onclick="setPosPaymentMethod('VNPAY')" class="py-3 px-3.5 rounded-2xl border border-gray-300 bg-white text-gray-700 font-bold text-sm flex items-center justify-center gap-2 transition hover:bg-gray-50">
                            <i class="fi fi-rr-credit-card text-base flex items-center"></i>
                            <span>VNPay QR</span>
                        </button>
                    </div>

                    <!-- Cash Drawer Quick Amount Buttons (Nếu chọn Tiền mặt) -->
                    <div id="cash-drawer-box" class="p-3.5 rounded-2xl bg-gray-50 border border-gray-200 space-y-2.5">
                        <div class="flex items-center justify-between text-sm">
                            <span class="font-bold text-gray-700">Khách đưa:</span>
                            <div class="relative">
                                <input type="number" id="cash-given" oninput="calculateChange()" placeholder="0" class="w-32 text-right bg-white border border-gray-300 rounded-xl px-3 py-1.5 text-sm font-black text-gray-900 focus:ring-2 focus:ring-red-highland" />
                                <span class="text-xs text-gray-400 absolute right-1 -bottom-4">đ</span>
                            </div>
                        </div>
                        <div class="flex items-center gap-1.5 justify-end pt-1">
                            <button type="button" onclick="setQuickCash(50000)" class="px-2.5 py-1 rounded-lg bg-white border text-xs font-bold hover:bg-gray-100 text-gray-800 shadow-sm">50k</button>
                            <button type="button" onclick="setQuickCash(100000)" class="px-2.5 py-1 rounded-lg bg-white border text-xs font-bold hover:bg-gray-100 text-gray-800 shadow-sm">100k</button>
                            <button type="button" onclick="setQuickCash(200000)" class="px-2.5 py-1 rounded-lg bg-white border text-xs font-bold hover:bg-gray-100 text-gray-800 shadow-sm">200k</button>
                            <button type="button" onclick="setQuickCash(500000)" class="px-2.5 py-1 rounded-lg bg-white border text-xs font-bold hover:bg-gray-100 text-gray-800 shadow-sm">500k</button>
                        </div>
                        <div class="flex items-center justify-between text-sm pt-2 border-t border-gray-200">
                            <span class="font-semibold text-gray-600">Tiền thối lại:</span>
                            <span id="cash-change" class="text-lg font-black text-emerald-600">0đ</span>
                        </div>
                    </div>
                </div>

                <!-- Submit / Checkout Action Buttons -->
                <div class="grid grid-cols-12 gap-2.5 pt-2">
                    <button type="button" onclick="clearPosTicket()" class="col-span-4 py-3.5 rounded-2xl bg-gray-100 hover:bg-gray-200 text-gray-700 font-bold text-sm transition flex items-center justify-center gap-1.5">
                        <i class="fi fi-rr-trash text-sm"></i>
                        <span>Xóa trắng</span>
                    </button>
                    <button type="button" onclick="checkoutPosOrder()" id="btn-pos-checkout" class="col-span-8 py-3.5 rounded-2xl bg-red-highland hover:bg-red-700 text-white font-black text-base uppercase tracking-wider shadow-lg transition active:scale-95 flex items-center justify-center gap-2">
                        <i class="fi fi-rr-receipt text-lg"></i>
                        <span>Thanh toán & In hóa đơn</span>
                    </button>
                </div>
            </div>
        </div>
    </div>

    <!-- ========================================================================= -->
    <!-- VIEW 2: Order Management & Status Transitions (Điều phối & Giao hàng) -->
    <!-- ========================================================================= -->
    <div id="view-orders" class="hidden space-y-6">
        <div class="bg-white p-6 rounded-3xl border border-gray-200 shadow-xl space-y-5">
            <div class="flex flex-col sm:flex-row items-center justify-between gap-4 pb-4 border-b border-gray-200">
                <div>
                    <h3 class="text-xl font-black text-gray-900">Danh sách đơn hàng cần xử lý</h3>
                    <p class="text-sm text-gray-500 mt-0.5 flex items-center gap-1.5 flex-wrap">
                        <span>Quy trình điều phối:</span>
                        <span class="font-bold text-amber-700">Chờ xác nhận</span>
                        <i class="fi fi-rr-arrow-right text-xs text-gray-400"></i>
                        <span class="font-bold text-blue-700">Đang pha chế</span>
                        <i class="fi fi-rr-arrow-right text-xs text-gray-400"></i>
                        <span class="font-bold text-purple-700">Đang giao hàng</span>
                        <i class="fi fi-rr-arrow-right text-xs text-gray-400"></i>
                        <span class="font-bold text-emerald-700">Hoàn tất đơn</span>
                    </p>
                </div>

                <div class="flex items-center gap-3">
                    <button type="button" onclick="loadPosOrdersList()" class="px-4 py-2.5 rounded-xl bg-gray-100 hover:bg-gray-200 text-gray-800 font-bold text-sm transition flex items-center gap-2 shadow-sm">
                        <i class="fi fi-rr-refresh text-sm"></i>
                        <span>Tải lại danh sách</span>
                    </button>
                </div>
            </div>

            <!-- Orders Table with Instant Action Buttons (Chữ to, dễ đọc) -->
            <div class="overflow-x-auto">
                <table class="w-full text-left text-sm text-gray-700">
                    <thead class="bg-gray-100 text-gray-800 uppercase font-black text-xs tracking-wider">
                        <tr>
                            <th class="py-3.5 px-4">Mã đơn</th>
                            <th class="py-3.5 px-4">Khách hàng</th>
                            <th class="py-3.5 px-4">Món đã gọi</th>
                            <th class="py-3.5 px-4">Tổng tiền</th>
                            <th class="py-3.5 px-4">Thanh toán</th>
                            <th class="py-3.5 px-4">Trạng thái</th>
                            <th class="py-3.5 px-4 text-center">Thao tác xử lý</th>
                        </tr>
                    </thead>
                    <tbody id="pos-orders-table-body" class="divide-y divide-gray-200 font-medium text-sm">
                        <!-- Populated via JS -->
                    </tbody>
                </table>
            </div>
        </div>
    </div>
</div>


<!-- ========================================================================= -->
<!-- Modal Chi Tiết Đơn Hàng Dành Cho Nhân Viên -->
<!-- ========================================================================= -->
<div id="modal-order-detail" class="fixed inset-0 z-50 bg-black/60 backdrop-blur-sm hidden items-center justify-center p-4">
    <div class="bg-white rounded-3xl max-w-xl w-full max-h-[90vh] flex flex-col shadow-2xl overflow-hidden animate-scale-up">
        <!-- Header -->
        <div class="px-6 py-4 bg-slate-900 text-white flex items-center justify-between">
            <div class="flex items-center gap-3">
                <span class="w-10 h-10 rounded-xl bg-amber-500 text-slate-900 flex items-center justify-center font-bold text-lg">
                    <i class="fi fi-rr-receipt"></i>
                </span>
                <div>
                    <h3 class="text-base font-black flex items-center gap-2">
                        <span>Chi tiết đơn hàng</span>
                        <span id="detail-order-code" class="text-xs font-mono text-amber-300 bg-amber-500/20 px-2 py-0.5 rounded-full">#ORD-...</span>
                    </h3>
                    <p id="detail-order-time" class="text-xs text-slate-300 mt-0.5">--:-- --/--/----</p>
                </div>
            </div>
            <button type="button" onclick="closeOrderDetailModal()" class="w-8 h-8 rounded-full bg-slate-800 hover:bg-slate-700 text-slate-300 flex items-center justify-center transition">✕</button>
        </div>
        <!-- Body -->
        <div class="p-6 overflow-y-auto space-y-5 flex-1">
            <!-- Status & Payment -->
            <div class="flex items-center justify-between p-3.5 bg-gray-50 rounded-2xl border border-gray-200 text-xs">
                <div>
                    <span class="text-gray-500 block font-semibold">Trạng thái</span>
                    <span id="detail-order-status" class="font-black text-sm text-gray-900">Chờ xác nhận</span>
                </div>
                <div class="text-right">
                    <span class="text-gray-500 block font-semibold">Thanh toán</span>
                    <span id="detail-order-payment" class="font-black text-sm text-gray-900">Tiền mặt</span>
                </div>
            </div>
            <!-- Customer Name -->
            <div class="flex items-center gap-3 px-3.5 py-2.5 bg-blue-50 border border-blue-100 rounded-2xl text-xs">
                <span class="w-8 h-8 rounded-full bg-blue-200 flex items-center justify-center text-blue-800 flex-shrink-0"><i class="fi fi-rr-user text-sm"></i></span>
                <div>
                    <span class="text-gray-500 block font-semibold">Khách hàng</span>
                    <span id="detail-customer-name" class="font-black text-sm text-gray-900">—</span>
                </div>
            </div>
            <!-- Items list -->
            <div>

                <h4 class="text-xs font-black uppercase text-gray-500 tracking-wider mb-2.5">Danh sách món nước</h4>
                <div id="detail-items-list" class="divide-y divide-gray-100 border border-gray-200 rounded-2xl overflow-hidden bg-gray-50/50">
                    <!-- Dynamic -->
                </div>
            </div>
            <!-- Total -->
            <div class="p-4 bg-gray-50 rounded-2xl border border-gray-200 flex justify-between items-center">
                <span class="font-bold text-gray-700 text-sm">Tổng tiền thanh toán</span>
                <span id="detail-order-total" class="font-black text-red-highland text-xl">0 đ</span>
            </div>
            <!-- Note -->
            <div id="detail-note-box" class="p-3 bg-amber-50 border border-amber-200 rounded-xl text-xs text-amber-900 hidden">
                <span class="font-bold block mb-0.5">Ghi chú của khách:</span>
                <span id="detail-order-note" class="italic"></span>
            </div>
        </div>
        <!-- Footer -->
        <div class="px-6 py-3.5 bg-gray-50 border-t border-gray-100 flex justify-end">
            <button type="button" onclick="closeOrderDetailModal()" class="px-5 py-2 rounded-xl border border-gray-300 hover:bg-gray-200 text-gray-700 font-bold text-sm transition">Đóng</button>
        </div>
    </div>
</div>

@section Scripts {
    <script>
        // Dữ liệu sản phẩm và danh mục tải hoàn toàn động 100% từ Product.API (Cổng 5002)
        let posProducts = [];
        let currentCategory = 'ALL';
        let posCart = [];
        let orderType = 'DINE_IN';
        let currentPosPayment = 'CASH';

        // Customer POS state
        let posCustomer = null; // { id: Guid|null, name: string }
        let customerSearchTimeout = null;

        // Danh sách đơn hàng động từ Order.API (không dùng mock data)
        let posOrders = [];

        // Dịch trạng thái sang tiếng Việt
        const STATUS_VI = {
            'PENDING':    'Chờ xác nhận',
            'PROCESSING': 'Đang pha chế',
            'CONFIRMED':  'Đang pha chế',
            'SHIPPING':   'Đang giao hàng',
            'DELIVERING': 'Đang giao hàng',
            'COMPLETED':  'Đã hoàn thành',
            'CANCELLED':  'Đã hủy'
        };
        const PAY_STATUS_VI = {
            'PENDING':   'Chờ thanh toán',
            'SUCCESS':   'Đã thanh toán',
            'PAID':      'Đã thanh toán',
            'FAILED':    'Thanh toán lỗi',
            'CANCELLED': 'Đã hủy',
            'REFUNDED':  'Đã hoàn tiền',
            'UNPAID':    'Chưa thanh toán'
        };
        const PAY_METHOD_VI = {
            'CASH':  'Tiền mặt',
            'VNPAY': 'VNPay QR'
        };

        // Nạp danh mục động từ Product.API (Cổng 5002)
        async function loadCategoriesFromApi() {
            try {
                const res = await fetch('http://localhost:5002/api/categories');
                if (res.ok) {
                    const result = await res.json();
                    const cats = result.data || [];
                    const container = document.getElementById('pos-category-pills');
                    if (container && Array.isArray(cats) && cats.length > 0) {
                        let html = `
                            <button type="button" onclick="setCategoryFilter('ALL', this)" class="pos-cat-btn active px-4 py-2.5 rounded-xl text-sm font-bold bg-[#4F392E] text-white transition flex-shrink-0 shadow-sm flex items-center gap-1.5">
                                <i class="fi fi-rr-apps text-xs"></i>
                                <span>Tất cả món</span>
                            </button>
                        `;
                        cats.forEach(c => {
                            let icon = 'fi-rr-coffee';
                            const cName = (c.name || '').toLowerCase();
                            if (cName.includes('trà') || cName.includes('tea')) icon = 'fi-rr-leaf';
                            else if (cName.includes('freeze') || cName.includes('đá xay')) icon = 'fi-rr-glass';
                            else if (cName.includes('bánh') || cName.includes('mousse')) icon = 'fi-rr-cake-birthday';

                            html += `
                                <button type="button" onclick="setCategoryFilter('${c.id}', this)" class="pos-cat-btn px-4 py-2.5 rounded-xl text-sm font-bold bg-gray-100 hover:bg-gray-200 text-gray-700 transition flex-shrink-0 flex items-center gap-1.5">
                                    <i class="fi ${icon} text-xs"></i>
                                    <span>${c.name}</span>
                                </button>
                            `;
                        });
                        container.innerHTML = html;
                    }
                }
            } catch (err) {
                console.error('Không thể tải danh mục từ Product.API:', err);
            }
        }

        // Lấy danh sách sản phẩm thật từ Product.API (Cổng 5002)
        async function loadProductsFromApi() {
            await loadCategoriesFromApi();
            try {
                const res = await fetch('http://localhost:5002/api/products?pageSize=100');
                if (res.ok) {
                    const result = await res.json();
                    const items = result.data?.items || result.data || [];
                    if (items && items.length > 0) {
                        posProducts = items.map(p => {
                            return {
                                id: p.id,
                                name: p.name,
                                categoryId: p.categoryId,
                                categoryName: p.categoryName || '',
                                price: p.basePrice || 0,
                                img: (p.imageUrl && p.imageUrl.startsWith('http') && !p.imageUrl.includes('placehold.co')) 
                                     ? p.imageUrl 
                                     : getFallbackImage(p.name, (p.categoryName || '').toLowerCase())
                            };
                        });
                    }
                }
            } catch (err) {
                console.error('Product.API chưa sẵn sàng hoặc lỗi kết nối:', err);
            }
            filterPosProducts();
        }

        function getFallbackImage(name, cat) {
            const n = (name || '').toLowerCase();
            const c = (cat || '').toLowerCase();
            if (n.includes('sen') || n.includes('đào') || c.includes('trà') || c.includes('tea')) {
                return 'https://images.unsplash.com/photo-1556881286-fc6915169721?w=400&auto=format&fit=crop&q=80';
            }
            if (n.includes('freeze') || c.includes('freeze') || c.includes('đá xay')) {
                return 'https://images.unsplash.com/photo-1572490122747-3968b75cc699?w=400&auto=format&fit=crop&q=80';
            }
            if (n.includes('bánh') || c.includes('bánh') || c.includes('mousse')) {
                return 'https://images.unsplash.com/photo-1578985545062-69928b1d9587?w=400&auto=format&fit=crop&q=80';
            }
            return 'https://images.unsplash.com/photo-1514432324607-a09d9b4aefdd?w=400&auto=format&fit=crop&q=80';
        }

        function renderCatalog(items) {
            const grid = document.getElementById('pos-product-grid');
            if (!grid) return;
            grid.innerHTML = '';

            if (!items || items.length === 0) {
                grid.innerHTML = '<div class="col-span-full py-12 text-center text-gray-400 font-bold">Không tìm thấy món nào trong danh mục này.</div>';
                return;
            }

            items.forEach(p => {
                const card = document.createElement('div');
                card.className = 'bg-white rounded-2xl border border-gray-200 shadow-sm hover:shadow-lg transition p-3.5 flex flex-col justify-between cursor-pointer group active:scale-95';
                card.onclick = () => addItemToPosTicket(p);
                card.innerHTML = `
                    <div>
                        <div class="h-32 rounded-xl bg-gray-50 flex items-center justify-center overflow-hidden mb-2.5 border border-gray-100">
                            <img src="${p.img}" alt="${p.name}" class="h-full w-full object-cover group-hover:scale-105 transition duration-300" />
                        </div>
                        <h4 class="font-extrabold text-sm sm:text-base text-gray-900 group-hover:text-red-highland transition line-clamp-2 leading-snug">${p.name}</h4>
                    </div>
                    <div class="mt-3 flex items-center justify-between pt-2.5 border-t border-gray-100">
                        <span class="font-black text-sm sm:text-base text-red-highland">${p.price.toLocaleString('vi-VN')} đ</span>
                        <span class="w-8 h-8 rounded-full bg-red-highland text-white flex items-center justify-center text-base font-bold shadow-sm group-hover:scale-110 transition">+</span>
                    </div>
                `;
                grid.appendChild(card);
            });
        }

        function filterPosProducts() {
            const searchInput = document.getElementById('pos-search');
            const keyword = searchInput ? searchInput.value.toLowerCase().trim() : '';
            const filtered = posProducts.filter(p => {
                const matchName = p.name.toLowerCase().includes(keyword);
                const matchCat = currentCategory === 'ALL' || 
                                 p.categoryId === currentCategory || 
                                 (p.categoryName && p.categoryName.toLowerCase() === currentCategory.toLowerCase());
                return matchName && matchCat;
            });
            renderCatalog(filtered);
        }

        function setCategoryFilter(cat, btn) {
            currentCategory = cat;
            document.querySelectorAll('.pos-cat-btn').forEach(b => {
                b.className = 'pos-cat-btn px-4 py-2.5 rounded-xl text-sm font-bold bg-gray-100 hover:bg-gray-200 text-gray-700 transition flex-shrink-0 flex items-center gap-1.5';
            });
            const targetBtn = btn || (window.event ? window.event.currentTarget || window.event.target : null);
            if (targetBtn) {
                targetBtn.className = 'pos-cat-btn active px-4 py-2.5 rounded-xl text-sm font-bold bg-[#4F392E] text-white transition flex-shrink-0 shadow-sm flex items-center gap-1.5';
            }
            filterPosProducts();
        }

        function addItemToPosTicket(prod) {
            const existing = posCart.find(i => i.id === prod.id);
            if (existing) {
                existing.qty++;
            } else {
                posCart.push({
                    id: prod.id,
                    name: prod.name,
                    price: prod.price,
                    qty: 1
                });
            }
            renderTicket();
            showToast('Đã thêm món', `+1 "${prod.name}" vào hóa đơn`, 'info', 1500);
        }

        function changeTicketQty(id, delta) {
            const item = posCart.find(i => i.id === id);
            if (!item) return;

            item.qty += delta;
            if (item.qty <= 0) {
                posCart = posCart.filter(i => i.id !== id);
            }
            renderTicket();
        }

        function renderTicket() {
            const container = document.getElementById('pos-ticket-items');
            container.innerHTML = '';

            if (posCart.length === 0) {
                container.innerHTML = `
                    <div id="pos-empty-cart-message" class="text-center py-12 text-gray-400 text-sm">
                        <i class="fi fi-rr-shopping-bag text-4xl mx-auto mb-2 text-gray-300 block"></i>
                        <span class="font-medium">Chưa có món nào trong hóa đơn.<br />Chạm vào món bên trái để thêm!</span>
                    </div>
                `;
            } else {
                posCart.forEach(item => {
                    const row = document.createElement('div');
                    row.className = 'pt-2.5 flex items-center justify-between gap-2.5';
                    row.innerHTML = `
                        <div class="flex-1 min-w-0">
                            <span class="font-extrabold text-sm text-gray-900 truncate block">${item.name}</span>
                            <span class="text-xs text-gray-500 font-medium">${item.price.toLocaleString('vi-VN')} đ/ly</span>
                        </div>
                        <div class="flex items-center gap-1.5">
                            <button type="button" onclick="changeTicketQty('${item.id}', -1)" class="w-7 h-7 rounded-lg bg-gray-100 hover:bg-gray-200 text-gray-800 flex items-center justify-center font-bold text-sm">-</button>
                            <span class="text-sm font-black w-6 text-center text-gray-900">${item.qty}</span>
                            <button type="button" onclick="changeTicketQty('${item.id}', 1)" class="w-7 h-7 rounded-lg bg-red-highland text-white flex items-center justify-center font-bold text-sm">+</button>
                        </div>
                        <span class="font-black text-sm text-gray-900 min-w-[70px] text-right">${(item.price * item.qty).toLocaleString('vi-VN')} đ</span>
                    `;
                    container.appendChild(row);
                });
            }

            let subtotal = posCart.reduce((sum, i) => sum + (i.price * i.qty), 0);
            document.getElementById('pos-subtotal').textContent = `${subtotal.toLocaleString('vi-VN')} đ`;
            document.getElementById('pos-total').textContent = `${subtotal.toLocaleString('vi-VN')} đ`;
            calculateChange();
        }

        function setOrderType(type) {
            orderType = type;
            const btnDine = document.getElementById('btn-dine-in');
            const btnTake = document.getElementById('btn-take-away');

            if (type === 'DINE_IN') {
                btnDine.className = 'px-3 py-1.5 rounded-lg bg-white shadow-sm text-gray-900 font-bold transition';
                btnTake.className = 'px-3 py-1.5 rounded-lg text-gray-500 hover:text-gray-900 font-bold transition';
            } else {
                btnTake.className = 'px-3 py-1.5 rounded-lg bg-white shadow-sm text-gray-900 font-bold transition';
                btnDine.className = 'px-3 py-1.5 rounded-lg text-gray-500 hover:text-gray-900 font-bold transition';
            }
        }

        function setPosPaymentMethod(method) {
            currentPosPayment = method;
            const btnCash = document.getElementById('btn-pay-cash');
            const btnVn = document.getElementById('btn-pay-vnpay');
            const drawer = document.getElementById('cash-drawer-box');

            if (method === 'CASH') {
                btnCash.className = 'py-3 px-3.5 rounded-2xl border-2 border-red-highland bg-red-50 text-red-highland font-black text-sm flex items-center justify-center gap-2 transition shadow-sm';
                btnVn.className = 'py-3 px-3.5 rounded-2xl border border-gray-300 bg-white text-gray-700 font-bold text-sm flex items-center justify-center gap-2 transition hover:bg-gray-50';
                drawer.classList.remove('hidden');
            } else {
                btnVn.className = 'py-3 px-3.5 rounded-2xl border-2 border-blue-600 bg-blue-50 text-blue-700 font-black text-sm flex items-center justify-center gap-2 transition shadow-sm';
                btnCash.className = 'py-3 px-3.5 rounded-2xl border border-gray-300 bg-white text-gray-700 font-bold text-sm flex items-center justify-center gap-2 transition hover:bg-gray-50';
                drawer.classList.add('hidden');
            }
        }

        function setQuickCash(amount) {
            document.getElementById('cash-given').value = amount;
            calculateChange();
        }

        function calculateChange() {
            const total = posCart.reduce((sum, i) => sum + (i.price * i.qty), 0);
            const given = parseFloat(document.getElementById('cash-given').value) || 0;
            const change = given - total;
            const changeEl = document.getElementById('cash-change');

            if (change >= 0) {
                changeEl.textContent = `${change.toLocaleString('vi-VN')} đ`;
                changeEl.className = 'text-lg font-black text-emerald-600';
            } else {
                changeEl.textContent = `Thiếu ${Math.abs(change).toLocaleString('vi-VN')} đ`;
                changeEl.className = 'text-lg font-black text-rose-600';
            }
        }

        function clearPosTicket() {
            posCart = [];
            document.getElementById('cash-given').value = '';
            document.getElementById('cash-change').textContent = '0 đ';
            renderTicket();
            clearCustomer();
            showToast('Làm mới hóa đơn', 'Đã xóa trắng hóa đơn quầy', 'info');
        }

        function checkoutPosOrder() {
            if (posCart.length === 0) {
                showToast('Hóa đơn trống', 'Vui lòng chọn ít nhất 1 món nước vào hóa đơn trước khi thanh toán!', 'warning');
                return;
            }

            completePosTransaction(currentPosPayment);
        }

        // ===================== CUSTOMER SEARCH =====================
        let lastSearchResults = [];

        async function searchCustomer(query) {
            clearTimeout(customerSearchTimeout);
            const dropdown = document.getElementById('customer-dropdown');
            if (!dropdown) return;

            if (!query || query.trim().length === 0) {
                dropdown.classList.add('hidden');
                lastSearchResults = [];
                return;
            }

            // Hiển thị trạng thái đang tìm kiếm ngay lập tức
            dropdown.innerHTML = `
                <div class="p-3.5 text-xs text-gray-500 text-center flex items-center justify-center gap-2">
                    <svg class="animate-spin h-4 w-4 text-red-highland" xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24">
                        <circle class="opacity-25" cx="12" cy="12" r="10" stroke="currentColor" stroke-width="4"></circle>
                        <path class="opacity-75" fill="currentColor" d="M4 12a8 8 0 018-8v8H4z"></path>
                    </svg>
                    <span>Đang tìm kiếm khách hàng trong hệ thống...</span>
                </div>`;
            dropdown.classList.remove('hidden');

            customerSearchTimeout = setTimeout(async () => {
                try {
                    const token = localStorage.getItem('auth_token');
                    const headers = {};
                    if (token) headers['Authorization'] = `Bearer ${token}`;

                    const res = await fetch(`http://localhost:5001/api/users/search?q=${encodeURIComponent(query.trim())}&pageSize=10`, {
                        headers: headers
                    });

                    if (!res.ok) {
                        dropdown.innerHTML = `
                            <div class="p-3 text-xs text-gray-500 text-center italic">
                                Không thể kết nối máy chủ Auth.API.<br />
                                <span class="text-gray-700 font-semibold">Tên "${query}" sẽ được lưu cho khách lẻ.</span>
                            </div>`;
                        return;
                    }

                    const json = await res.json();
                    const rawUsers = json.data?.items || json.data || [];
                    const users = (Array.isArray(rawUsers) ? rawUsers : []).filter(u => {
                        const role = (u.roleName || u.role || 'Customer').toLowerCase();
                        return role === 'customer';
                    });
                    lastSearchResults = users;

                    if (lastSearchResults.length === 0) {
                        dropdown.innerHTML = `
                            <div class="p-3.5 text-xs text-gray-500 text-center italic">
                                Không tìm thấy tài khoản phù hợp trong hệ thống.<br />
                                <span class="text-gray-800 font-bold">Tên "${query}" sẽ được lưu làm khách lẻ.</span>
                            </div>`;
                        dropdown.classList.remove('hidden');
                        return;
                    }

                    dropdown.innerHTML = lastSearchResults.map(u => {
                        const name = (u.fullName || u.email || 'Khách hàng').replace(/'/g, '&#39;');
                        const phone = (u.phoneNumber || u.phone || '').replace(/'/g, '&#39;');
                        const email = (u.email || '').replace(/'/g, '&#39;');
                        const initial = (name || '?')[0].toUpperCase();
                        return `
                        <div onclick="selectCustomer('${u.id}', '${name}', '${phone}', '${email}')" 
                             class="p-3 hover:bg-red-50/70 cursor-pointer flex items-center justify-between text-sm transition border-b border-gray-100 last:border-b-0 group">
                            <div class="flex items-center gap-3 min-w-0">
                                <span class="w-9 h-9 rounded-full bg-red-highland text-white flex items-center justify-center text-xs font-black flex-shrink-0 shadow-sm">${initial}</span>
                                <div class="truncate">
                                    <div class="font-extrabold text-sm text-gray-900 group-hover:text-red-highland transition truncate">${u.fullName || '(Chưa đặt tên)'}</div>
                                    <div class="text-xs text-gray-500 flex items-center gap-1.5 flex-wrap">
                                        ${phone ? `<span class="font-bold text-emerald-700 bg-emerald-50 px-1.5 py-0.5 rounded border border-emerald-200">SĐT: ${phone}</span>` : '<span class="text-gray-400">Chưa có SĐT</span>'}
                                        ${email ? `<span class="text-gray-400 truncate text-[11px]">${email}</span>` : ''}
                                    </div>
                                </div>
                            </div>
                            <button type="button" class="px-3 py-1.5 rounded-xl text-xs font-black text-white bg-red-highland hover:bg-red-700 transition flex-shrink-0 shadow-sm ml-2 flex items-center gap-1">
                                <i class="fi fi-rr-check text-xs"></i>
                                <span>Chọn</span>
                            </button>
                        </div>
                    `;}).join('');
                    dropdown.classList.remove('hidden');
                } catch (e) {
                    console.error('Lỗi tìm kiếm khách hàng:', e);
                    dropdown.classList.add('hidden');
                }
            }, 200);
        }

        function selectFirstCustomer() {
            if (lastSearchResults && lastSearchResults.length > 0) {
                const u = lastSearchResults[0];
                selectCustomer(u.id, u.fullName || u.email, u.phoneNumber || u.phone || '', u.email || '');
            }
        }

        function selectCustomer(id, name, phone, email) {
            posCustomer = { id: id, name: name, phone: phone, email: email };
            document.getElementById('pos-customer-search').value = name;
            document.getElementById('customer-dropdown').classList.add('hidden');
            
            document.getElementById('selected-customer-name').textContent = name;
            const phoneEl = document.getElementById('selected-customer-phone');
            if (phoneEl) {
                phoneEl.textContent = phone ? `SĐT: ${phone}` : 'Chưa có SĐT';
            }
            const emailEl = document.getElementById('selected-customer-email');
            if (emailEl) {
                emailEl.textContent = email ? `• ${email}` : '';
            }
            document.getElementById('selected-customer-badge').classList.remove('hidden');
            showToast('Đã chọn khách hàng', `${name} ${phone ? `(${phone})` : ''}`, 'info', 2000);
        }

        function clearCustomer() {
            posCustomer = null;
            lastSearchResults = [];
            document.getElementById('pos-customer-search').value = '';
            document.getElementById('selected-customer-badge').classList.add('hidden');
            document.getElementById('customer-dropdown').classList.add('hidden');
        }

        // Đóng dropdown khi click ngoài
        document.addEventListener('click', (e) => {
            if (!e.target.closest('#pos-customer-search') && !e.target.closest('#customer-dropdown')) {
                document.getElementById('customer-dropdown')?.classList.add('hidden');
            }
        });
        // ===================== END CUSTOMER SEARCH =====================

        async function completePosTransaction(method) {
            const billCode = `HD-${Date.now().toString().slice(-4)}`;
            const total = posCart.reduce((sum, i) => sum + (i.price * i.qty), 0);
            const token = localStorage.getItem('auth_token');

            if (!token) {
                showToast('Chưa đăng nhập', 'Vui lòng đăng nhập tài khoản Nhân viên để tạo đơn!', 'error');
                return;
            }

            // Khách hàng: Lấy từ khách đã chọn, hoặc từ chuỗi đã gõ trong input, hoặc null để backend tự động sinh "Khách vãng lai #xxxx"
            const typedCustomerName = document.getElementById('pos-customer-search')?.value?.trim();
            let customerName = posCustomer ? posCustomer.name : (typedCustomerName || null);
            let customerId = posCustomer ? posCustomer.id : null;

            try {
                const payload = {
                    customerId: customerId,
                    customerName: customerName,
                    items: posCart.map(item => ({
                        productId: item.id,
                        productName: item.name,
                        unitPrice: item.price,
                        quantity: item.qty
                    })),
                    discountAmount: 0,
                    paymentMethod: method,
                    note: orderType === 'DINE_IN' ? 'Uống tại quán (POS)' : 'Khách mang về (POS)',
                    returnUrl: window.location.origin + '/Staff/Orders'
                };

                const res = await fetch('http://localhost:5003/api/orders', {
                    method: 'POST',
                    headers: {
                        'Content-Type': 'application/json',
                        'Authorization': `Bearer ${token}`
                    },
                    body: JSON.stringify(payload)
                });

                const data = await res.json().catch(() => null);
                const created = data?.data || {};

                if (!res.ok) {
                    const msg = (data && data.message) || (data && data.errors && data.errors[0]) || 'Không thể tạo đơn hàng.';
                    showToast('Lỗi thanh toán', msg, 'error');
                    return;
                }

                if (method === 'VNPAY') {
                    const vnpayUrl = created?.vnPayPayment?.paymentUrl;
                    if (vnpayUrl) {
                        clearPosTicket();
                        showToast('Chuyển hướng VNPay', 'Đang chuyển hướng sang cổng thanh toán VNPay...', 'info', 2000);
                        setTimeout(() => {
                            window.location.href = vnpayUrl;
                        }, 500);
                        return;
                    } else {
                        showToast('Lỗi VNPay', 'Đơn hàng đã tạo nhưng máy chủ không trả về URL thanh toán VNPay.', 'error');
                        return;
                    }
                }

                showToast('Thanh toán thành công', `Hóa đơn #${created.orderCode || billCode} (${total.toLocaleString('vi-VN')} đ) đã lưu hệ thống!`, 'success');
                clearPosTicket();
                clearCustomer();
                await loadPosOrdersList();
            } catch (e) {
                console.error(e);
                showToast('Lỗi kết nối', 'Không thể kết nối đến máy chủ Order.API', 'error');
            }
        }

        function switchView(view) {
            const posView = document.getElementById('view-pos');
            const ordersView = document.getElementById('view-orders');
            const btnPos = document.getElementById('tab-btn-pos');
            const btnOrders = document.getElementById('tab-btn-orders');

            if (view === 'pos') {
                posView.classList.remove('hidden');
                ordersView.classList.add('hidden');
                btnPos.className = 'px-5 py-2.5 rounded-xl bg-white text-gray-900 shadow-sm transition flex items-center gap-2';
                btnOrders.className = 'px-5 py-2.5 rounded-xl text-gray-600 hover:text-gray-900 transition flex items-center gap-2';
            } else {
                ordersView.classList.remove('hidden');
                posView.classList.add('hidden');
                btnOrders.className = 'px-5 py-2.5 rounded-xl bg-white text-gray-900 shadow-sm transition flex items-center gap-2';
                btnPos.className = 'px-5 py-2.5 rounded-xl text-gray-600 hover:text-gray-900 transition flex items-center gap-2';
                loadPosOrdersList();
            }
        }

        async function loadPosOrdersList() {
            const tbody = document.getElementById('pos-orders-table-body');
            if (!tbody) return;

            const token = localStorage.getItem('auth_token');

            try {
                const res = await fetch('http://localhost:5003/api/orders?pageNumber=1&pageSize=100', {
                    headers: {
                        'Authorization': `Bearer ${token}`
                    }
                });

                if (res.ok) {
                    const data = await res.json();
                    const items = data.data?.items || data.data || [];
                    if (Array.isArray(items)) {
                        posOrders = items.map(o => ({
                            id: o.id,
                            orderCode: o.orderCode ? `#${o.orderCode}` : `#${o.id.substring(0, 8).toUpperCase()}`,
                            customerName: o.customerName || 'Khách vãng lai',
                            itemsSummary: o.itemsSummary || `${o.totalItems || 1} món`,
                            totalAmount: o.finalAmount || o.totalAmount || 0,
                            paymentMethod: (o.paymentMethod || 'CASH').toUpperCase(),
                            paymentStatus: o.paymentStatus || 'UNPAID',
                            status: (o.status || 'PENDING').toUpperCase(),
                            note: o.note || '',
                            createdAt: o.createdAt
                        }));
                    }
                }
            } catch (err) {
                console.error('Không thể tải đơn hàng từ Order.API:', err);
            }

            tbody.innerHTML = '';

            // Cập nhật số đơn đang chờ xử lý
            const pendingCount = posOrders.filter(o => o.status === 'PENDING' || o.status === 'PROCESSING' || o.status === 'SHIPPING').length;
            const badge = document.getElementById('pending-orders-badge');
            if (badge) badge.innerText = pendingCount;

            if (posOrders.length === 0) {
                tbody.innerHTML = `
                    <tr>
                        <td colspan="8" class="py-12 text-center text-gray-400 font-medium">
                            <i class="fi fi-rr-inbox text-3xl block mb-2 text-gray-300"></i>
                            Chưa có đơn hàng nào tại quán
                        </td>
                    </tr>
                `;
                return;
            }

            posOrders.forEach(ord => {
                const tr = document.createElement('tr');
                tr.className = 'hover:bg-gray-50 transition';

                let statusBadge = '';
                let actionBtn = '';

                if (ord.status === 'PENDING') {
                    statusBadge = '<span class="px-3 py-1 rounded-full text-xs font-black bg-amber-100 text-amber-900 border border-amber-200 inline-flex items-center gap-1.5"><i class="fi fi-rr-hourglass-end text-[11px]"></i><span>Chờ xác nhận</span></span>';
                    actionBtn = `
                        <button type="button" onclick="updateOrderStatus('${ord.id}', 'PROCESSING')" class="px-3.5 py-2 rounded-xl bg-blue-600 hover:bg-blue-700 text-white font-bold text-xs shadow-sm transition active:scale-95 flex items-center gap-1.5">
                            <i class="fi fi-rr-coffee"></i>
                            <span>Bắt đầu pha chế</span>
                        </button>
                    `;
                } else if (ord.status === 'PROCESSING' || ord.status === 'CONFIRMED') {
                    statusBadge = '<span class="px-3 py-1 rounded-full text-xs font-black bg-blue-100 text-blue-900 border border-blue-200 inline-flex items-center gap-1.5"><i class="fi fi-rr-coffee text-[11px]"></i><span>Đang pha chế</span></span>';
                    actionBtn = `
                        <button type="button" onclick="updateOrderStatus('${ord.id}', 'SHIPPING')" class="px-3.5 py-2 rounded-xl bg-purple-600 hover:purple-700 text-white font-bold text-xs shadow-sm transition active:scale-95 flex items-center gap-1.5">
                            <i class="fi fi-rr-motorcycle"></i>
                            <span>Bắt đầu giao</span>
                        </button>
                    `;
                } else if (ord.status === 'SHIPPING' || ord.status === 'DELIVERING') {
                    statusBadge = '<span class="px-3 py-1 rounded-full text-xs font-black bg-purple-100 text-purple-900 border border-purple-200 animate-pulse inline-flex items-center gap-1.5"><i class="fi fi-rr-paper-plane text-[11px]"></i><span>Đang giao hàng</span></span>';
                    actionBtn = `
                        <button type="button" onclick="updateOrderStatus('${ord.id}', 'COMPLETED')" class="px-3.5 py-2 rounded-xl bg-emerald-600 hover:bg-emerald-700 text-white font-bold text-xs shadow-sm transition active:scale-95 flex items-center gap-1.5">
                            <i class="fi fi-rr-check"></i>
                            <span>Hoàn tất đơn</span>
                        </button>
                    `;
                } else if (ord.status === 'COMPLETED') {
                    statusBadge = '<span class="px-3 py-1 rounded-full text-xs font-black bg-emerald-100 text-emerald-900 border border-emerald-200 inline-flex items-center gap-1.5"><i class="fi fi-rr-check text-[11px]"></i><span>Đã hoàn thành</span></span>';
                    actionBtn = `<span class="text-xs text-emerald-700 font-bold italic inline-flex items-center gap-1"><i class="fi fi-rr-check-circle"></i> Đã hoàn tất</span>`;
                } else {
                    statusBadge = '<span class="px-3 py-1 rounded-full text-xs font-black bg-rose-100 text-rose-900 border border-rose-200 inline-flex items-center gap-1.5"><i class="fi fi-rr-cross-circle text-[11px]"></i><span>Đã hủy</span></span>';
                    actionBtn = `<span class="text-xs text-rose-500 font-bold italic inline-flex items-center gap-1"><i class="fi fi-rr-cross"></i> Đã hủy</span>`;
                }

                tr.innerHTML = `
                    <td class="py-4 px-4 font-black font-mono text-red-highland text-sm">${ord.orderCode}</td>
                    <td class="py-4 px-4">
                        <div class="flex items-center gap-2">
                            <span class="w-7 h-7 rounded-full bg-gray-200 flex items-center justify-center text-xs font-black text-gray-600 flex-shrink-0">${(ord.customerName||'K')[0].toUpperCase()}</span>
                            <span class="font-semibold text-gray-900 text-sm truncate max-w-[130px]">${ord.customerName || 'Khách vãng lai'}</span>
                        </div>
                    </td>
                    <td class="py-4 px-4 font-semibold text-gray-900 max-w-xs text-sm">${ord.itemsSummary}</td>
                    <td class="py-4 px-4 font-black text-gray-900 text-sm">${ord.totalAmount.toLocaleString('vi-VN')} đ</td>
                    <td class="py-4 px-4">
                        ${(ord.paymentStatus === 'SUCCESS' || ord.paymentStatus === 'PAID') ? `
                            <span class="px-2.5 py-1 rounded-lg text-xs font-bold inline-flex items-center gap-1.5 bg-emerald-50 text-emerald-800 border border-emerald-200">
                                <i class="fi fi-rr-check-circle text-xs text-emerald-600"></i>
                                <span>${PAY_METHOD_VI[ord.paymentMethod] || ord.paymentMethod} (Đã thanh toán)</span>
                            </span>
                        ` : `
                            <div class="flex items-center gap-1.5 flex-wrap">
                                <span class="px-2.5 py-1 rounded-lg text-xs font-bold inline-flex items-center gap-1.5 bg-amber-50 text-amber-800 border border-amber-200">
                                    <i class="fi fi-rr-time-half-past text-xs text-amber-600"></i>
                                    <span>${PAY_METHOD_VI[ord.paymentMethod] || ord.paymentMethod} (Chờ thanh toán)</span>
                                </span>
                                ${ord.paymentMethod === 'CASH' ? `
                                    <button type="button" onclick="confirmCashPayment('${ord.id}')" class="px-2 py-0.5 rounded-md bg-emerald-600 hover:bg-emerald-700 text-white font-bold text-[11px] shadow-sm transition active:scale-95" title="Xác nhận khách đã đưa tiền mặt">
                                        Thu tiền
                                    </button>
                                ` : ''}
                            </div>
                        `}
                    </td>
                    <td class="py-4 px-4">${statusBadge}</td>
                    <td class="py-4 px-4 text-center">
                        <div class="flex items-center justify-center gap-2">
                            <button type="button" onclick="viewOrderDetailModal('${ord.id}')" class="p-2 rounded-xl bg-gray-100 hover:bg-gray-200 text-gray-700 transition" title="Xem chi tiết đơn">
                                <i class="fi fi-rr-eye text-base flex items-center"></i>
                            </button>
                            ${actionBtn}
                        </div>
                    </td>
                `;

                tbody.appendChild(tr);
            });
        }

        async function updateOrderStatus(orderId, nextStatus) {
            const token = localStorage.getItem('auth_token');
            try {
                const res = await fetch(`http://localhost:5003/api/orders/${orderId}/status`, {
                    method: 'PUT',
                    headers: {
                        'Content-Type': 'application/json',
                        'Authorization': `Bearer ${token}`
                    },
                    body: JSON.stringify({ status: nextStatus })
                });

                if (!res.ok) {
                    const err = await res.json().catch(() => null);
                    showToast('Lỗi cập nhật', err?.message || 'Không thể chuyển trạng thái đơn hàng', 'danger');
                    return;
                }

                const statusNames = {
                    'PROCESSING': 'Đang pha chế',
                    'SHIPPING': 'Đang giao hàng',
                    'COMPLETED': 'Đã hoàn thành',
                    'CANCELLED': 'Đã hủy'
                };
                showToast('Cập nhật trạng thái', `Đơn hàng đã chuyển sang "${statusNames[nextStatus] || nextStatus}"`, 'success');
                await loadPosOrdersList();
            } catch (e) {
                console.error(e);
                showToast('Lỗi kết nối', 'Không thể kết nối đến máy chủ Order.API', 'danger');
            }
        }

        async function viewOrderDetailModal(orderId) {
            const token = localStorage.getItem('auth_token');
            try {
                const res = await fetch(`http://localhost:5003/api/orders/${orderId}`, {
                    headers: {
                        'Authorization': `Bearer ${token}`
                    }
                });

                if (!res.ok) {
                    alert('Không thể tải chi tiết đơn hàng.');
                    return;
                }

                const resJson = await res.json();
                const order = resJson.data || resJson;
                if (!order) return;

                document.getElementById('detail-order-code').innerText = order.orderCode ? `#${order.orderCode}` : `#${order.id.substring(0, 8).toUpperCase()}`;
                
                const d = new Date(order.createdAt);
                document.getElementById('detail-order-time').innerText = d.toLocaleDateString('vi-VN', {
                    hour: '2-digit', minute: '2-digit', day: '2-digit', month: '2-digit', year: 'numeric'
                });

                // Dịch trạng thái sang tiếng Việt
                const statusVI = STATUS_VI[(order.status || '').toUpperCase()] || order.status || 'Không rõ';
                document.getElementById('detail-order-status').innerText = statusVI;

                // Dịch phương thức và trạng thái thanh toán sang tiếng Việt
                const pmVI = PAY_METHOD_VI[(order.paymentMethod || '').toUpperCase()] || order.paymentMethod || 'Tiền mặt';
                const psVI = PAY_STATUS_VI[(order.paymentStatus || '').toUpperCase()] || order.paymentStatus || 'Chưa thanh toán';
                document.getElementById('detail-order-payment').innerText = `${pmVI} — ${psVI}`;
                document.getElementById('detail-order-total').innerText = `${(order.finalAmount || order.totalAmount || 0).toLocaleString('vi-VN')} đ`;

                // Hiển thị tên khách hàng trong modal
                const customerNameEl = document.getElementById('detail-customer-name');
                if (customerNameEl) customerNameEl.innerText = order.customerName || 'Khách vãng lai';

                const itemsBox = document.getElementById('detail-items-list');
                if (order.items && order.items.length > 0) {
                    itemsBox.innerHTML = order.items.map(item => `
                        <div class="py-2.5 px-3 flex items-center justify-between text-xs">
                            <div>
                                <div class="font-bold text-gray-900">${item.productName || 'Đồ uống'}</div>
                                <div class="text-gray-500">${item.optionsSummary || 'Tiêu chuẩn'}</div>
                            </div>
                            <div class="text-right">
                                <div class="font-black text-gray-900">${(item.subtotal || item.unitPrice * item.quantity).toLocaleString('vi-VN')} đ</div>
                                <div class="text-gray-500">x${item.quantity} (${(item.unitPrice || 0).toLocaleString('vi-VN')} đ)</div>
                            </div>
                        </div>
                    `).join('');
                } else {
                    itemsBox.innerHTML = `<div class="p-3 text-xs text-gray-500 italic text-center">Chi tiết các món được lưu trong hóa đơn tổng</div>`;
                }

                const noteBox = document.getElementById('detail-note-box');
                if (order.note) {
                    noteBox.classList.remove('hidden');
                    document.getElementById('detail-order-note').innerText = order.note;
                } else {
                    noteBox.classList.add('hidden');
                }

                document.getElementById('modal-order-detail').classList.remove('hidden');
                document.getElementById('modal-order-detail').classList.add('flex');
            } catch(e) {
                console.error(e);
                alert('Lỗi kết nối khi tải chi tiết đơn hàng.');
            }
        }

        function closeOrderDetailModal() {
            document.getElementById('modal-order-detail').classList.add('hidden');
            document.getElementById('modal-order-detail').classList.remove('flex');
        }

        // Khởi tạo
        document.addEventListener('DOMContentLoaded', () => {
            const now = new Date();
            const timeEl = document.getElementById('pos-time');
            if (timeEl) timeEl.innerText = now.toLocaleTimeString('vi-VN', { hour: '2-digit', minute: '2-digit' });

            // Đồng bộ tên nhân viên đăng nhập
            try {
                const userStr = localStorage.getItem('current_user');
                if (userStr) {
                    const user = JSON.parse(userStr);
                    const bEl = document.getElementById('pos-staff-badge');
                    if (bEl && user.fullName) bEl.innerText = user.fullName;
                }
            } catch (e) {}

            loadProductsFromApi();
            renderTicket();
            checkVnPayPosCallback();

            // Kiểm tra query param để tự động mở tab Điều phối đơn nếu được gọi từ menu Đơn hàng
            const urlParams = new URLSearchParams(window.location.search);
            if (urlParams.get('view') === 'orders' || urlParams.get('tab') === 'orders') {
                switchView('orders');
            } else {
                switchView('pos');
            }

            // Tự động đồng bộ danh sách đơn hàng thực tế mỗi 10 giây
            setInterval(() => {
                loadPosOrdersList();
            }, 10000);
        });

        async function confirmCashPayment(orderId) {
            const token = localStorage.getItem('auth_token');
            if (!token) {
                showToast('Chưa đăng nhập', 'Vui lòng đăng nhập tài khoản Nhân viên', 'error');
                return;
            }
            try {
                const res = await fetch(`http://localhost:5003/api/payments/${orderId}/cash-confirm`, {
                    method: 'PUT',
                    headers: {
                        'Content-Type': 'application/json',
                        'Authorization': `Bearer ${token}`
                    }
                });
                if (res.ok) {
                    showToast('Đã thu tiền', 'Xác nhận thanh toán tiền mặt thành công! Đơn đã chuyển sang pha chế.', 'success');
                    await loadPosOrdersList();
                } else {
                    const err = await res.json().catch(() => null);
                    showToast('Không thành công', err?.message || 'Không thể xác nhận thanh toán tiền mặt.', 'error');
                }
            } catch (e) {
                console.error(e);
                showToast('Lỗi kết nối', 'Không thể kết nối đến máy chủ Order.API', 'error');
            }
        }

        async function checkVnPayPosCallback() {
            const params = new URLSearchParams(window.location.search);
            const responseCode = params.get('vnp_ResponseCode');
            const txnRef = params.get('vnp_TxnRef');
            const amount = params.get('vnp_Amount');

            if (responseCode) {
                try {
                    // Đồng bộ kết quả VNPay Return sang Order.API để cập nhật trạng thái đơn hàng sang SUCCESS
                    const res = await fetch(`http://localhost:5003/api/payments/vnpay-return${window.location.search}`);
                    const json = await res.json().catch(() => null);

                    if (responseCode === '00' && (res.ok || json?.isSuccess)) {
                        const formattedAmt = amount ? (parseInt(amount) / 100).toLocaleString('vi-VN') + ' đ' : '';
                        showToast('Thanh toán VNPay thành công', `Giao dịch ${txnRef || ''} (${formattedAmt}) đã thanh toán thành công qua VNPay!`, 'success', 6000);
                    } else {
                        showToast('Thanh toán chưa hoàn tất', json?.message || 'Giao dịch qua VNPay đã bị hủy hoặc chưa hoàn tất.', 'warning', 5000);
                    }
                } catch (e) {
                    console.error('Lỗi gọi API VNPay Return:', e);
                } finally {
                    window.history.replaceState({}, document.title, window.location.pathname);
                    await loadPosOrdersList();
                }
            }
        }
    </script>
}
