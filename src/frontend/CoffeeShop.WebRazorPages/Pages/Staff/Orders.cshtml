@section Scripts {
    <script>
        let posCart = [];
        let posVoucherDiscount = 0;
        let selectedCategory = 'ALL';
        let posCurrentCustomer = null;
        let posCustomerVouchers = [];

        document.addEventListener('DOMContentLoaded', () => {
            renderPosCart();
        });

        function filterPosCategory(catId, btn) {
            selectedCategory = catId;
            document.querySelectorAll('#posCategoryPills .pos-cat-btn').forEach(b => {
                b.className = 'pos-cat-btn px-4 py-2 rounded-xl text-xs font-extrabold bg-slate-100 text-slate-700 hover:bg-slate-200 transition';
            });
            btn.className = 'pos-cat-btn px-4 py-2 rounded-xl text-xs font-extrabold bg-slate-900 text-white transition';
            filterPosProducts();
        }

        function filterPosProducts() {
            const kw = (document.getElementById('posSearchInput')?.value || '').trim().toLowerCase();
            document.querySelectorAll('#posProductGrid .pos-product-card').forEach(card => {
                const cat = card.getAttribute('data-category');
                const name = card.getAttribute('data-name') || '';
                const matchCat = selectedCategory === 'ALL' || cat === selectedCategory;
                const matchKw = !kw || name.includes(kw);
                card.style.display = (matchCat && matchKw) ? '' : 'none';
            });
        }

        function addPosItem(productId, productName, unitPrice, size) {
            const existing = posCart.find(i => i.productId === productId && i.size === size);
            if (existing) {
                existing.quantity += 1;
            } else {
                posCart.push({
                    productId,
                    productName,
                    unitPrice: parseFloat(unitPrice),
                    quantity: 1,
                    size,
                    optionsSummary: 'Size ' + size
                });
            }
            renderPosCart();
        }

        function updatePosQty(idx, delta) {
            if (!posCart[idx]) return;
            posCart[idx].quantity += delta;
            if (posCart[idx].quantity <= 0) posCart.splice(idx, 1);
            renderPosCart();
        }

        function clearPosCart() {
            posCart = [];
            posVoucherDiscount = 0;
            const dInput = document.getElementById('posDiscountInput');
            if (dInput) dInput.value = '0';
            const ptsInput = document.getElementById('posPointsInput');
            if (ptsInput) ptsInput.value = '0';
            const vInput = document.getElementById('posVoucherInput');
            if (vInput) vInput.value = '';
            const vMsg = document.getElementById('posVoucherMsg');
            if (vMsg) vMsg.innerHTML = '';
            renderPosCart();
        }

        function clearPosCustomer() {
            posCurrentCustomer = null;
            posCustomerVouchers = [];
            const idInput = document.getElementById('posCustomerIdInput');
            if (idInput) idInput.value = '';
            const phoneInput = document.getElementById('posCustomerPhoneInput');
            if (phoneInput) phoneInput.value = '';
            const ptsInput = document.getElementById('posPointsInput');
            if (ptsInput) ptsInput.value = '0';
            const card = document.getElementById('posMemberCard');
            if (card) card.classList.add('hidden');
            const msg = document.getElementById('posPhoneLookupMsg');
            if (msg) msg.innerHTML = '';
            const earnBox = document.getElementById('posEarnPointsPreview');
            if (earnBox) earnBox.classList.add('hidden');
            const subtotal = posCart.reduce((s, i) => s + i.unitPrice * i.quantity, 0);
            updatePosTotals(subtotal);
        }

        async function lookupPosCustomerByPhone() {
            const phone = (document.getElementById('posCustomerPhoneInput')?.value || '').trim();
            const msgEl = document.getElementById('posPhoneLookupMsg');
            const cardEl = document.getElementById('posMemberCard');
            const subtotal = posCart.reduce((s, i) => s + i.unitPrice * i.quantity, 0);

            if (!phone) {
                if (msgEl) msgEl.innerHTML = '<span class="text-red-600 font-bold">Vui lòng nhập số điện thoại khách hàng.</span>';
                return;
            }

            if (msgEl) msgEl.innerHTML = '<span class="text-slate-500 font-semibold">Đang kiểm tra tài khoản thành viên...</span>';

            try {
                const res = await fetch(`/Staff/Orders?handler=LookupCustomer&phone=${encodeURIComponent(phone)}&orderAmount=${subtotal}`, {
                    headers: { 'Accept': 'application/json' }
                });
                if (res.redirected && res.url && res.url.includes('/Auth/Login')) {
                    if (msgEl) msgEl.innerHTML = '<span class="text-red-600 font-bold">Phiên đăng nhập đã hết hạn. Vui lòng đăng nhập lại.</span>';
                    return;
                }
                const contentType = res.headers.get('content-type') || '';
                if (!res.ok || !contentType.includes('application/json')) {
                    if (msgEl) msgEl.innerHTML = `<span class="text-red-600 font-bold">Không thể tra cứu số điện thoại (HTTP ${res.status}).</span>`;
                    return;
                }
                const data = await res.json();

                if (data.isSuccess && data.customer) {
                    posCurrentCustomer = data.customer;
                    posCustomerVouchers = data.vouchers || [];

                    document.getElementById('posCustomerIdInput').value = data.customer.id;
                    const nameInput = document.getElementById('posCustomerNameInput');
                    if (nameInput && !nameInput.value.trim()) {
                        nameInput.value = data.customer.fullName;
                    }

                    document.getElementById('posMemberName').textContent = `${data.customer.fullName} (${data.customer.phoneNumber})`;
                    document.getElementById('posMemberTier').textContent = data.customer.tierName || 'Hạng Đồng';
                    const benefitBadge = document.getElementById('posMemberBenefitBadge');
                    if (benefitBadge) {
                        const dp = parseFloat(data.customer.discountPercent || 0);
                        const mult = parseFloat(data.customer.pointMultiplier || 1.0);
                        benefitBadge.textContent = `Giảm ${dp}% • Tích điểm x${mult}`;
                    }
                    document.getElementById('posMemberPoints').textContent = (data.customer.currentPoints || 0).toLocaleString('vi-VN');
                    document.getElementById('posMemberPointsValue').textContent = ((data.customer.currentPoints || 0) * 1000).toLocaleString('vi-VN') + ' đ';

                    const ptsInput = document.getElementById('posPointsInput');
                    if (ptsInput) {
                        ptsInput.max = data.customer.currentPoints || 0;
                        ptsInput.value = '0';
                    }

                    if (cardEl) cardEl.classList.remove('hidden');
                    if (msgEl) msgEl.innerHTML = `<span class="text-emerald-700 font-bold">✓ ${data.message}</span>`;

                    renderPosCustomerVouchers(subtotal);
                    updatePosTotals(subtotal);
                } else {
                    posCurrentCustomer = null;
                    posCustomerVouchers = [];
                    document.getElementById('posCustomerIdInput').value = '';
                    if (cardEl) cardEl.classList.add('hidden');
                    if (msgEl) msgEl.innerHTML = `<span class="text-red-600 font-bold">✕ ${data.message || 'Không tìm thấy tài khoản.'}</span>`;
                    updatePosTotals(subtotal);
                }
            } catch {
                if (msgEl) msgEl.innerHTML = '<span class="text-red-600 font-bold">Lỗi kết nối khi tra cứu số điện thoại.</span>';
            }
        }

        function renderPosCustomerVouchers(subtotal) {
            const listEl = document.getElementById('posMemberVouchersList');
            const countEl = document.getElementById('posEligibleVoucherCount');
            if (!listEl) return;

            if (!posCustomerVouchers || posCustomerVouchers.length === 0) {
                listEl.innerHTML = '<div class="text-[11px] text-slate-500 italic py-1">Khách hàng đã sử dụng hết hoặc hiện không có voucher khả dụng.</div>';
                if (countEl) countEl.textContent = '0 mã';
                return;
            }

            let eligibleCount = 0;
            let html = '';

            posCustomerVouchers.forEach(v => {
                const isEligible = subtotal >= (v.minOrderValue || 0);
                if (isEligible) eligibleCount++;

                const discountDesc = v.discountType === 'PERCENTAGE'
                    ? `-${v.discountValue}%` + (v.maxDiscountAmount ? ` (tối đa ${Number(v.maxDiscountAmount).toLocaleString('vi-VN')}đ)` : '')
                    : `-${Number(v.discountValue).toLocaleString('vi-VN')}đ`;

                const badgeHtml = isEligible
                    ? `<span class="px-2 py-0.5 rounded-lg bg-emerald-600 text-white text-[10px] font-extrabold shrink-0">Đủ ĐK • Áp dụng</span>`
                    : `<span class="px-2 py-0.5 rounded-lg bg-slate-200 text-slate-600 text-[10px] font-bold shrink-0">Đơn từ ${Number(v.minOrderValue).toLocaleString('vi-VN')}đ</span>`;

                html += `
                    <button type="button"
                            onclick="selectPosCustomerVoucher('${v.code}')"
                            class="w-full text-left p-2 rounded-xl border transition flex items-center justify-between gap-2 ${isEligible ? 'bg-white hover:bg-emerald-50 border-emerald-300 cursor-pointer' : 'bg-white/60 border-slate-200 opacity-70'}">
                        <div class="min-w-0">
                            <div class="text-xs font-black text-slate-900 flex items-center gap-1">
                                <i class="fi fi-rr-ticket text-red-highland"></i>
                                <span>${v.code}</span>
                                <span class="text-red-highland font-extrabold">(${discountDesc})</span>
                            </div>
                            <div class="text-[10px] text-slate-500 truncate">${v.title || ''} • Tối thiểu ${Number(v.minOrderValue || 0).toLocaleString('vi-VN')}đ</div>
                        </div>
                        ${badgeHtml}
                    </button>`;
            });

            listEl.innerHTML = html;
            if (countEl) {
                countEl.textContent = `${eligibleCount}/${posCustomerVouchers.length} mã đủ ĐK đơn hiện tại`;
            }
        }

        function selectPosCustomerVoucher(code) {
            const vInput = document.getElementById('posVoucherInput');
            if (vInput) {
                vInput.value = code;
                applyPosVoucher();
            }
        }

        function onPosPointsInput() {
            const subtotal = posCart.reduce((s, i) => s + i.unitPrice * i.quantity, 0);
            updatePosTotals(subtotal);
        }

        function applyMaxPosPoints() {
            if (!posCurrentCustomer) return;
            const subtotal = posCart.reduce((s, i) => s + i.unitPrice * i.quantity, 0);
            const tierDiscountPct = parseFloat(posCurrentCustomer.discountPercent || 0);
            const tierDiscount = Math.round(subtotal * (tierDiscountPct / 100));
            const availPts = parseInt(posCurrentCustomer.currentPoints || 0);
            const remaining = Math.max(0, subtotal - tierDiscount - posVoucherDiscount);
            const maxForOrder = Math.floor(remaining / 1000);
            const ptsToUse = Math.min(availPts, maxForOrder);
            const ptsInput = document.getElementById('posPointsInput');
            if (ptsInput) {
                ptsInput.value = ptsToUse;
            }
            updatePosTotals(subtotal);
        }

        function renderPosCart() {
            const container = document.getElementById('posCartContainer');
            const jsonInput = document.getElementById('posCartJsonInput');
            const submitBtn = document.getElementById('posSubmitBtn');
            if (!container || !jsonInput) return;

            jsonInput.value = JSON.stringify(posCart);

            if (posCart.length === 0) {
                container.innerHTML = '<div class="text-center text-slate-400 text-xs py-6">Chưa có món nào trong hóa đơn POS.</div>';
                if (submitBtn) submitBtn.disabled = true;
                renderPosCustomerVouchers(0);
                updatePosTotals(0);
                return;
            }

            if (submitBtn) submitBtn.disabled = false;
            let subtotal = 0;
            let html = '';

            posCart.forEach((item, idx) => {
                const line = item.unitPrice * item.quantity;
                subtotal += line;
                html += `
                    <div class="py-2 flex items-center justify-between gap-2">
                        <div class="min-w-0 flex-1">
                            <div class="text-xs font-extrabold text-slate-900 truncate">${item.productName} (${item.size})</div>
                            <div class="text-[11px] text-slate-500">${item.unitPrice.toLocaleString('vi-VN')} đ</div>
                        </div>
                        <div class="flex items-center gap-1">
                            <button type="button" onclick="updatePosQty(${idx}, -1)" class="w-6 h-6 rounded-lg bg-white border border-slate-300 text-xs font-black">-</button>
                            <span class="px-1.5 text-xs font-black">${item.quantity}</span>
                            <button type="button" onclick="updatePosQty(${idx}, 1)" class="w-6 h-6 rounded-lg bg-white border border-slate-300 text-xs font-black">+</button>
                        </div>
                    </div>`;
            });

            container.innerHTML = html;
            if (posCurrentCustomer) {
                renderPosCustomerVouchers(subtotal);
            }
            updatePosTotals(subtotal);
        }

        function updatePosTotals(subtotal) {
            const tierDiscountPct = posCurrentCustomer ? (parseFloat(posCurrentCustomer.discountPercent || 0)) : 0;
            const tierName = posCurrentCustomer ? (posCurrentCustomer.tierName || 'Hạng thẻ') : 'Hạng thẻ';
            const tierDiscount = Math.round(subtotal * (tierDiscountPct / 100));
            const remainingAfterTier = Math.max(0, subtotal - tierDiscount);

            if (posVoucherDiscount > remainingAfterTier) posVoucherDiscount = remainingAfterTier;

            let requestedPts = parseInt(document.getElementById('posPointsInput')?.value || '0') || 0;
            if (requestedPts < 0) requestedPts = 0;
            const maxMemberPts = posCurrentCustomer ? (parseInt(posCurrentCustomer.currentPoints || 0)) : 0;
            if (requestedPts > maxMemberPts) requestedPts = maxMemberPts;

            const remainingAfterVoucher = Math.max(0, remainingAfterTier - posVoucherDiscount);
            const maxPtsForOrder = Math.floor(remainingAfterVoucher / 1000);
            if (requestedPts > maxPtsForOrder) requestedPts = maxPtsForOrder;

            const ptsInput = document.getElementById('posPointsInput');
            if (ptsInput && parseInt(ptsInput.value || '0') !== requestedPts) {
                ptsInput.value = requestedPts;
            }

            const pointsDiscount = requestedPts * 1000;
            const totalDiscount = Math.min(subtotal, tierDiscount + posVoucherDiscount + pointsDiscount);
            const finalAmt = Math.max(0, subtotal - totalDiscount);

            document.getElementById('posSubtotalLabel').textContent = subtotal.toLocaleString('vi-VN') + ' đ';
            const tierTitleEl = document.getElementById('posTierDiscountTitle');
            if (tierTitleEl) {
                tierTitleEl.textContent = `Đặc quyền ${tierName} (-${tierDiscountPct}%):`;
            }
            const tierLabelEl = document.getElementById('posTierDiscountLabel');
            if (tierLabelEl) {
                tierLabelEl.textContent = '-' + tierDiscount.toLocaleString('vi-VN') + ' đ';
            }
            document.getElementById('posDiscountLabel').textContent = '-' + posVoucherDiscount.toLocaleString('vi-VN') + ' đ';
            const ptsLabel = document.getElementById('posPointsDiscountLabel');
            if (ptsLabel) {
                ptsLabel.textContent = '-' + pointsDiscount.toLocaleString('vi-VN') + ' đ (' + requestedPts + ' điểm)';
            }
            document.getElementById('posFinalLabel').textContent = finalAmt.toLocaleString('vi-VN') + ' đ';
            document.getElementById('posDiscountInput').value = totalDiscount;

            const earnBox = document.getElementById('posEarnPointsPreview');
            const earnLabel = document.getElementById('posEarnPointsLabel');
            if (earnBox && earnLabel) {
                if (posCurrentCustomer && subtotal > 0) {
                    const mult = parseFloat(posCurrentCustomer.pointMultiplier || 1.0);
                    const estEarn = Math.max(1, Math.round((finalAmt / 10000) * mult));
                    earnLabel.textContent = `+${estEarn.toLocaleString('vi-VN')} điểm`;
                    earnBox.classList.remove('hidden');
                } else {
                    earnBox.classList.add('hidden');
                }
            }
        }

        function togglePosCashOption(method) {
            const grp = document.getElementById('collectCashNowGroup');
            if (grp) grp.style.display = method === 'CASH' ? 'flex' : 'none';
        }

        async function applyPosVoucher() {
            const code = (document.getElementById('posVoucherInput')?.value || '').trim();
            const msgEl = document.getElementById('posVoucherMsg');
            const subtotal = posCart.reduce((s, i) => s + i.unitPrice * i.quantity, 0);
            const customerId = document.getElementById('posCustomerIdInput')?.value || '';
            if (!code) {
                posVoucherDiscount = 0;
                if (msgEl) msgEl.innerHTML = '';
                updatePosTotals(subtotal);
                return;
            }

            try {
                let url = `/Staff/Orders?handler=ValidateVoucher&code=${encodeURIComponent(code)}&orderAmount=${subtotal}`;
                if (customerId) {
                    url += `&customerId=${encodeURIComponent(customerId)}`;
                }
                const res = await fetch(url);
                const data = await res.json();
                if (data.isSuccess) {
                    posVoucherDiscount = parseFloat(data.discountAmount || 0);
                    msgEl.innerHTML = `<span class="text-emerald-700 font-bold">✓ ${data.message}</span>`;
                } else {
                    posVoucherDiscount = 0;
                    msgEl.innerHTML = `<span class="text-red-600 font-bold">✕ ${data.message}</span>`;
                }
                updatePosTotals(subtotal);
            } catch {
                msgEl.innerHTML = '<span class="text-red-600 font-bold">Lỗi kiểm tra voucher.</span>';
            }
        }

        function openStaffCancelModal(orderId, orderCode) {
            document.getElementById('staffCancelOrderId').value = orderId;
            document.getElementById('staffCancelOrderCode').textContent = '#' + orderCode;
            const modal = document.getElementById('staffCancelModal');
            modal.classList.remove('hidden');
            modal.classList.add('flex');
        }

        function closeStaffCancelModal() {
            const modal = document.getElementById('staffCancelModal');
            modal.classList.add('hidden');
            modal.classList.remove('flex');
        }
    </script>
}
