@page
@model CoffeeShop.WebRazorPages.Pages.Staff.OrdersModel
@{
    Layout = "_StaffLayout";
    ViewData["Title"] = "Màn hình Thu ngân POS & Điều phối đơn - Nhân viên";
}

<!-- ========================================================================= -->
<!-- GIAO DIỆN NHÂN VIÊN (STAFF UI) - QUẦY THU NGÂN POS & ĐIỀU PHỐI ĐƠN HÀNG   -->
<!-- Đáp ứng đầy đủ 8/8 chức năng của Staff trong ma trận phân quyền (22-29):  -->
<!-- - Mục 22: Create Order (Staff tạo đơn trực tiếp tại quán / POS)           -->
<!-- - Mục 23: View Order List (Staff xem toàn bộ đơn hàng trên hệ thống)      -->
<!-- - Mục 24: View Order Detail (Xem thông tin chi tiết items, giá tiền)      -->
<!-- - Mục 25: Search & Filter Order (Tìm kiếm mã đơn/tên khách & lọc trạng thái)-->
<!-- - Mục 26: Update Order Status (Pending -> Processing -> Shipping -> Completed)-->
<!-- - Mục 27: Cancel Order (Staff hủy đơn kèm lý do bắt buộc)                 -->
<!-- - Mục 28: Generate VNPay QR (Tạo mã QR VNPay để khách thanh toán đơn)     -->
<!-- - Mục 29: Confirm Payment (Staff xác nhận thu tiền mặt hoặc VNPay tự động)-->
<!-- ========================================================================= -->
<div class="w-full px-4 sm:px-6 lg:px-8 py-5 space-y-6">
    <!-- Thanh tiêu đề & Chuyển đổi chế độ (Bán hàng tại quầy POS <-> Điều phối đơn hàng) -->
    <div class="flex flex-col sm:flex-row sm:items-center justify-between pb-4 border-b border-gray-200 gap-4">
        <div class="flex items-center gap-3.5">
            <span class="w-12 h-12 rounded-2xl bg-red-highland text-white flex items-center justify-center font-black text-xl shadow-md">
                POS
            </span>
            <div>
                <h1 class="text-2xl sm:text-3xl font-black text-gray-900 tracking-tight flex items-center gap-3">
                    <span>Quầy Thu ngân POS & Điều phối đơn</span>
                    <span class="px-3 py-1 rounded-full bg-blue-100 text-blue-900 text-xs font-black uppercase border border-blue-200">Staff</span>
                </h1>
                <p class="text-sm text-gray-500 font-medium mt-0.5">
                    Nhân viên trực ca: <span class="font-bold text-gray-800" id="pos-staff-badge">Nhân viên POS</span> • Tạo đơn tại quán & Điều phối trạng thái
                </p>
            </div>
        </div>

        <div class="flex items-center gap-3">
            <!-- Bộ nút chuyển đổi giữa 2 màn hình nghiệp vụ của Staff -->
            <div class="bg-gray-200 p-1.5 rounded-2xl flex items-center gap-1.5 text-sm font-bold shadow-inner">
                <button type="button" id="tab-btn-pos" onclick="switchView('pos')" class="px-5 py-2.5 rounded-xl bg-white text-gray-900 shadow-sm transition flex items-center gap-2">
                    <i class="fi fi-rr-shopping-cart text-base text-red-highland flex items-center"></i>
                    <span>Bán hàng tại quầy (POS)</span>
                </button>
                <button type="button" id="tab-btn-orders" onclick="switchView('orders')" class="px-5 py-2.5 rounded-xl text-gray-600 hover:text-gray-900 transition flex items-center gap-2">
                    <i class="fi fi-rr-clipboard-list text-base flex items-center"></i>
                    <span>Điều phối đơn hàng</span>
                    <span id="pending-orders-badge" class="px-2 py-0.5 rounded-full bg-red-highland text-white text-xs font-black shadow-sm">0</span>
                </button>
            </div>
        </div>
    </div>

    <!-- ========================================================================= -->
    <!-- VIEW 1: MÀN HÌNH BÁN HÀNG TẠI QUẦY POS (Mục 22: Staff tạo đơn tại quán)   -->
    <!-- ========================================================================= -->
    <div id="view-pos" class="grid grid-cols-1 lg:grid-cols-12 gap-6 items-start">
        <!-- Cột trái (8 cột): Danh mục & Thực đơn sản phẩm tải động từ Product.API -->
        <div class="lg:col-span-8 space-y-4">
            <!-- Thanh tìm kiếm món & Lọc theo danh mục -->
            <div class="bg-white p-4 sm:p-5 rounded-2xl border border-gray-200 shadow-sm flex flex-col sm:flex-row gap-3.5 items-center justify-between">
                <div class="relative w-full sm:w-80">
                    <input type="text" id="pos-search" onkeyup="filterPosProducts()" placeholder="Tìm món nhanh theo tên..." class="w-full bg-gray-50 border border-gray-300 rounded-xl pl-11 pr-4 py-3 text-sm font-semibold text-gray-900 focus:ring-2 focus:ring-red-highland focus:bg-white placeholder-gray-400 transition" />
                    <span class="absolute left-3.5 top-3.5 text-gray-400">
                        <i class="fi fi-rr-search text-base flex items-center"></i>
                    </span>
                </div>

                <!-- Các nút lọc danh mục (Nạp từ Product.API) -->
                <div id="pos-category-pills" class="flex items-center gap-2 overflow-x-auto w-full sm:w-auto pb-1 sm:pb-0">
                    <button type="button" onclick="setCategoryFilter('ALL', this)" class="pos-cat-btn active px-4 py-2.5 rounded-xl text-sm font-bold bg-[#4F392E] text-white transition flex-shrink-0 shadow-sm flex items-center gap-1.5">
                        <i class="fi fi-rr-apps text-xs"></i>
                        <span>Tất cả món</span>
                    </button>
                </div>
            </div>

            <!-- Lưới hiển thị các món đồ uống (Chạm để thêm vào hóa đơn POS) -->
            <div id="pos-product-grid" class="grid grid-cols-2 sm:grid-cols-3 xl:grid-cols-4 gap-4">
            </div>
        </div>

        <!-- Cột phải (4 cột): Hóa đơn thu ngân POS hiện tại -->
        <div class="lg:col-span-4 sticky top-20">
            <div class="bg-white rounded-3xl p-5 sm:p-6 shadow-xl border border-gray-200 space-y-4">
                <!-- Đầu hóa đơn & Chọn hình thức phục vụ (Tại quán / Mang về) -->
                <div class="flex items-center justify-between pb-3.5 border-b border-gray-200">
                    <div>
                        <span id="pos-bill-code" class="text-sm font-black text-red-highland uppercase tracking-wider block">HÓA ĐƠN TẠI QUẦY</span>
                        <span class="text-xs text-gray-500 font-medium">Giờ mở ca: <span id="pos-time" class="font-bold text-gray-800">--:--</span></span>
                    </div>

                    <div class="bg-gray-100 p-1 rounded-xl flex text-xs font-bold">
                        <button type="button" id="btn-dine-in" onclick="setOrderType('DINE_IN')" class="px-3 py-1.5 rounded-lg bg-white shadow-sm text-gray-900 transition">Tại quán</button>
                        <button type="button" id="btn-take-away" onclick="setOrderType('TAKE_AWAY')" class="px-3 py-1.5 rounded-lg text-gray-500 hover:text-gray-900 transition">Mang về</button>
                    </div>
                </div>

                <!-- Tìm kiếm khách hàng thành viên qua Auth.API hoặc nhập tên khách lẻ -->
                <div class="pb-1 relative">
                    <div class="flex items-center justify-between mb-1.5">
                        <label class="text-xs font-black text-gray-500 uppercase tracking-wider block">Khách hàng</label>
                        <span class="text-[11px] text-gray-400 font-medium">Tìm thành viên hoặc nhập tên khách lẻ</span>
                    </div>
                    <div class="relative">
                        <input type="text" id="pos-customer-search"
                               oninput="searchCustomer(this.value)"
                               onfocus="if (this.value) searchCustomer(this.value)"
                               onclick="if (this.value) searchCustomer(this.value)"
                               onkeydown="if (event.key === 'Enter') { event.preventDefault(); selectFirstCustomer(); }"
                               placeholder="Nhập tên hoặc SĐT khách hàng..." autocomplete="off"
                               class="w-full bg-gray-50 border border-gray-200 rounded-xl pl-10 pr-4 py-2.5 text-sm font-semibold text-gray-900 focus:ring-2 focus:ring-red-highland focus:bg-white placeholder-gray-400 transition" />
                        <span class="absolute left-3 top-2.5 text-gray-400"><i class="fi fi-rr-user text-base flex items-center"></i></span>
                        <div id="customer-dropdown" class="absolute z-50 left-0 right-0 top-full mt-1.5 bg-white border border-gray-200 rounded-2xl shadow-2xl hidden max-h-64 overflow-y-auto divide-y divide-gray-100"></div>
                    </div>

                    <!-- Thẻ hiển thị khách hàng thành viên đã chọn -->
                    <div id="selected-customer-badge" class="hidden mt-2 p-3 bg-emerald-50 border-2 border-emerald-300 rounded-2xl text-xs text-emerald-900 shadow-sm">
                        <div class="flex items-center justify-between gap-2">
                            <div class="flex items-center gap-2.5 min-w-0">
                                <span class="w-8 h-8 rounded-full bg-emerald-600 text-white flex items-center justify-center text-sm font-black flex-shrink-0 shadow">
                                    <i class="fi fi-rr-check"></i>
                                </span>
                                <div class="truncate">
                                    <div class="flex items-center gap-1.5">
                                        <span class="text-[10px] font-black uppercase tracking-wider text-emerald-700 bg-emerald-100 px-1.5 py-0.5 rounded">Thành viên</span>
                                        <span id="selected-customer-name" class="font-black text-sm text-emerald-950 truncate">--</span>
                                    </div>
                                    <div class="text-xs text-emerald-800 font-semibold mt-0.5 flex items-center gap-2">
                                        <span id="selected-customer-phone">--</span>
                                        <span id="selected-customer-email" class="text-emerald-600 text-[11px] truncate"></span>
                                    </div>
                                </div>
                            </div>
                            <button type="button" onclick="clearCustomer()" class="px-2.5 py-1.5 rounded-xl bg-white hover:bg-red-50 text-red-600 border border-red-200 text-xs font-bold transition flex items-center gap-1 flex-shrink-0 shadow-sm">
                                <i class="fi fi-rr-cross text-xs"></i>
                                <span>Bỏ chọn</span>
                            </button>
                        </div>
                    </div>
                </div>

                <!-- Danh sách các món trong hóa đơn POS -->
                <div id="pos-ticket-items" class="max-h-[300px] overflow-y-auto space-y-3.5 divide-y divide-gray-100 pr-1">
                    <div id="pos-empty-cart-message" class="text-center py-10 text-gray-400 text-sm">
                        <i class="fi fi-rr-shopping-bag text-4xl mx-auto mb-2 text-gray-300 block"></i>
                        <span class="font-medium">Chưa có món nào trong hóa đơn.<br />Chạm vào món bên trái để thêm!</span>
                    </div>
                </div>

                <!-- Ghi chú hóa đơn tại quầy -->
                <div>
                    <input type="text" id="pos-note-input" placeholder="Ghi chú đơn tại quầy (ít đá, giảm ngọt, số bàn...)" class="w-full bg-gray-50 border border-gray-200 rounded-xl px-3.5 py-2 text-xs font-medium text-gray-800 focus:ring-2 focus:ring-red-highland" />
                </div>

                <!-- Chi tiết tính tiền tại quầy -->
                <div class="space-y-2 pt-3 border-t border-gray-200 text-sm">
                    <div class="flex justify-between text-gray-600 font-medium">
                        <span>Tạm tính</span>
                        <span id="pos-subtotal" class="font-bold text-gray-900">0 đ</span>
                    </div>
                    <div class="flex justify-between text-gray-600 font-medium">
                        <span>Giảm giá</span>
                        <span id="pos-discount" class="font-bold text-emerald-600">0 đ</span>
                    </div>
                    <div class="flex justify-between items-baseline pt-2 border-t-2 border-gray-200">
                        <span class="text-base font-black text-gray-900">Tổng thanh toán:</span>
                        <span id="pos-total" class="text-2xl sm:text-3xl font-black text-red-highland">0 đ</span>
                    </div>
                </div>

                <!-- Chọn phương thức thanh toán tại quầy: Tiền mặt (CASH) hoặc Tạo mã QR VNPay (VNPAY) -->
                <div class="space-y-3 pt-1">
                    <div class="grid grid-cols-2 gap-2.5">
                        <button type="button" id="btn-pay-cash" onclick="setPosPaymentMethod('CASH')" class="py-3 px-3.5 rounded-2xl border-2 border-red-highland bg-red-50 text-red-highland font-black text-sm flex items-center justify-center gap-2 transition shadow-sm">
                            <i class="fi fi-rr-money-bill-wave text-base flex items-center"></i>
                            <span>Tiền mặt</span>
                        </button>
                        <button type="button" id="btn-pay-vnpay" onclick="setPosPaymentMethod('VNPAY')" class="py-3 px-3.5 rounded-2xl border border-gray-300 bg-white text-gray-700 font-bold text-sm flex items-center justify-center gap-2 transition hover:bg-gray-50">
                            <i class="fi fi-rr-qrcode text-base flex items-center"></i>
                            <span>Mã QR VNPay</span>
                        </button>
                    </div>

                    <!-- Hộp tính tiền thừa cho khách khi thu tiền mặt tại quầy -->
                    <div id="cash-drawer-box" class="p-3.5 rounded-2xl bg-gray-50 border border-gray-200 space-y-2.5">
                        <div class="flex items-center justify-between text-sm">
                            <span class="font-bold text-gray-700">Khách đưa:</span>
                            <div class="relative">
                                <input type="number" id="cash-given" oninput="calculateChange()" placeholder="0" class="w-32 text-right bg-white border border-gray-300 rounded-xl px-3 py-1.5 text-sm font-black text-gray-900 focus:ring-2 focus:ring-red-highland" />
                            </div>
                        </div>
                        <div class="flex items-center gap-1.5 justify-end pt-1">
                            <button type="button" onclick="setQuickCash(50000)" class="px-2.5 py-1 rounded-lg bg-white border text-xs font-bold hover:bg-gray-100 text-gray-800 shadow-sm">50k</button>
                            <button type="button" onclick="setQuickCash(100000)" class="px-2.5 py-1 rounded-lg bg-white border text-xs font-bold hover:bg-gray-100 text-gray-800 shadow-sm">100k</button>
                            <button type="button" onclick="setQuickCash(200000)" class="px-2.5 py-1 rounded-lg bg-white border text-xs font-bold hover:bg-gray-100 text-gray-800 shadow-sm">200k</button>
                            <button type="button" onclick="setQuickCash(500000)" class="px-2.5 py-1 rounded-lg bg-white border text-xs font-bold hover:bg-gray-100 text-gray-800 shadow-sm">500k</button>
                        </div>
                        <div class="flex items-center justify-between text-sm pt-2 border-t border-gray-200">
                            <span class="font-semibold text-gray-600">Tiền thối lại:</span>
                            <span id="cash-change" class="text-lg font-black text-emerald-600">0 đ</span>
                        </div>
                    </div>
                </div>

                <!-- Nút Xóa trắng & Tạo đơn / Thanh toán -->
                <div class="grid grid-cols-12 gap-2.5 pt-2">
                    <button type="button" onclick="clearPosTicket()" class="col-span-4 py-3.5 rounded-2xl bg-gray-100 hover:bg-gray-200 text-gray-700 font-bold text-sm transition flex items-center justify-center gap-1.5">
                        <i class="fi fi-rr-trash text-sm"></i>
                        <span>Làm mới</span>
                    </button>
                    <button type="button" onclick="checkoutPosOrder()" id="btn-pos-checkout" class="col-span-8 py-3.5 rounded-2xl bg-red-highland hover:bg-red-700 text-white font-black text-sm sm:text-base uppercase tracking-wider shadow-lg transition active:scale-95 flex items-center justify-center gap-2">
                        <i class="fi fi-rr-receipt text-lg"></i>
                        <span>Tạo đơn & Thanh toán</span>
                    </button>
                </div>
            </div>
        </div>
    </div>

    <!-- ========================================================================= -->
    <!-- VIEW 2: BẢNG ĐIỀU PHỐI TOÀN BỘ ĐƠN HÀNG (Mục 23, 24, 25, 26, 27, 28, 29)  -->
    <!-- ========================================================================= -->
    <div id="view-orders" class="hidden space-y-6">
        <div class="bg-white p-6 rounded-3xl border border-gray-200 shadow-xl space-y-5">
            <!-- Tiêu đề quy trình điều phối tuần tự: Pending -> Processing -> Shipping -> Completed -->
            <div class="flex flex-col sm:flex-row items-start sm:items-center justify-between gap-4 pb-4 border-b border-gray-200">
                <div>
                    <h3 class="text-xl font-black text-gray-900">Điều phối toàn bộ đơn hàng trên hệ thống</h3>
                    <p class="text-sm text-gray-500 mt-1 flex items-center gap-1.5 flex-wrap">
                        <span>Quy trình chuẩn (Mục 26):</span>
                        <span class="font-bold text-amber-700 bg-amber-50 px-2 py-0.5 rounded-md border border-amber-200">Pending (Chờ xác nhận)</span>
                        <i class="fi fi-rr-arrow-right text-xs text-gray-400"></i>
                        <span class="font-bold text-blue-700 bg-blue-50 px-2 py-0.5 rounded-md border border-blue-200">Processing (Pha chế)</span>
                        <i class="fi fi-rr-arrow-right text-xs text-gray-400"></i>
                        <span class="font-bold text-purple-700 bg-purple-50 px-2 py-0.5 rounded-md border border-purple-200">Shipping (Giao hàng)</span>
                        <i class="fi fi-rr-arrow-right text-xs text-gray-400"></i>
                        <span class="font-bold text-emerald-700 bg-emerald-50 px-2 py-0.5 rounded-md border border-emerald-200">Completed (Hoàn thành)</span>
                    </p>
                </div>

                <div class="flex items-center gap-3">
                    <button type="button" onclick="loadPosOrdersList()" class="px-4 py-2.5 rounded-xl bg-gray-100 hover:bg-gray-200 text-gray-800 font-bold text-sm transition flex items-center gap-2 shadow-sm">
                        <i class="fi fi-rr-refresh text-sm"></i>
                        <span>Làm mới danh sách</span>
                    </button>
                </div>
            </div>

            <!-- [Mục 25 - Search & Filter Order cho Staff]: Thanh tìm kiếm & lọc trạng thái -->
            <div class="flex flex-col lg:flex-row items-stretch lg:items-center justify-between gap-4 bg-gray-50 p-4 rounded-2xl border border-gray-200">
                <!-- Tìm kiếm theo mã đơn hoặc tên khách hàng -->
                <div class="relative flex-1 max-w-md">
                    <i class="fi fi-rr-search absolute left-3.5 top-1/2 -translate-y-1/2 text-gray-400 text-sm"></i>
                    <input type="text"
                           id="staff-orders-search-input"
                           oninput="onStaffOrdersSearch(this.value)"
                           placeholder="Tìm theo mã đơn (#ORD-...) hoặc tên khách hàng..."
                           class="w-full pl-10 pr-4 py-2.5 rounded-xl bg-white border border-gray-300 text-sm font-semibold text-gray-900 focus:ring-2 focus:ring-red-highland outline-none transition" />
                </div>

                <!-- Các nút lọc theo trạng thái đơn hàng -->
                <div id="staff-orders-filter-pills" class="flex items-center gap-2 overflow-x-auto pb-1 lg:pb-0">
                    <button type="button" onclick="setStaffOrdersStatusFilter('', this)" class="staff-filter-btn active px-3.5 py-2 rounded-xl text-xs font-black bg-gray-900 text-white transition whitespace-nowrap">
                        Tất cả
                    </button>
                    <button type="button" onclick="setStaffOrdersStatusFilter('PENDING', this)" class="staff-filter-btn px-3.5 py-2 rounded-xl text-xs font-bold bg-white text-gray-700 border border-gray-200 hover:bg-gray-100 transition whitespace-nowrap">
                        Pending (Chờ xác nhận)
                    </button>
                    <button type="button" onclick="setStaffOrdersStatusFilter('PROCESSING', this)" class="staff-filter-btn px-3.5 py-2 rounded-xl text-xs font-bold bg-white text-gray-700 border border-gray-200 hover:bg-gray-100 transition whitespace-nowrap">
                        Processing (Pha chế)
                    </button>
                    <button type="button" onclick="setStaffOrdersStatusFilter('SHIPPING', this)" class="staff-filter-btn px-3.5 py-2 rounded-xl text-xs font-bold bg-white text-gray-700 border border-gray-200 hover:bg-gray-100 transition whitespace-nowrap">
                        Shipping (Đang giao)
                    </button>
                    <button type="button" onclick="setStaffOrdersStatusFilter('COMPLETED', this)" class="staff-filter-btn px-3.5 py-2 rounded-xl text-xs font-bold bg-white text-gray-700 border border-gray-200 hover:bg-gray-100 transition whitespace-nowrap">
                        Completed (Hoàn thành)
                    </button>
                    <button type="button" onclick="setStaffOrdersStatusFilter('CANCELLED', this)" class="staff-filter-btn px-3.5 py-2 rounded-xl text-xs font-bold bg-white text-gray-700 border border-gray-200 hover:bg-gray-100 transition whitespace-nowrap">
                        Cancelled (Đã hủy)
                    </button>
                </div>
            </div>

            <!-- Bảng hiển thị danh sách toàn bộ đơn hàng (Mục 23) -->
            <div class="overflow-x-auto">
                <table class="w-full text-left text-sm text-gray-700">
                    <thead class="bg-gray-100 text-gray-800 uppercase font-black text-xs tracking-wider">
                        <tr>
                            <th class="py-3.5 px-4">Mã đơn</th>
                            <th class="py-3.5 px-4">Khách hàng</th>
                            <th class="py-3.5 px-4">Món đã gọi</th>
                            <th class="py-3.5 px-4">Tổng tiền</th>
                            <th class="py-3.5 px-4">Thanh toán (Mục 28, 29)</th>
                            <th class="py-3.5 px-4">Trạng thái</th>
                            <th class="py-3.5 px-4 text-center">Điều phối & Xử lý (Mục 24, 26, 27)</th>
                        </tr>
                    </thead>
                    <tbody id="pos-orders-table-body" class="divide-y divide-gray-200 font-medium text-sm">
                    </tbody>
                </table>
            </div>
        </div>
    </div>
</div>

<!-- ========================================================================= -->
<!-- MODAL 1: XEM CHI TIẾT ĐƠN HÀNG DÀNH CHO NHÂN VIÊN (Mục 24)                -->
<!-- ========================================================================= -->
<div id="modal-order-detail" class="fixed inset-0 z-50 bg-black/60 backdrop-blur-sm hidden items-center justify-center p-4">
    <div class="bg-white rounded-3xl max-w-xl w-full max-h-[90vh] flex flex-col shadow-2xl overflow-hidden">
        <!-- Đầu Modal -->
        <div class="px-6 py-4 bg-slate-900 text-white flex items-center justify-between">
            <div class="flex items-center gap-3">
                <span class="w-10 h-10 rounded-xl bg-amber-500 text-slate-900 flex items-center justify-center font-bold text-lg">
                    <i class="fi fi-rr-receipt"></i>
                </span>
                <div>
                    <h3 class="text-base font-black flex items-center gap-2">
                        <span>Chi tiết đơn hàng</span>
                        <span id="detail-order-code" class="text-xs font-mono text-amber-300 bg-amber-500/20 px-2 py-0.5 rounded-full">#ORD-...</span>
                    </h3>
                    <p id="detail-order-time" class="text-xs text-slate-300 mt-0.5">--:-- --/--/----</p>
                </div>
            </div>
            <button type="button" onclick="closeOrderDetailModal()" class="w-8 h-8 rounded-full bg-slate-800 hover:bg-slate-700 text-slate-300 flex items-center justify-center transition">✕</button>
        </div>

        <!-- Thân Modal -->
        <div class="p-6 overflow-y-auto space-y-5 flex-1">
            <div class="flex items-center justify-between p-3.5 bg-gray-50 rounded-2xl border border-gray-200 text-xs">
                <div>
                    <span class="text-gray-500 block font-semibold">Trạng thái hiện tại</span>
                    <span id="detail-order-status" class="font-black text-sm text-gray-900">Chờ xác nhận</span>
                </div>
                <div class="text-right">
                    <span class="text-gray-500 block font-semibold">Thanh toán</span>
                    <span id="detail-order-payment" class="font-black text-sm text-gray-900">Tiền mặt</span>
