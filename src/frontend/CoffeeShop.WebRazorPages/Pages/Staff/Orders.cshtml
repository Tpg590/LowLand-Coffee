<div id="modal-staff-vnpay-qr" class="fixed inset-0 z-50 bg-black/60 backdrop-blur-sm hidden items-center justify-center p-4">
    <div class="bg-white rounded-3xl max-w-md w-full p-6 sm:p-8 shadow-2xl text-center space-y-5">
        <div class="flex items-center justify-between border-b border-gray-100 pb-3">
            <div class="flex items-center gap-2">
                <span class="px-2.5 py-1 rounded-lg bg-blue-600 text-white font-black text-xs">VNPAY-QR</span>
                <h3 class="text-lg font-black text-gray-900">Mã QR Thanh Toán Đơn Hàng</h3>
            </div>
            <button type="button" onclick="closeStaffVnPayQrModal()" class="text-gray-400 hover:text-gray-600 font-bold">✕</button>
