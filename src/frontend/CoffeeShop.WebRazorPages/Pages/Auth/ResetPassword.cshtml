@page
@model CoffeeShop.WebRazorPages.Pages.Auth.ResetPasswordModel
@{
    ViewData["Title"] = "Đặt lại mật khẩu - LowLand Coffee";
    var successToast = TempData["SuccessToast"] as string;
}

<div class="w-full min-h-[calc(100vh-160px)] flex items-center justify-center px-4 sm:px-8 py-10">
    <div class="w-full max-w-md bg-white rounded-3xl shadow-2xl border border-gray-100 overflow-hidden transform transition duration-300">
        <!-- Header Banner with Brand Red -->
        <div class="bg-gradient-to-r from-red-highland via-[#B32028] to-red-highland-dark text-white p-8 text-center relative overflow-hidden">
            <div class="absolute -top-10 -right-10 w-32 h-32 rounded-full bg-white/10 blur-xl pointer-events-none"></div>
            <div class="absolute -bottom-8 -left-8 w-28 h-28 rounded-full bg-amber-300/10 blur-lg pointer-events-none"></div>

            <a asp-page="/Index" class="inline-block group mb-3">
                <img src="~/images/logo.jpg" alt="LowLand Coffee" class="w-16 h-16 mx-auto rounded-full object-contain bg-amber-50 shadow-md border-2 border-amber-200 group-hover:scale-105 transition-transform" />
            </a>
            <h2 class="text-2xl sm:text-3xl font-black tracking-tight uppercase">Đặt lại mật khẩu</h2>
            <p class="text-sm text-amber-200 mt-1 font-medium">Nhập mã OTP và tạo mật khẩu mới</p>
        </div>

        <!-- Form Body -->
        <div class="p-6 sm:p-8 space-y-6">
            <!-- Server Error Alert -->
            @if (!ViewData.ModelState.IsValid && ViewData.ModelState[string.Empty]?.Errors.Count > 0)
            {
                <div class="p-4 rounded-2xl bg-red-50 border border-red-200 text-red-700 text-sm flex items-start gap-3">
                    <i class="fi fi-rr-cross-circle text-red-600 text-lg mt-0.5 flex-shrink-0"></i>
                    <div class="flex-1 text-xs sm:text-sm font-semibold">
                        @foreach (var error in ViewData.ModelState[string.Empty]!.Errors)
                        {
                            <p>@error.ErrorMessage</p>
                        }
                    </div>
                </div>
            }

            <form method="post" id="reset-password-form" class="space-y-4" novalidate>
                @Html.AntiForgeryToken()

                <!-- Email Input -->
                <div>
                    <label asp-for="Input.Email" class="block text-xs sm:text-sm font-bold text-gray-700 uppercase tracking-wider mb-1.5">
                        Địa chỉ Email <span class="text-red-highland">*</span>
                    </label>
                    <div class="relative">
                        <input asp-for="Input.Email" id="reset-email" autocomplete="email"
                               class="w-full bg-[#F9FAFB] border border-gray-200 rounded-xl pl-4 pr-11 py-3 text-base font-semibold text-gray-900 focus:ring-2 focus:ring-red-highland focus:bg-white placeholder-gray-400 transition outline-none"
                               placeholder="email@example.com" />
                        <span class="absolute right-3.5 top-3.5 text-gray-400 flex items-center pointer-events-none">
                            <i class="fi fi-rr-envelope text-lg"></i>
                        </span>
                    </div>
                    <span asp-validation-for="Input.Email" class="text-xs text-red-600 font-semibold mt-1 block min-h-[1.25rem] leading-tight"></span>
                </div>

                <!-- OTP Code Input -->
                <div>
                    <label asp-for="Input.OtpCode" class="block text-xs sm:text-sm font-bold text-gray-700 uppercase tracking-wider mb-1.5">
                        Mã OTP xác nhận (6 chữ số) <span class="text-red-highland">*</span>
                    </label>
                    <div class="relative">
                        <input asp-for="Input.OtpCode" id="reset-otp" maxlength="6" autocomplete="one-time-code"
                               class="w-full bg-[#F9FAFB] border border-gray-200 rounded-xl pl-4 pr-11 py-3 text-base font-black tracking-widest text-gray-900 focus:ring-2 focus:ring-red-highland focus:bg-white placeholder-gray-400 transition outline-none"
                               placeholder="123456" />
                        <span class="absolute right-3.5 top-3.5 text-gray-400 flex items-center pointer-events-none">
                            <i class="fi fi-rr-key text-lg"></i>
                        </span>
                    </div>
                    <span asp-validation-for="Input.OtpCode" class="text-xs text-red-600 font-semibold mt-1 block min-h-[1.25rem] leading-tight"></span>
                </div>

                <!-- New Password Input -->
                <div>
                    <label asp-for="Input.NewPassword" class="block text-xs sm:text-sm font-bold text-gray-700 uppercase tracking-wider mb-1.5">
                        Mật khẩu mới <span class="text-red-highland">*</span>
                    </label>
                    <div class="relative">
                        <input asp-for="Input.NewPassword" id="reset-new-password" type="password" autocomplete="new-password"
                               class="w-full bg-[#F9FAFB] border border-gray-200 rounded-xl pl-4 pr-11 py-3 text-base font-semibold text-gray-900 focus:ring-2 focus:ring-red-highland focus:bg-white placeholder-gray-400 transition outline-none"
                               placeholder="Tối thiểu 6 ký tự" />
                        <button type="button" onclick="togglePasswordVisibility('reset-new-password', 'toggle-eye-new')"
                                class="absolute right-3.5 top-3 text-gray-400 hover:text-gray-700 flex items-center focus:outline-none" title="Hiện/Ẩn mật khẩu">
                            <i id="toggle-eye-new" class="fi fi-rr-eye text-lg"></i>
                        </button>
                    </div>
                    <span asp-validation-for="Input.NewPassword" class="text-xs text-red-600 font-semibold mt-1 block min-h-[1.25rem] leading-tight"></span>
                </div>

                <!-- Confirm Password Input -->
                <div>
                    <label asp-for="Input.ConfirmPassword" class="block text-xs sm:text-sm font-bold text-gray-700 uppercase tracking-wider mb-1.5">
                        Xác nhận mật khẩu mới <span class="text-red-highland">*</span>
                    </label>
                    <div class="relative">
                        <input asp-for="Input.ConfirmPassword" id="reset-confirm-password" type="password" autocomplete="new-password"
                               class="w-full bg-[#F9FAFB] border border-gray-200 rounded-xl pl-4 pr-11 py-3 text-base font-semibold text-gray-900 focus:ring-2 focus:ring-red-highland focus:bg-white placeholder-gray-400 transition outline-none"
                               placeholder="Nhập lại mật khẩu mới" />
                        <button type="button" onclick="togglePasswordVisibility('reset-confirm-password', 'toggle-eye-confirm')"
                                class="absolute right-3.5 top-3 text-gray-400 hover:text-gray-700 flex items-center focus:outline-none" title="Hiện/Ẩn mật khẩu">
                            <i id="toggle-eye-confirm" class="fi fi-rr-eye text-lg"></i>
                        </button>
                    </div>
                    <span asp-validation-for="Input.ConfirmPassword" class="text-xs text-red-600 font-semibold mt-1 block min-h-[1.25rem] leading-tight"></span>
                </div>

                <!-- Submit Button (Khóa nút đến khi hợp lệ) -->
                <button type="submit" id="btn-reset-submit" disabled
                        class="w-full py-4 mt-2 rounded-xl bg-red-highland text-white font-black text-base uppercase tracking-wider shadow-lg transition-all transform active:scale-[0.98] flex items-center justify-center gap-2 disabled:opacity-50 disabled:cursor-not-allowed disabled:pointer-events-none hover:bg-red-700 hover:shadow-red-900/20">
                    <i class="fi fi-rr-lock text-lg"></i>
                    <span>Cập nhật mật khẩu mới</span>
                </button>
            </form>

            <div class="text-center text-sm text-gray-600 pt-4 border-t border-gray-100 font-medium flex items-center justify-center gap-2">
                <i class="fi fi-rr-arrow-left text-xs"></i>
                <a asp-page="/Auth/Login" class="font-bold text-red-highland hover:underline">Quay lại trang Đăng nhập</a>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
    <script>
        function togglePasswordVisibility(fieldId, iconId) {
            const input = document.getElementById(fieldId);
            const icon = document.getElementById(iconId);
            if (!input) return;

            if (input.type === 'password') {
                input.type = 'text';
                if (icon) {
                    icon.classList.remove('fi-rr-eye');
                    icon.classList.add('fi-rr-eye-crossed');
                }
            } else {
                input.type = 'password';
                if (icon) {
                    icon.classList.remove('fi-rr-eye-crossed');
                    icon.classList.add('fi-rr-eye');
                }
            }
        }

        $(function () {
            @if (!string.IsNullOrEmpty(successToast))
            {
                <text>
                    if (typeof showToast === 'function') {
                        showToast('Thành công', @Html.Raw(System.Text.Json.JsonSerializer.Serialize(successToast)), 'success');
                    }
                </text>
            }

            const $form = $('#reset-password-form');
            const $btnSubmit = $('#btn-reset-submit');
            const validator = $form.data('validator');

            function setFieldVisual(element, state) {
                const $el = $(element);
                $el.removeClass('border-gray-200 border-emerald-500 border-red-500 focus:ring-emerald-500 focus:ring-red-500 focus:ring-red-highland');
                if (state === 'valid') {
                    $el.addClass('border-emerald-500 focus:ring-emerald-500');
                } else if (state === 'invalid') {
                    $el.addClass('border-red-500 focus:ring-red-500');
                } else {
                    $el.addClass('border-gray-200 focus:ring-red-highland');
                }
            }

            function updateSubmitButtonState() {
                if (validator) {
                    const isValid = $form.valid();
                    const emailVal = $('#reset-email').val().trim();
                    const otpVal = $('#reset-otp').val().trim();
                    const newPass = $('#reset-new-password').val().trim();
                    const confirmPass = $('#reset-confirm-password').val().trim();

                    if (isValid && emailVal && otpVal.length === 6 && newPass.length >= 6 && newPass === confirmPass) {
                        $btnSubmit.prop('disabled', false);
                    } else {
                        $btnSubmit.prop('disabled', true);
                    }
                }
            }

            if (validator) {
                validator.settings.highlight = function (element) {
                    setFieldVisual(element, 'invalid');
                    updateSubmitButtonState();
                };
                validator.settings.unhighlight = function (element) {
                    const val = $(element).val() ? $(element).val().trim() : '';
                    if (val !== '') {
                        setFieldVisual(element, 'valid');
                    } else {
                        setFieldVisual(element, 'neutral');
                    }
                    updateSubmitButtonState();
                };
            }

            const debounceTimers = {};
            $form.find('input').on('input', function () {
                const input = this;
                const fieldName = input.name;
                const val = $(input).val() ? $(input).val().trim() : '';
                clearTimeout(debounceTimers[fieldName]);

                if (val === '') {
                    if (validator) {
                        $form.find(`[data-valmsg-for="${fieldName}"]`)
                            .empty()
                            .removeClass('field-validation-error')
                            .addClass('field-validation-valid');
                    }
                    setFieldVisual(input, 'neutral');
                    updateSubmitButtonState();
                    return;
                }

                // Debounce 500ms
                debounceTimers[fieldName] = setTimeout(() => {
                    if (validator) {
                        const isValid = validator.element(input);
                        setFieldVisual(input, isValid ? 'valid' : 'invalid');
                        updateSubmitButtonState();
                    }
                }, 500);
            });

            @if (!ViewData.ModelState.IsValid && ViewData.ModelState[string.Empty]?.Errors.Count > 0)
            {
                var errMsg = ViewData.ModelState[string.Empty]!.Errors[0].ErrorMessage;
                <text>
                    if (typeof showToast === 'function') {
                        showToast('Lỗi đặt lại mật khẩu', @Html.Raw(System.Text.Json.JsonSerializer.Serialize(errMsg)), 'error');
                    }
                </text>
            }
        });
    </script>
}

