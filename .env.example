# =============================================================================
# LowLand Coffee - Docker Environment Configuration
# =============================================================================
# Copy file này thành .env để tùy chỉnh môi trường:
# cp .env.example .env

# -----------------------------------------------------------------------------
# 1. SQL Server Configuration
# -----------------------------------------------------------------------------
DB_SERVER=sqlserver
DB_PORT=1433
DB_USER=sa
DB_PASSWORD=YourPassword123!
MSSQL_PID=Developer

# -----------------------------------------------------------------------------
# 2. Host Port Mapping (Chỉ mở 2 cổng công khai duy nhất)
# -----------------------------------------------------------------------------
WEB_HOST_PORT=5000
GATEWAY_HOST_PORT=8080

# -----------------------------------------------------------------------------
# 3. ASP.NET Core Global Environment
# -----------------------------------------------------------------------------
ASPNETCORE_ENVIRONMENT=Development

# -----------------------------------------------------------------------------
# 4. JWT Authentication Settings
# -----------------------------------------------------------------------------
JWT_SECRET_KEY=LowLandCoffee_Super_Secret_Key_For_PRN232_Assignment_2026_Key
JWT_ISSUER=LowLandCoffee.Auth
JWT_AUDIENCE=LowLandCoffee.Clients
JWT_EXPIRY_HOURS=24

# -----------------------------------------------------------------------------
# 5. VNPay Payment Gateway Settings
# -----------------------------------------------------------------------------
VNPAY_TMN_CODE=your_vnpay_tmn_code_here
VNPAY_HASH_SECRET=your_vnpay_hash_secret_here
VNPAY_BASE_URL=https://sandbox.vnpayment.vn/paymentv2/vpcpay.html
VNPAY_RETURN_URL=http://localhost:5000/api/payments/vnpay-return

# -----------------------------------------------------------------------------
# 6. Cloudinary Configuration
# -----------------------------------------------------------------------------
CLOUDINARY_CLOUD_NAME=your_cloudinary_cloud_name
CLOUDINARY_API_KEY=your_cloudinary_api_key
CLOUDINARY_API_SECRET=your_cloudinary_api_secret

